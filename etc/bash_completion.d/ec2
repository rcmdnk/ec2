# Resolve the list once when the completion file is sourced. Completion itself
# must not start ec2 for every Tab press, but the list should follow the command
# implementation when new top-level subcommands are added.
_ec2_commands=''
if command -v ec2 >/dev/null 2>&1; then
  _ec2_commands="$(ec2 commands 2>/dev/null)"
fi

_ec2 () {
  if [ "$ZSH_VERSION" != "" ];then
    compadd ${(s: :)_ec2_commands}
  else
    COMPREPLY=($(compgen -W "$_ec2_commands" -- "${COMP_WORDS[COMP_CWORD]}"))
  fi
}

if [ "$ZSH_VERSION" != "" ];then
  compdef _ec2 ec2
else
  complete -o default -F _ec2 ec2
fi
