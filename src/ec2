delete_job () {
  # Delete jobs.
  # Use `delete_job <PID>...` or
  # `delete_job -f <job name>`. Without them
  # jobs are selected interactively.
  # A PID or name which matches no job, or a
  # name which matches several jobs without a
  # terminal, is an error and deletes nothing.
  # Use `--dry-run 1` to see the target only.
  local explicit=0
  if [ "${#__positional[@]}" -gt 0 ] || [ "$__name_filter_from_cli" = 1 ];then
    explicit=1
  fi
  if [ "${#__positional[@]}" -gt 0 ] && [ "$__name_filter_from_cli" = 1 ];then
    echo "Use either PIDs or -f <job name> for delete_job, not both." >&2
    exit 1
  fi

  local job_list=""
  if [ -f "$__job_list" ];then
    job_list=$(awk 'NF' "$__job_list")
  fi
  if [ -z "$job_list" ] && [ "$explicit" = 0 ];then
    echo "No job"
    exit 0
  fi

  local job jobs="" pid failed=0
  if [ "${#__positional[@]}" -gt 0 ];then
    for pid in "${__positional[@]}";do
      if [[ ! "$pid" =~ ^[0-9]+$ ]];then
        echo "Invalid job PID: $pid (nothing was deleted)" >&2
        exit 1
      fi
    done
    for pid in "${__positional[@]}";do
      job=$(awk -v pid="$pid" '$1 == pid' <<< "$job_list")
      if [ -z "$job" ];then
        echo "No job for PID: $pid" >&2
        failed=1
        continue
      fi
      jobs="${jobs:+$jobs"$'\n'"}$job"
    done
  elif [ "$__name_filter_from_cli" = 1 ];then
    if [ -z "$__name_filter" ];then
      echo "The job name for -f is empty (nothing was deleted)." >&2
      exit 1
    fi
    # An exact name wins; otherwise fall back to names containing the value.
    jobs=$(awk -v name="$__name_filter" '$4 == name' <<< "$job_list")
    if [ -z "$jobs" ];then
      jobs=$(awk -v name="$__name_filter" 'index($4, name)' <<< "$job_list")
    fi
    if [ -z "$jobs" ];then
      echo "No job matches the name: $__name_filter (nothing was deleted)" >&2
      exit 1
    fi
    if [ "$(printf '%s\n' "$jobs" | wc -l | xargs)" != 1 ];then
      if ! _has_tty;then
        echo "The name '$__name_filter' matches several jobs (nothing was deleted):" >&2
        printf '%s\n' "$jobs" >&2
        echo "Use a more specific name or the PIDs." >&2
        exit 1
      fi
      _select "$jobs"
      jobs=$__selected
    fi
  else
    _select "$job_list"
    jobs=$(_tac "$__selected")
  fi

  # Whatever produced the targets, only act on rows which really are jobs.
  local line
  while IFS= read -r line;do
    [ -n "$line" ] || continue
    if ! grep -Fxq -- "$line" <<< "$job_list";then
      echo "Unexpected selection, not a job (nothing was deleted): $line" >&2
      exit 1
    fi
  done <<< "$jobs"
  if [ -z "$jobs" ];then
    if [ "$explicit" = 0 ];then
      echo "No job was selected" >&2
    fi
    exit 1
  fi

  local date time script instance_id instance_ip status
  while read -r pid date time script instance_id instance_ip status; do
    [ -n "$pid" ] || continue
    if [ "$__dry_run" = "1" ];then
      echo "Dry run: Deleting job: $pid $date $time $script $instance_id $instance_ip $status"
      continue
    fi
    echo "Deleting job: $pid $date $time $script $instance_id $instance_ip $status"
    _job_update "$pid" "$date" "$time" "${instance_id:--}" "${instance_ip:--}" deleting
    if ps -p "$pid" -o command= 2>/dev/null | grep -Eq '(^|[/ ])ec2 (.* )?submit( |$)'; then
      kill -TERM "$pid" 2>/dev/null || true
      for ((attempt=1; attempt<=10; attempt++)); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 1
      done
      kill -KILL "$pid" 2>/dev/null || true
    else
      echo "Skipping PID $pid: process identity is not an ec2 submit process." >&2
    fi
    if [[ "$instance_id" =~ ^i-[0-9a-f]+$ ]];then
      __ids[__enum_instance]="$instance_id"
      if ! __exit_at_fail=0 terminate && ! grep -q "InvalidInstanceID" <<< "$__execute_result";then
        echo "Failed to terminate $instance_id: $__execute_result" >&2
        echo "The job is kept in the list; run '$__cmd delete_job $pid' again." >&2
        _job_update "$pid" "$date" "$time" "$instance_id" "${instance_ip:--}" delete_failed
        failed=1
        continue
      fi
    elif [ -n "$instance_id" ] && [ "$instance_id" != "-" ];then
      echo "Skipping instance termination: '$instance_id' is not an instance ID." >&2
    fi
    _job_delete "$pid" "$date" "$time"
  done <<< "$jobs"
  return "$failed"
}

images () {
