  mkdir -p "$(dirname "$root/packer/scripts/install_packages.sh")"
  cat >"$root/packer/scripts/install_packages.sh" <<'__EC2_ASSET_packer_scripts_install_packages_sh__'
#!/usr/bin/env bash
set -euo pipefail

# AMI_PACKAGES, AMI_EXTRA_PACKAGES, AMI_UPDATE_PACKAGES, and AMI_PACKAGE_MANAGER come from the Packer template's
# environment_vars, so an unset one means the template is out of sync.
# shellcheck disable=SC2153
read -r -a packages <<<"${AMI_PACKAGES} ${AMI_EXTRA_PACKAGES}"

remove_package() {
  local package=$1 remaining=()
  for candidate in "${packages[@]}"; do
    [[ "$candidate" != "$package" ]] && remaining+=("$candidate")
  done
  packages=("${remaining[@]}")
}

record_package_manifest() {
  if [[ "$package_manager" == apt ]]; then
    dpkg-query -W -f='${Package}\t${Version}\t${Architecture}\n' | sort \
      > /var/log/ec2-environment-packages.tsv
  else
    rpm -qa --qf '%{NAME}\t%{EPOCHNUM}:%{VERSION}-%{RELEASE}\t%{ARCH}\n' | sort \
      > /var/log/ec2-environment-packages.tsv
  fi
}

package_manager=${AMI_PACKAGE_MANAGER:-auto}
if [[ "$package_manager" == auto ]]; then
  if command -v dnf >/dev/null 2>&1; then
    package_manager=dnf
  elif command -v yum >/dev/null 2>&1; then
    package_manager=yum
  elif command -v apt-get >/dev/null 2>&1; then
    package_manager=apt
  fi
fi

if [[ -z "${packages[*]}" && -z "${AMI_FLATPAK_PACKAGES:-}" ]];then
  record_package_manifest
  exit 0
fi

if [[ "$package_manager" == dnf ]]; then
  # shellcheck disable=SC2153  # Supplied by the Packer environment_vars list.
  [[ "$AMI_UPDATE_PACKAGES" == 1 ]] && dnf update -y
  dnf install -y 'dnf-command(config-manager)'

  install_spal=0
  if printf '%s\n' "${packages[@]}" | grep -qx spal; then
    remove_package spal
    install_spal=1
  fi
  if printf '%s\n' "${packages[@]}" | grep -qx spal-release; then
    remove_package spal-release
    install_spal=1
  fi
  if [[ "${install_spal}" == "1" ]]; then
    dnf install -y spal-release
  fi
  if printf '%s\n' "${packages[@]}" | grep -qx gh; then
    dnf install -y dnf5-plugins 2>/dev/null || dnf install -y dnf-plugins-core
    if dnf --version | head -n 1 | grep -q '^5\.'; then
      dnf config-manager addrepo --from-repofile=https://cli.github.com/packages/rpm/gh-cli.repo
    else
      dnf config-manager --add-repo https://cli.github.com/packages/rpm/gh-cli.repo
    fi
  fi
  if printf '%s\n' "${packages[@]}" | grep -qx lazygit; then
    dnf install -y dnf-plugins-core
    dnf copr enable -y dejan/lazygit amazonlinux-2023-x86_64
  fi
  if printf '%s\n' "${packages[@]}" | grep -qx terraform; then
    dnf install -y dnf5-plugins 2>/dev/null || dnf install -y dnf-plugins-core
    if dnf --version | head -n 1 | grep -q '^5\.'; then
      dnf config-manager addrepo --from-repofile=https://rpm.releases.hashicorp.com/AmazonLinux/hashicorp.repo
    else
      dnf config-manager --add-repo https://rpm.releases.hashicorp.com/AmazonLinux/hashicorp.repo
    fi
  fi
  if printf '%s\n' "${packages[@]}" | grep -qx google-chrome; then
    curl -fL -o /tmp/google-chrome.rpm https://dl.google.com/linux/direct/google-chrome-stable_current_x86_64.rpm
    dnf install -y /tmp/google-chrome.rpm
    rm -f /tmp/google-chrome.rpm
    remove_package google-chrome
  fi
  if [[ "${#packages[@]}" -gt 0 ]]; then
    dnf install -y "${packages[@]}"
  fi

  if [ "${AMI_FLATPAK_PACKAGES:-}" ]; then
    dnf install -y flatpak
    flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
    # shellcheck disable=SC2086
    flatpak install -y flathub $AMI_FLATPAK_PACKAGES
  fi

elif [[ "$package_manager" == yum ]]; then
  # Plain install only. None of the special cases above apply here: the extra
  # repositories (gh, terraform, lazygit), the versioned kernel packages, the
  # google-chrome rpm and AMI_FLATPAK_PACKAGES are all dnf-only. Listing any of them
  # in AMI_PACKAGES on a yum image either fails or silently installs nothing.
  # shellcheck disable=SC2153  # Supplied by the Packer environment_vars list.
  [[ "$AMI_UPDATE_PACKAGES" == 1 ]] && yum update -y
  yum install -y "${packages[@]}"
elif [[ "$package_manager" == apt ]]; then
  if printf '%s\n' "${packages[@]}" | grep -Eq '^(spal|spal-release|lazygit|terraform|google-chrome)$'; then
    echo 'Special package names spal, lazygit, terraform, and google-chrome require a dnf/yum image.' >&2
    exit 1
  fi
  [[ "$AMI_UPDATE_PACKAGES" == 1 ]] && apt-get update
  [[ "${#packages[@]}" -gt 0 ]] && DEBIAN_FRONTEND=noninteractive apt-get install -y "${packages[@]}"
  if [[ -n "${AMI_FLATPAK_PACKAGES:-}" ]]; then
    DEBIAN_FRONTEND=noninteractive apt-get install -y flatpak
    flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
    # shellcheck disable=SC2086
    flatpak install -y flathub $AMI_FLATPAK_PACKAGES
  fi
else
  echo "Unsupported package manager '$AMI_PACKAGE_MANAGER'; use auto, dnf, yum, or apt." >&2
  exit 1
fi

record_package_manifest
__EC2_ASSET_packer_scripts_install_packages_sh__
  chmod 755 "$root/packer/scripts/install_packages.sh"
  mkdir -p "$(dirname "$root/packer/scripts/setup_swap.sh")"
  cat >"$root/packer/scripts/setup_swap.sh" <<'__EC2_ASSET_packer_scripts_setup_swap_sh__'
#!/usr/bin/env bash
set -euo pipefail
if [[ -n "${AMI_SWAP_BLOCK_SIZE:-}" ]] && [[ -n "${AMI_SWAP_BLOCK_COUNT:-}" ]] && [[ ! -f /swapfile ]]; then
  dd if=/dev/zero of=/swapfile bs="$AMI_SWAP_BLOCK_SIZE" count="$AMI_SWAP_BLOCK_COUNT"
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile swap swap defaults 0 0' >> /etc/fstab
fi
__EC2_ASSET_packer_scripts_setup_swap_sh__
  chmod 755 "$root/packer/scripts/setup_swap.sh"
  mkdir -p "$(dirname "$root/packer/scripts/set_timezone.sh")"
  cat >"$root/packer/scripts/set_timezone.sh" <<'__EC2_ASSET_packer_scripts_set_timezone_sh__'
#!/usr/bin/env bash
set -euo pipefail
[[ -n "${AMI_TIMEZONE:-}" ]] && timedatectl set-timezone "$AMI_TIMEZONE"
__EC2_ASSET_packer_scripts_set_timezone_sh__
  chmod 755 "$root/packer/scripts/set_timezone.sh"
  mkdir -p "$(dirname "$root/packer/scripts/setup_idle_shutdown.sh")"
  cat >"$root/packer/scripts/setup_idle_shutdown.sh" <<'__EC2_ASSET_packer_scripts_setup_idle_shutdown_sh__'
#!/usr/bin/env bash
set -euo pipefail
[[ -z "${AMI_IDLE_SHUTDOWN_BACKEND:-}" ]] && exit 0
cat > /usr/local/sbin/shutdown_if_idle <<EOF
#!/usr/bin/env bash
set -eu

has_login_user() {
  who | grep -q .
}

has_keepalive_process() {
  if [[ -z "${AMI_IDLE_SHUTDOWN_KEEPALIVE_PROCESSES:-}" ]]; then
    return 1
  fi
  ps -eo uid=,comm= |
      awk '\$1 != 0 && \$2 ~ /^(${AMI_IDLE_SHUTDOWN_KEEPALIVE_PROCESSES:-sshd})\$/ { found = 1 } END { exit !found }'
}

is_idle() {
  ! has_login_user && ! has_keepalive_process
}

# First check
if ! is_idle; then
  exit 0
fi

# Wait briefly and check again to avoid shutting down during a transient idle state
sleep 60

# Second check
if is_idle; then
  logger -t shutdown-if-idle "No login users, SSH sessions, screen, or tmux sessions found. Powering off."
  /usr/bin/systemctl poweroff
fi
EOF
chmod 755 /usr/local/sbin/shutdown_if_idle
if [[ "$AMI_IDLE_SHUTDOWN_BACKEND" == systemd ]]; then
  cat > /etc/systemd/system/shutdown.service <<EOF
[Unit]
Description=Power off idle instance

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/shutdown_if_idle
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
EOF
  cat > /etc/systemd/system/shutdown.timer <<EOF
[Unit]
Description=Check for idle instance

[Timer]
OnCalendar=${AMI_IDLE_SHUTDOWN_SCHEDULE:-hourly}

[Install]
WantedBy=timers.target
EOF
  systemctl daemon-reload
  systemctl enable --now shutdown.timer
  systemctl start shutdown.timer
elif [[ "$AMI_IDLE_SHUTDOWN_BACKEND" == cron ]]; then
  cron_duration=${AMI_IDLE_SHUTDOWN_SCHEDULE:-hourly}
  cat << EOF > "/etc/cron.$cron_duration/shutdown"
#!/usr/bin/env bash
/usr/local/sbin/shutdown_if_idle
EOF
  chmod 755 "/etc/cron.$cron_duration/shutdown"
fi
__EC2_ASSET_packer_scripts_setup_idle_shutdown_sh__
  chmod 755 "$root/packer/scripts/setup_idle_shutdown.sh"
}

# shellcheck shell=bash
# shellcheck disable=SC2154

_environment_runtime() {
  local script=$1
  shift
  (
    set -e
    local runtime
    runtime=$(mktemp -d "${TMPDIR:-/tmp}/ec2-environment.XXXXXX")
    trap 'command rm -rf "$runtime"' EXIT
    _environment_extract "$runtime"
    "$runtime/scripts/$script" "$@"
  )
}

_environment_require_config() {
  local config=$1
  [ -f "$config" ] && return 0

  echo "Environment configuration file not found: $config" >&2
  echo "Create it, then edit the settings before running the command again:" >&2
  if [ "$config" = "$__config_dir/environment" ];then
    echo "  ec2 init_environment" >&2
  else
    echo "  ec2 init_environment --environment-config $config" >&2
  fi
  echo "  ${EDITOR:-vi} $config" >&2
  return 1
}

_environment_args() {
  __environment_command_workdir="${__positional[0]:-$__workdir}"
  __environment_command_config="${__positional[1]:-$__environment_config}"
  _environment_require_config "$__environment_command_config"
}

_environment_config_is_managed() {
  [ -f "$1" ] && grep -q '^# Generated by ec2 setup\.$' "$1"
}

_environment_preflight_config() {
  [ "$__install_config" = "1" ] || return 0

  if [ -L "$__default_config" ];then
    if [ "$__replace_config" != "1" ];then
      echo "Refusing to replace symbolic link: $__default_config" >&2
      echo "Use --replace-config 1 to back it up and install the generated config." >&2
      return 1
    fi
  elif [ -e "$__default_config" ] && ! _environment_config_is_managed "$__default_config" && [ "$__replace_config" != "1" ];then
    echo "Refusing to replace unmanaged configuration: $__default_config" >&2
    echo "Use --replace-config 1 to back it up and install the generated config." >&2
    return 1
  fi
}

_environment_install_config() {
  local generated=$1
  [ "$__install_config" = "1" ] || {
    echo "Generated $generated (not installed because --install-config is not 1)."
    return 0
  }
  [ -s "$generated" ] || {
    echo "Generated configuration is missing or empty: $generated" >&2
    return 1
  }
  _environment_config_is_managed "$generated" || {
    echo "Generated configuration has no ec2 setup management marker: $generated" >&2
    return 1
  }

  mkdir -p "$__config_dir"
  chmod 700 "$__config_dir"

  if [ -f "$__default_config" ] && [ ! -L "$__default_config" ] && cmp -s "$generated" "$__default_config";then
    echo "Configuration is already current: $__default_config"
    return 0
  fi

  if [ -e "$__default_config" ] || [ -L "$__default_config" ];then
    if ! _environment_config_is_managed "$__default_config";then
      local backup
      backup="${__default_config}.backup-$(date +%Y%m%d-%H%M%S)"
      [ ! -e "$backup" ] && [ ! -L "$backup" ] || backup="${backup}.$$"
      mv "$__default_config" "$backup"
      echo "Backed up existing configuration to $backup"
    fi
  fi

  local temporary="${__default_config}.tmp.$$"
  command rm -f "$temporary"
  if ! cp "$generated" "$temporary";then
    command rm -f "$temporary"
    return 1
  fi
  if ! chmod 600 "$temporary" || ! mv -f "$temporary" "$__default_config";then
    command rm -f "$temporary"
    return 1
  fi
  echo "Installed ec2 configuration: $__default_config"
}

_environment_cleanup_args() {
  __environment_cleanup_args=(--workdir "$__environment_command_workdir" --config "$__environment_command_config")
  [ -z "$__manifest" ] || __environment_cleanup_args+=(--manifest "$__manifest")
  [ "$__execute" != "1" ] || __environment_cleanup_args+=(--execute)
}

make_ami() {
  # Build the configured EC2 AMIs with Packer.
  _environment_args || return
  [ "$__setup_after_ami" = "1" ] || {
    if _environment_runtime make_ami.sh "$__environment_command_workdir" "$__environment_command_config"; then
      return 0
    fi
    echo 'AMI build failed; setup was not run.' >&2
    return 1
  }
  _environment_preflight_config || return 1
  if ! _environment_runtime make_ami.sh "$__environment_command_workdir" "$__environment_command_config"; then
    echo 'AMI build failed; setup was not run.' >&2
    return 1
  fi
  echo 'AMI build completed; running ec2 setup.'
  if setup; then
    return 0
  fi
  echo 'AMI builds completed, but setup failed.' >&2
  printf 'Re-run setup with: ec2 setup --workdir %q --environment-config %q\n' \
    "$__environment_command_workdir" "$__environment_command_config" >&2
  return 1
}

setup() {
  # Generate EC2 launch inputs and install the default ec2 configuration.
  _environment_args || return
  if [[ -n "$__ami_family" || -n "$__ami_id" ]]; then
    [[ -n "$__ami_family" && -n "$__ami_id" ]] || {
      echo '--ami-family and --ami-id must be used together with setup.' >&2
      return 1
    }
  fi
  _environment_preflight_config || return 1
  _environment_runtime setup_ec2.sh "$__environment_command_workdir" "$__environment_command_config" \
    "${__ami_family:-}" "${__ami_id:-}" || return
  _environment_install_config "$__environment_command_workdir/ec2/config"
}

setup_efs() {
  # Resolve or create configured EFS file systems.
  _environment_args || return
  _environment_runtime setup_efs.sh "$__environment_command_workdir" "$__environment_command_config"
}

setup_fsx() {
  # Resolve or create configured FSx file systems.
  _environment_args || return
  _environment_runtime setup_fsx.sh "$__environment_command_workdir" "$__environment_command_config"
}

setup_io2() {
  # Resolve or create configured io2 volumes.
  _environment_args || return
  _environment_runtime setup_io2.sh "$__environment_command_workdir" "$__environment_command_config"
}

setup_s3files() {
  # Resolve configured S3 file-system identifiers.
  _environment_args || return
  _environment_runtime setup_s3files.sh "$__environment_command_workdir" "$__environment_command_config"
}

cleanup_resources() {
  # Show or execute cleanup for resources recorded by environment commands.
  _environment_args || return
  _environment_cleanup_args
  _environment_runtime cleanup_resources.sh "${__environment_cleanup_args[@]}"
}

init_environment() {
  # Install an example environment configuration without overwriting one.
  if [ -e "$__environment_config" ] || [ -L "$__environment_config" ];then
    echo "Environment configuration already exists: $__environment_config" >&2
    return 1
  fi
  (
    set -e
    local runtime temporary
    runtime=$(mktemp -d "${TMPDIR:-/tmp}/ec2-environment.XXXXXX")
    trap 'command rm -rf "$runtime"' EXIT
    _environment_extract "$runtime"
    mkdir -p "$(dirname "$__environment_config")"
    temporary="${__environment_config}.tmp.$$"
    cp "$runtime/environment.example" "$temporary"
    chmod 600 "$temporary"
    mv "$temporary" "$__environment_config"
  )
  echo "Installed environment configuration: $__environment_config"
}
# END GENERATED ENVIRONMENT COMMANDS

# Main

__subcommands=$(set | grep -v "^_" | grep -v "^ " | grep " () $" | cut -d' ' -f1 | tr '\n' ' ')

if [ $# -eq 0 ];then
  _print_help
  exit
fi

_read_config_path "$@"
_read_config
eval "$(_generate_read_args)"
_read_args "$@"

__subcommand="${__positional[0]}"
__positional=("${__positional[@]:1:$((${#__positional[@]}))}")

if [ -z "$__subcommand" ];then
  _print_help
  exit 1
fi

if ! echo " $__subcommands "|grep -q " $__subcommand ";then
  echo "$__subcommand is unknown subcommand."
  echo ""
  _print_help
  exit 1
fi

case "$__subcommand" in
  cleanup_resources|commands|help|init_environment|make_ami|setup|setup_efs|setup_fsx|setup_io2|setup_s3files|version) ;;
  *) _require_config || exit 1;;
esac

if [ "$__all" = "1" ];then
  __name_filter=""
  __image_name_filter=""
fi

if [ "$__dry_run" = "1" ];then
  __dry_run_mode="--dry-run"
fi

__ids[__enum_instance]="$__instance_id"
__ids[__enum_image]="$__image_id"
__ids[__enum_template]="$__template_id"

if [ "$__subcommand" = "ssh" ] || [ "$__subcommand" = "mosh" ] || [ "$__subcommand" = "et" ];then
  __execute_command="${__positional[0]}"
fi

if [ "$__subcommand" = "scp" ] || [ "$__subcommand" = "rsync" ];then
  __transfer_operands=("${__positional[@]}")
fi

if [ "$__subcommand" = "submit" ] && [ "$__submit_command" != "1" ];then
  __file="${__positional[0]}"
  if [ -z "$__file" ];then
    echo "Usage: $__cmd [options] submit <file>"
    exit 1
  fi
  if [ ! -f "$__file" ];then
    echo "$__file does not exist"
    exit 1
  fi
fi

$__subcommand
