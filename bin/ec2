#  family with a <FAMILY>_ prefix.

# Comma-separated family names. CPU and GPU are the built-in examples; additional
# families require matching <FAMILY>_ settings below or in a custom environment.
# Default: CPU,GPU
#AMI_FAMILIES="CPU,GPU"

# --- CPU family --------------------------------------------------------------

# 1 builds this AMI and generates its launch JSONs; 0 skips the family entirely.
# Default: 1
#CPU_ENABLED=1

# Optional exact AMI ID to use without running Packer. When set, `ec2 setup`
# uses this AMI directly and writes the normal launch JSONs and client config.
# This is useful for an AMI created by `ec2 new_image`, a shared AMI, or an
# image managed outside this repository.
#CPU_AMI_ID="ami-0123456789abcdef0"

# Optional AMI name and owner for name-based lookup. CPU_AMI_NAME takes
# precedence over CPU_OUTPUT_AMI_NAME; CPU_AMI_OWNER defaults to self.
#CPU_AMI_NAME="my-existing-cpu-image"
#CPU_AMI_OWNER="self"

# Required while CPU_ENABLED is 1 unless CPU_AMI_ID is set.
