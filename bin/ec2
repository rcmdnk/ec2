#!/usr/bin/env bash
# shellcheck disable=SC2154,SC2155

__version="v0.3.0"
__date="11/Sep/2026"
__config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/ec2"
__default_config="$__config_dir/config"
__config="$__default_config"
__environment_config="${EC2_ENVIRONMENT_CONFIG:-$__config_dir/environment}"
__workdir="${EC2_ENVIRONMENT_WORKDIR:-$__config_dir/work}"
__install_config=1
__replace_config=0
__manifest=""
__execute=0
__job_list="${__config_dir}/job_list"
__type_list_file="$__config_dir/type_list"
__submit_sedi_lock="${__config_dir}/submit_sedi.lock"
__submit_sedi_lock_fd="200"
__submit_launch_lock="${__config_dir}/submit_launch.lock"
__submit_launch_lock_fd="201"
__exit_at_fail=1
__type_list_file_term=7
__instance_filter="--filters Name=instance-state-name,Values=pending,running,stopping,stopped"
__n_cli_input_json=0
__obj_name=(instance image template type)
__get_list_func=(_get_instance_list _get_image_list _get_template_list _get_type_list)
__enum_instance=0
__enum_image=1
__enum_template=2
__enum_type=3
__list=()
__ids=()

__cmd=$(basename "$0")

__opt_spot="--instance-market-options '{ \"MarketType\": \"spot\", \"SpotOptions\": {\"SpotInstanceType\": \"persistent\", \"InstanceInterruptionBehavior\" : \"stop\"} }'"

__selection_tool="sentaku,peco,fzy,fzf"
__selection_tool_ref="  - [sentaku](https://github.com/rcmdnk/sentaku/)\n  - [peco](https://github.com/peco/peco)\n  - [fzy](https://github.com/jhawthorn/fzy)\n  - [fzf](https://github.com/junegunn/fzf)"
__et_option=()
__rsync_option=(-a)
__scp_option=(-r)
__ssh_option=()
__transfer_operands=()
__submit_n_retry_launch=0
__submit_retry_launch_interval=60
__submit_n_retry_ssh=0
__submit_retry_ssh_interval=10

__options="
--all|-a Set 1 to ignore preset filters.
 --config Configuration file to read instead of the default config file.
 --environment-config|-E Configuration file for make_ami/setup.
 --workdir|-W Working directory for environment commands.
 --install-config Set 1 to install setup output as the default ec2 config.
 --replace-config Set 1 to back up and replace an unmanaged ec2 config.
 --manifest Resource manifest used by cleanup_resources.
 --execute Set 1 to execute cleanup_resources instead of showing its plan.
--aws-profile Profile name for aws cli (if not\nspecified, the default profile is used.)
--cli-input-json|-c A json file which has parameters to launch\nan instance. Multiple files can be\nassigned by comma separated list.\nIf multiple files are given, secondary\nfiles are used if the first one failed by\nthe capacity problem.
--cli-input-json-group|-G JSON group name for launch\nan instance. Multiple groups can be\nassigned by comma separated list.\nIf multiple groups are given, secondary\ngroups are used if the first one failed by\nthe capacity problem.
--cli-input-json-directory|-C A directory which has json files. If\ncli_input_json is not assigned and\ncli_input_json_directory is set, files are\nsearched and it enters the selection mode.
--cpu-filter Filter to pick up instance type by CPU.
--dry-run|-d Set 1 to run as dry run mode (modification\ncommands are not executed.)
--et-option Additional Eternal Terminal argument. Repeat for more.
--gpu-filter Filter to pick up instance type by GPU.
--image-id Image name for new_image/rm_image command.
--image-name|-I Image name for new_image/rm_image command.
--image-name-filter Filter to pick up images (AMI).
--instance-id|-i Assign instance id to be managed. If '' or\n'select' is passed, it is selected\ninteractively.
--instance-type|-t  Instance type for launch command. If ''\nor 'select' is passed, it is selected\n interactively.
--mosh-server|-m Mosh server path.
--n-cpu-core|-n Set number of CPU core of instance to set\nother than default number.
--n-thread Set 1 to disable hyper-threading.
--name-filter|-f Only instances which include this value\nis listed.
--private-ip|-P Set 1 to use private IP addresses instead\nof public IP addresses.
--retry-non-spot Set 0 to disable retry to launch a\nnon-spot instance when launching a spot\ninstance failed.
--rsync-option Additional rsync argument. Repeat for more.
--scp-option Additional scp argument. Repeat for more.
--selection-tool|-s Selection tool list, separated by ','. The\ndefault value is '$__selection_tool'.\nThe first one found is used. If nothing,\nbash's 'select' is used. Tools ref:\n$__selection_tool_ref
--spot-instance|-S Set 1 to launch a spot instance.
--ssh-key|-k Key for ssh.
--ssh-option Additional SSH argument. Repeat for more.
--ssh-user|-u User for ssh.
--submit-command Set 1 to submit command instead of\nsubmitting script file.
--submit-current-dir Set 1 to use the current directory as the\nworking directory by submit.
--submit-n-retry-launch Number of retries to launch an instance by\nsubmit. Default is $__submit_n_retry_launch.
--submit-retry-launch-interval Interval of retry to launch an instance by\nsubmit (sec) when all combinations of\ncli_input_json failed. Default is $__submit_retry_launch_interval.
--submit-n-retry-ssh Number of retries after ssh connection\nfailed. Default is $__submit_n_retry_ssh.
--submit-retry-ssh-interval Interval of retry after ssh connection\nfailed (sec). Default is $__submit_retry_ssh_interval.
--submit-name Name of submitted job. If not given, the\ncommand name is used.
--submit-max-jobs Maximum number of submitted jobs running\nin parallel.
--submit-measure-time Set 1 to measure time of the command.
--submit-remain-instance Set 1 to keep instances after finishing\nsubmitted jobs.
--template-id|-T Assign template id. If not given, not\ntemplated is used. If 'select' is passed,\nit is selected interactively.
--user-data|-U user data file for luanch (run-instances),\ne.g: file:///path/to/your/user/data/script or fileb:///path/to/your/user/data/script.gz
--verbose|-v Set 1 to run as verbose mode (show\nexecuting commands.)
"

_print_list () {
  # shellcheck disable=SC2206
  local headers=($1)
  local contents="$2"
  # shellcheck disable=SC2206
  local types=($3)
  local n_cols=${#headers[@]}
  local width=()
  local i
  for ((i=0; i<n_cols; i++));do
    width[i]=${#headers[i]}
  done
  local line
  while read -r line || [ -n "${line}" ];do
    # shellcheck disable=SC2206
    local columns=($line)
    for ((i=0; i<n_cols; i++));do
      if (( width[i] < ${#columns[i]} ));then
        width[i]=${#columns[i]}
      fi
    done
  done < <(echo -n "$contents")
  local format_header=""
  local format=""
  for ((i=0; i<n_cols; i++));do
    format_header="${format_header:+${format_header} }%-${width[i]}s"
    if [ "${types[i]}" == "d" ];then
      format="${format:+${format} }%${width[i]}d"
    else
      format="${format:+${format} }%-${width[i]}s"
    fi
  done
  # shellcheck disable=SC2059
  printf "$format_header\n" "${headers[@]}"
  # shellcheck disable=SC2059
  printf "%0$(printf "$format_header" "${headers[@]}"|wc -c|xargs)d\n"|tr 0 -
  while read -r line || [ -n "${line}" ];do
    # shellcheck disable=SC2059,SC2086
    printf "$format\n" $line
  done < <(echo -n "$contents")
}

_sedi () {
  (
    eval "exec $__submit_sedi_lock_fd>$__submit_sedi_lock"
    flock -x $__submit_sedi_lock_fd
    tmpfile=$(mktemp)
    sed "$1" "$2" > "$tmpfile"
    mv "$tmpfile" "$2"
  )
}

_tac () {
  echo "$@" | sed -n '1!G;h;$p'
}

_check_job_instances () {
  (
    eval "exec $__submit_sedi_lock_fd>$__submit_sedi_lock"
    flock -x $__submit_sedi_lock_fd
    if [ -n "$__submit_max_jobs" ] && (( __submit_max_jobs > 0 )) && (( $(grep -c -e running -e starting -e launching -e terminating "$__job_list") > __submit_max_jobs ));then
      echo 1
    else
      echo 0
    fi
  )
}

_execute () {
  if [ "$__verbose" = "1" ];then
    echo "$*"
  fi
  __execute_result="$(eval "$*" 2>&1)"
  local ret=$?
  __execute_result="$(echo "$__execute_result"|awk 'NR==1 && /^$/ {next} {print}')"
  if [ $ret != 0 ];then
    if echo "$__execute_result"|grep -q DryRunOperation;then
      return 0
    elif [ "$__exit_at_fail" != "0" ];then
      echo "ERR_CODE=$ret: $__execute_result" 1>&2
      exit $ret
    fi
  fi
  return $ret
}

_execute_aws () {
  local cmd="aws $* ${__aws_profile:+--profile ${__aws_profile}}"
  while :;do
    __exit_at_fail=0 _execute "$cmd"
    local ret=$?
    if [ "$ret" -eq 0 ];then
      return 0
    fi
    if [ "$ret" -eq 255 ];then
      aws sso login ${__aws_profile:+--profile ${__aws_profile}} 1>&2
      local ret=$?
      if [ "$ret" -eq 0 ];then
        continue
      else
        echo "ERR_CODE=$ret: $__execute_result" 1>&2
        exit $ret
      fi
    fi
    if [ "$__exit_at_fail" = "0" ];then
      return $ret
    fi
    echo "ERR_CODE=$ret: $__execute_result" 1>&2
    exit $ret
  done
}

_execute_ec2 () {
  _execute_aws ec2 "$*"
}

_select () {
  local input=("$@")
  local tool
  local t
  for t in $(echo "${__selection_tool:-sentaku,peco,fzy,fzf}"|tr , ' ');do
    if type "$t" >& /dev/null ;then
      tool=$t
      break
    fi
  done
  if [[ "$tool" = "sentaku" ]];then
    tool="sentaku -s line"
  fi
  if [ -n "$tool" ];then
    __selected=$(echo "${input[*]}"|$tool)
  else
    while IFS=$'\n' read -r line; do values+=("$line"); done < <(echo "${input[*]}")
    select value in "${values[@]}";do
      __selected=$value
      break
    done
  fi
}

_ip_choice () {
  local ip_choice="PublicIpAddress"
  if [ "$__private_ip" = "1" ];then
    ip_choice="PrivateIpAddress"
  fi
  echo "$ip_choice"
}
_get_instance_list () {
  # shellcheck disable=SC2089
  local cmd="describe-instances --query \"Reservations[*].Instances[*].{a:Tags[?Key=='Name']|[0].Value,b:InstanceId,c:$(_ip_choice),d:State.Name,e:InstanceType,f:InstanceLifecycle}\" --output text $__instance_filter"
  if [ -n "${__ids[__enum_instance]}" ];then
    local cmd="$cmd --instance-ids ${__ids[__enum_instance]}"
  fi
  _execute_ec2 "$cmd"
  # Tab replace is needed, otherwise grep fails to filter
  __list[__enum_instance]="$(echo "$__execute_result"|tr "\t" " "|sort -k 1,3 -V)"
  if [ -n "$__name_filter" ];then
    __list[__enum_instance]="$(echo "${__list[__enum_instance]}"|grep "$__name_filter")"
  fi
}

_get_image_list () {
  _execute_aws sts get-caller-identity --query "Account" --output text
  local account="$__execute_result"
  _execute_ec2 "describe-images --owners $account --query \"Images[*].{a:Name,b:ImageId,c:BlockDeviceMappings[0].Ebs.SnapshotId}\" --output text"
  # Sometime Name includes space prefix (?)
  __list[__enum_image]="$(echo "$__execute_result"|tr "\t" " "|awk '{print $1" "$2" "$3}'|sort -k 1 -V)"
  if [ -n "$__image_name_filter" ];then
    __list[__enum_image]="$(echo "${__list[__enum_image]}"|grep "$__image_name_filter")"
  fi
}

_get_template_list () {
  _execute_ec2 "describe-launch-templates --query 'LaunchTemplates[*].{a:LaunchTemplateName,b:LaunchTemplateId}' --output text"
  __list[__enum_template]="$(echo "$__execute_result"|tr "\t" " "|sort -k 1 -V)"
}

_get_type_list () {
  if [ -f "$__type_list_file" ];then
    find "$__type_list_file" -mtime +"$__type_list_file_term" -exec command rm -f {} +
  fi
  if [ ! -f "$__type_list_file" ];then
    # shellcheck disable=SC2089
    local cmd="describe-instance-types --query \"InstanceTypes[*].{a:InstanceType,b:VCpuInfo.DefaultVCpus,c:VCpuInfo.DefaultCores,d:VCpuInfo.DefaultThreadsPerCore,e:MemoryInfo.SizeInMiB,f:ProcessorInfo.SupportedArchitectures[0],g:GpuInfo.Gpus[0].Name}\" --output text"
    if [ -n "$filters" ];then
      cmd="$cmd $filters"
    fi
    _execute_ec2 "$cmd"
    __list[__enum_type]="$(echo "$__execute_result"|tr "\t" " "|sort -V)"
    echo "${__list[__enum_type]}" > "$__type_list_file"
  else
    __list[__enum_type]="$(cat "$__type_list_file")"
  fi

  if [ -n "$__cpu_filter" ];then
    __list[__enum_type]="$(echo "${__list[__enum_type]}"|grep "$__cpu_filter")"
  fi
  if [ -n "$__gpu_filter" ];then
    if [ "$__gpu_filter" == 0 ];then
      __list[__enum_type]="$(echo "${__list[__enum_type]}"|grep None)"
    elif [ "$__gpu_filter" == 1 ];then
      __list[__enum_type]="$(echo "${__list[__enum_type]}"|grep -v None)"
    else
      __list[__enum_type]="$(echo "${__list[__enum_type]}"|grep "$__gpu_filter")"
    fi
  fi
}

_select_objs () {
  local enum_obj=$1
  local only=$2
  ${__get_list_func[enum_obj]}
  if [ -z "${__list[enum_obj]}" ];then
    echo "No ${__obj_name[enum_obj]} is available"
    exit 1
  fi
  _select "${__list[enum_obj]}"
  if [ -z "$__selected" ];then
    echo "No ${__obj_name[enum_obj]} was selected"
    exit 1
  fi
  if [ "$only" = "1" ];then
    if [ "$(echo "$__selected"|wc -l|xargs)" != 1 ];then
      echo "More than 1 ${__obj_name[enum_obj]}s were selected"
      exit 1
    fi
  fi
  __list[enum_obj]="$__selected"
}

_get_ids () {
  local enum_obj=$1
  local only=$2
  if [ "${__ids[enum_obj]}" == "select" ] || [ -z "${__ids[enum_obj]}" ];then
    _select_objs "$enum_obj" "$only"
    __ids[enum_obj]="$(echo "${__list[enum_obj]}"|awk '{print $2}'|tr '\n' ' ')"
  fi
  if [ -z "${__ids[enum_obj]}" ];then
    exit
  fi
}

_get_id_name_list () {
  local enum_obj=$1
  __id_name_list=""
  if [ -n "${__list[enum_obj]}" ];then
    for id in ${__ids[enum_obj]};do
      __id_name_list="${__id_name_list:+${__id_name_list}, }$(echo "${__list[enum_obj]}"|grep "$id"|awk '{print $1}') ($id)"
    done
  else
    __id_name_list="$(echo "${__ids[enum_obj]}"|sed -e 's/ /, /g' -e 's/, $//')"
  fi
}

_instance_check () {
  if [ -z "${__ids[__enum_instance]}" ];then
    _select_objs $__enum_instance 1
  else
    _get_instance_list
  fi
  # shellcheck disable=SC2206
  __ids[__enum_instance]=$(echo "${__list[__enum_instance]}"|awk '{print $2}')
  __instance_ip=$(echo "${__list[__enum_instance]}"|awk '{print $3}')
  local status=$(echo "${__list[__enum_instance]}"|awk '{print $4}')

  wait_incorrect_spot_request_state=0
  while :;do
    if [ "$status" == "running" ];then
      break
    fi
    if [ "$status" == "stopped" ];then
      __exit_at_fail=0 start
      local ret=$?
      if [ "$ret" -eq 254 ] && echo "${__execute_result}"|grep -q "IncorrectSpotRequestState";then
        if [ $wait_incorrect_spot_request_state -eq 0 ];then
          echo "Waiting for spot request state to be correct after stopping..."
        fi
        ((wait_incorrect_spot_request_state++))
      elif [ "$ret" -ne 0 ];then
        echo "ERR_CODE=$ret: $__execute_result" 1>&2
        exit "$ret"
      fi
      sleep 5
    elif [ "$status" == "" ];then
      echo "${__ids[__enum_instance]} does not exist."
      exit 1
    else
      sleep 1
    fi
    _get_instance_list
    status=$(echo "${__list[__enum_instance]}"|awk '{print $4}')
  done
}

_get_name_number () {
  local name="$1"
  local names="$2"
  local suffix=$(basename "${name//-//}")
  if [[ "$suffix" =~ ^[0-9]+$ ]];then
    name_base="${name%-"${suffix}"}"
  else
    name_base="${name}"
  fi
  suffix=1
  name="${name_base}-$(printf "%02d" "$suffix")"
  while :;do
    if ! echo "$names"|grep -q "^${name}$";then
      break
    fi
    ((suffix++))
    name="${name_base}-$(printf "%02d" "$suffix")"
  done
  echo "$name"
}

_get_template () {
  if [ -n "${__ids[__enum_template]}" ];then
    _get_ids $__enum_template 1
    _execute_ec2 "describe-launch-template-versions --launch-template-id ${__ids[__enum_template]} --filters Name=is-default-version,Values=true --query \"LaunchTemplateVersions[0].{a:LaunchTemplateName,b:LaunchTemplateData.InstanceType,c:LaunchTemplateData.TagSpecifications[0].Tags[?Key=='Name']|[0].Value}\" --output text"
    # shellcheck disable=SC2206
    local result=($__execute_result)
    __template_name="${result[0]}"
    __tempalte_instance_type="${result[1]}"
    __template_name_name="${result[2]}"
    if [ -z "$name" ];then
      __template_name_name="$template_name"
    fi
    __launch_template="--launch-template LaunchTemplateId=${__ids[__enum_template]}"
  fi
}

_get_json_group () {
  local group_name="$1"
  local group_var="cli_input_json_group_${group_name}"
  local group_value
  eval "group_value=\${__${group_var}}"
  if [ -z "$group_value" ]; then
    echo "JSON group '${group_name}' not found in config" >&2
    return 1
  fi
  echo "$group_value"
}

list_json_groups () {
  # List available JSON groups
  local header="Group Files"
  local contents=""
  local group
  for group in "${__cli_input_json_groups[@]}";do
    local var_name=__cli_input_json_group_$group
    local files=${!var_name}
    contents="$contents$group $files"$'\n'
  done

  if [ -z "$contents" ]; then
    echo "No JSON groups defined in config"
    return 0
  fi

  echo "JSON directory: $__cli_input_json_directory"
  echo ""
  _print_list "$header" "$contents"
}

_get_cli_input_jsons () {
  if [ -n "$__cli_input_json" ] && [ "$__cli_input_json" != "select" ]; then
    :
  elif [ -n "$__cli_input_json_group" ]; then
    if [ "$__cli_input_json_group" = "select" ]; then
      if [ "${#__cli_input_json_groups[@]}" -eq 0 ];then
        echo "No cli_input_json_group is defined"
        exit 1
      fi
      _select "${__cli_input_json_groups[@]}"
      __cli_input_json_group=$__selected
      if [ -z "$__cli_input_json_group" ];then
        echo "No cli_input_json_group is selected"
        exit 1
      fi
    fi
    local var_name=__cli_input_json_group_${__cli_input_json_group}
    __cli_input_json=${!var_name}
  elif [ "$__cli_input_json" = "select" ]; then
    if [ -z "$__cli_input_json_directory" ]; then
      echo "Set cli_input_json_directory by: ec2 -C <cli_input_json_directory> <command>"
      exit 1
    fi
    _select "$(command ls "$__cli_input_json_directory")"
    __cli_input_json="$__selected"
  fi

  # shellcheck disable=SC2086
  read -r -a __cli_input_json_list <<< "$(echo $__cli_input_json | tr "," " ")"
}

_get_cli_input_json_opt () {
  _get_cli_input_jsons
  if [ "${#__cli_input_json_list[@]}" -eq 0 ];then
    __cli_input_json_opt=""
    return
  fi
  if [ $__n_cli_input_json -ge ${#__cli_input_json_list[@]} ];then
    echo "No cli_input_json is available @ $__n_cli_input_json"
    exit 1
  fi
  local json=${__cli_input_json_list[__n_cli_input_json]}
  if [[ ! "$json" =~ ^file:// ]];then
    if [ -f "$json" ];then
      json="file://$json"
    elif [ -f "$__cli_input_json_directory/$json" ];then
      json="file://$__cli_input_json_directory/$json"
    else
      echo "cli_input_json is not found: $json"
      exit 1
    fi
  fi
  __cli_input_json_opt="--cli-input-json $json"
}

launch () {
  # Launch a new instance.
  local name=""
  local instance_type=""
  __instance_filter="--filters Name=instance-state-name,Values=pending,running,stopping,stopped" _get_instance_list
  local names=$(echo "${__list[__enum_instance]}"|awk '{print $1}')

  _get_template
  if [ -n "$__template_name" ];then
    local template_name="$__template_name"
    instance_type="$__tempalte_instance_type"
    name="$__template_name_name"
    local launch_template="$__launch_template"
  fi
  _get_cli_input_jsons
  if [ -z "$__template_name" ] && [ -z "${__cli_input_json_list[*]}" ];then
    echo "Need at least template_id or cli_input_json" 1>&2
    exit 1
  fi

  if [ "$__instance_type" == "select" ];then
    _select_objs $__enum_type 1
    __instance_type=$(echo "${__list[__enum_type]}"|awk '{print $1}')
  fi
  if [ -n "${__instance_type}" ];then
    instance_type="${__instance_type}"
  fi
  if [ -n "${instance_type}" ];then
    instance_type_opt="--instance-type ${instance_type}"
  fi
  local cpu_options
  if [ -n "$__n_cpu_core" ] || [ -n "$__n_thread" ];then
    if [ -z "$__n_cpu_core" ] || [ -z "$__n_thread" ];then
      _get_type_list
      read -r -a type_info <<< "${__list[__enum_type]}"
      cpu_core=${__n_cpu_core:-${type_info[2]}}
      n_thread=${__n_thread:-${type_info[3]}}
    fi
    cpu_options="--cpu-options \"CoreCount=${cpu_core},ThreadsPerCore=${n_thread}\""
  fi
  local user_data
  if [ -n "$__user_data" ];then
    if [[ ! "$__user_data" =~ ^file ]];then
      if file --mime "$__user_data" | grep -q 'charset=binary'; then
        __user_data="fileb://$__user_data"
      else
        __user_data="file://$__user_data"
      fi
    fi
    user_data="--user-data $__user_data"
  fi

  local spot_instance
  if [ "$__spot_instance" = 1 ];then
    spot_instance="$__opt_spot"
  else
    __spot_instance=0
  fi

  local fail_reason=""
  while [ "$__spot_instance" -ge 0 ];do
    if [ "${#__cli_input_json_list[@]}" -eq 0 ];then
      __n_cli_input_json=-1
    fi
    while [ "$__n_cli_input_json" -lt "${#__cli_input_json_list[@]}" ];do
      _get_cli_input_json_opt
      if [ -n "$__cli_input_json_opt" ];then
        name=$(basename "$(echo "${__cli_input_json_opt}"|cut -d ' ' -f 2)")
        name="${name%.json}"
      fi
      name=$(_get_name_number "$name" "$names")

      if [ "$__n_cli_input_json" -gt 0 ];then
        echo "Try launching next cli_input_json (${__cli_input_json_list[__n_cli_input_json]})" 1>&2
      fi

      local msg="Launching a new instance: name=$name"
      msg="$msg${instance_type:+, type=${instance_type}}"
      if [ "$__n_cli_input_json" -ge 0 ];then
        msg="$msg, cli_input_json=${__cli_input_json_list[__n_cli_input_json]}"
      fi
      msg="$msg${template_name:+, template=$template_name}"
      if [ "$__spot_instance" = 1 ];then
        msg="$msg, lifecycle=spot"
      fi
      echo "$msg" 1>&2

      __exit_at_fail=0 _execute_ec2 "run-instances ${__dry_run_mode} ${cpu_options} ${spot_instance} ${user_data} ${launch_template} ${__cli_input_json_opt} ${instance_type_opt} --tag-specifications 'ResourceType=instance,Tags=[{Key=Name,Value=$name}]' --query \"Instances[*].{a:Tags[?Key=='Name']|[0].Value,b:InstanceId,c:$(_ip_choice),d:InstanceType}\" --output text"
      local ret=$?
      if [ "$ret" -eq 0 ];then
        break
      fi
      echo "ERR_CODE=$ret: $__execute_result" 1>&2
      if [ "$ret" -eq 254 ] && echo "${__execute_result}"|grep -q "InsufficientInstanceCapacity";then
        fail_reason="InsufficientInstanceCapacity"
        ((__n_cli_input_json++))
        continue
      fi
      exit "$ret"
    done
    if [ "$ret" -eq 0 ];then
      break
    fi
    if [ "$__retry_non_spot" = 0 ];then
      break
    fi
    spot_instance=""
    ((__spot_instance--))
    if [ "$__spot_instance" -eq 0 ];then
      echo "Try launching non spot instance" 1>&2
      __n_cli_input_json=0
    fi
  done
  if [ "$ret" -ne 0 ];then
    if [ -n "$fail_reason" ];then
      echo "Failed to launch instance by $fail_reason"
    fi
    exit "$ret"
  fi

  if [ "$__dry_run" = "1" ];then
    local id="XXX"
    local ip="XXX"
  else
    # shellcheck disable=SC2206
    local result=(${__execute_result})
    name=${result[0]}
    local id=${result[1]}
    local ip=${result[2]}
    instance_type=${result[3]}
  fi
  local spot_instance_msg
  if [ "$__spot_instance" = "1" ];then
    spot_instance_msg=", Lifecycle=spot"
  fi
  echo "${__dry_run_mode:+Dry run: }A new instance was launched: Name=$name, Id=$id, $(_ip_choice)=$ip, Type=${instance_type}${spot_instance_msg}"
}

start () {
  # Start stopped instances.
  __instance_filter="--filters Name=instance-state-name,Values=stopped" _get_ids $__enum_instance
  _execute_ec2 "$__dry_run_mode start-instances --instance-ids ${__ids[__enum_instance]}"
  local ret=$?
  _get_id_name_list $__enum_instance
  if [ "$ret" -eq 0 ];then
    echo "${__dry_run_mode:+Dry run: }Started: $__id_name_list"
  fi
  return "$ret"
}

stop () {
  # Stop running instances.
  __instance_filter="--filters Name=instance-state-name,Values=running" _get_ids $__enum_instance
  _execute_ec2 "$__dry_run_mode stop-instances --instance-ids ${__ids[__enum_instance]}"
  local ret=$?
  _get_id_name_list $__enum_instance
  if [ $ret -eq 0 ];then
    echo "${__dry_run_mode:+Dry run: }Stopped: $__id_name_list"
  fi
  return $ret
}

terminate () {
  # Terminate instances.
  __instance_filter="--filters Name=instance-state-name,Values=pending,running,stopping,stopped" _get_ids ${__enum_instance}
  _execute_ec2 "describe-instances --instance-ids ${__ids[__enum_instance]} --query \"Reservations[*].Instances[*].SpotInstanceRequestId\" --output text"
  local spot_instances="${__execute_result}"
  local spot_instance_msg
  if [ -n "${spot_instances}" ];then
    spot_instance_msg=""
    for spot_request in ${spot_instances};do
      if [ -n "${spot_request}" ];then
        _execute_ec2 "${__dry_run_mode} cancel-spot-instance-requests --spot-instance-request-ids ${spot_request}"
        spot_instance_msg="${spot_instance_msg:+${spot_instance_msg}, }$spot_request"
      fi
    done
    spot_instance_msg=", cancel Spot Instance Request: $spot_instance_msg"
  fi
  _execute_ec2 "${__dry_run_mode} terminate-instances --instance-ids ${__ids[__enum_instance]}"
  _get_id_name_list ${__enum_instance}
  echo "${__dry_run_mode:+Dry run: }Terminated: ${__id_name_list}${spot_instance_msg}"
}

rm () {
  # Alias for terminate.
  terminate
}

instances () {
  # List instances.
  _get_instance_list
  local header="Name Id Ip Status Type Lifecycle"
  local contents=""
  local line
  while read -r line || [ -n "${line}" ];do
    # shellcheck disable=SC2206
    line=($line)
    local name=${line[0]}
    local id=${line[1]}
    local ip=${line[2]}
    local st=${line[3]}
    local ty=${line[4]}
    local sp=${line[5]}
    contents=${contents}"$name $id $ip $st $ty $sp"$'\n'
  done < <(echo "${__list[__enum_instance]}")
  _print_list "$header" "$contents"
}

list () {
  # Alias for instances.
  instances
}

ls () {
  # Alias for instances.
  instances
}

describe () {
  # Show detailed information about instances
  _get_ids $__enum_instance

  _execute_ec2 "describe-instances --instance-ids ${__ids[__enum_instance]} \
    --query 'Reservations[*].Instances[*].{
      Name:Tags[?Key==\`Name\`].Value|[0],
      InstanceId:InstanceId,
      InstanceType:InstanceType,
      State:State.Name,
      LaunchTime:LaunchTime,
      Platform:Platform,
      PrivateIP:PrivateIpAddress,
      PublicIP:PublicIpAddress,
      KeyName:KeyName,
      SecurityGroups:SecurityGroups[*].GroupName
    }' \
    --output table"

  echo "$__execute_result"
}

ssh () {
  # SSH to an instance.
  # Use `ssh [commands] [options]`.
  local cmd="${1:-ssh}"
  _instance_check
  local -a ssh_options=("${__ssh_option[@]}")
  if [ -n "$__ssh_key" ];then
    ssh_options+=(-i "$__ssh_key")
  fi
  local ip=$__instance_ip
  if [ -n "$__ssh_user" ];then
    ip="$__ssh_user@$ip"
  fi
  waiting_for_ready=0
  while :;do
    command ssh "${ssh_options[@]}" "$ip" "sudo tail -n1 /var/log/cloud-init-output.log |grep 'Cloud-init.*finished at.*seconds$'" >/dev/null 2>&1
    local ret=$?
    if [ "$ret" -eq 0 ];then
      break
    fi
    if [ "$waiting_for_ready" -eq 0 ];then
      echo "Waiting for ready..."
    fi
    ((waiting_for_ready++))
    sleep 5
    # Soemtime instance is stopped during waiting, restart it if needed.
    _instance_check
  done
  local -a execute_command=()
  if [ -n "${__execute_command:-}" ];then
    execute_command=("$__execute_command")
  fi
  if [ "$cmd" = "mosh" ];then
    if ((${#ssh_options[@]}));then
      local mosh_ssh
      printf -v mosh_ssh '%q ' ssh "${ssh_options[@]}"
      ssh_options=("--ssh=${mosh_ssh% }")
    else
      ssh_options=()
    fi
    if [ -n "$__mosh_server" ];then
      ssh_options+=("--server=$__mosh_server")
    fi
  elif [ "$cmd" = "et" ];then
    local -a et_options=("${__et_option[@]}")
    local i option
    for ((i=0; i<${#ssh_options[@]}; i++));do
      option=${ssh_options[i]}
      case "$option" in
        -o|-i)
          if ((i + 1 >= ${#ssh_options[@]}));then
            echo "$option requires a value for an Eternal Terminal connection." >&2
            return 2
          fi
          ((i += 1))
          if [ "$option" = "-o" ];then
            et_options+=(--ssh-option "${ssh_options[i]}")
          else
            et_options+=(--ssh-option "IdentityFile=${ssh_options[i]}")
          fi
          ;;
        -o?*) et_options+=(--ssh-option "${option#-o}");;
        -i?*) et_options+=(--ssh-option "IdentityFile=${option#-i}");;
        *)
          echo "SSH argument '$option' cannot be forwarded to Eternal Terminal; use --et-option or ~/.ssh/config." >&2
          return 2
          ;;
      esac
    done
    if ((${#execute_command[@]}));then
      et_options+=(--command "${execute_command[0]}")
      execute_command=()
    fi
    ssh_options=("${et_options[@]}")
  fi
  command "$cmd" "${ssh_options[@]}" "$ip" "${execute_command[@]}"
}

et () {
  # Connect to an instance with Eternal Terminal.
  # Use `et [command] [options]`.
  ssh et
  local ret=$?
  _instance_check
  return "$ret"
}

mosh () {
  # Mosh to an instance.
  # Use `mosh [commands] [options]`.
  ssh mosh
  local ret=$?
  _instance_check
  return "$ret"
}

_transfer () {
  local cmd=$1
  local -a operands=("${__transfer_operands[@]}")
  if ((${#operands[@]} == 0)) && [ "$cmd" = "scp" ] && [ -n "${__file:-}" ];then
    # submit uses the legacy single-file upload internally.
    operands=("$__file")
  fi
  if ((${#operands[@]} == 0));then
    echo "Usage: $__cmd $cmd <source> <destination>" >&2
    return 2
  fi
  if [ "$cmd" = "scp" ] && ((${#operands[@]} == 1));then
    operands+=(":")
  elif ((${#operands[@]} < 2));then
    echo "Usage: $__cmd $cmd <source> <destination>" >&2
    return 2
  fi

  local last=$((${#operands[@]} - 1))
  local remote_destination=0
  [[ "${operands[last]}" == :* ]] && remote_destination=1
  local remote_sources=0 i
  for ((i=0; i<last; i++));do
    [[ "${operands[i]}" == :* ]] && ((remote_sources += 1))
  done
  if ((remote_destination && remote_sources));then
    echo "$cmd cannot copy between two remote paths." >&2
    return 2
  fi
  if ((!remote_destination && !remote_sources));then
    # With no explicit ':' marker, retain the upload-oriented scp behavior.
    operands[last]=":${operands[last]}"
    remote_destination=1
  elif ((!remote_destination && remote_sources != last));then
    echo "$cmd cannot mix local and remote source paths." >&2
    return 2
  fi
  if ((remote_destination));then
    for ((i=0; i<last; i++));do
      if [ ! -e "${operands[i]}" ] && [ ! -L "${operands[i]}" ];then
        echo "${operands[i]} does not exist" >&2
        return 2
      fi
    done
  fi

  _instance_check
  local -a ssh_options=("${__ssh_option[@]}")
  if [ -n "$__ssh_key" ];then
    ssh_options+=(-i "$__ssh_key")
  fi
  local ip=$__instance_ip
  if [ -n "$__ssh_user" ];then
    ip="$__ssh_user@$ip"
  fi
  local waiting_for_ready=0
  while :;do
    command ssh "${ssh_options[@]}" "$ip" "exit" >/dev/null 2>&1
    local ret=$?
    if [ $ret -eq 0 ];then
      break
    fi
    if [ "$waiting_for_ready" -eq 0 ];then
      echo "Waiting for ready..."
    fi
    ((waiting_for_ready += 1))
    sleep 5
    # Soemtime instance is stopped during waiting, restart it if needed.
    _instance_check
  done

  for ((i=0; i<${#operands[@]}; i++));do
    if [[ "${operands[i]}" == :* ]];then
      operands[i]="$ip:${operands[i]#:}"
    fi
  done
  if [ "$cmd" = "rsync" ];then
    local rsync_ssh
    printf -v rsync_ssh '%q ' ssh "${ssh_options[@]}"
    command rsync "${__rsync_option[@]}" -e "${rsync_ssh% }" "${operands[@]}"
    return
  fi

  local -a scp_ssh_options=()
  local option
  for ((i=0; i<${#ssh_options[@]}; i++));do
    option=${ssh_options[i]}
    case "$option" in
      -p)
        if ((i + 1 >= ${#ssh_options[@]}));then
          echo "-p requires a port value." >&2
          return 2
        fi
        ((i += 1))
        scp_ssh_options+=(-P "${ssh_options[i]}")
        ;;
      -p?*) scp_ssh_options+=(-P "${option#-p}");;
      *) scp_ssh_options+=("$option");;
    esac
  done
  command scp "${scp_ssh_options[@]}" "${__scp_option[@]}" "${operands[@]}"
}

rsync () {
  # Synchronize files with an instance.
  # Prefix an instance path with `:`, for example `rsync ./src/ :/srv/src/`.
  _transfer rsync
}

scp () {
  # Copy files to or from an instance.
  # Prefix an instance path with `:`, for example `scp file :/tmp/`.
  _transfer scp
}

_clear_job () {
  local clear_lsit=${1:-1}
  if [ -n "${__ids[__enum_instance]}" ];then
    _sedi "s/${job_id}.*$/${job_id} ${instance_id} ${instance_ip} terminating/" "$__job_list"
    if [ "$__submit_remain_instance" != "1" ];then
      terminate
    fi
  fi
  if [ "$clear_lsit" = 1 ];then
    _sedi "/^${job_id} /d" "$__job_list"
  fi
}

submit () {
  # Make a new instance and submit a job.
  # Use `submit <file or commands> [options].
  # If __submit_command is not set, need one
  # bash file.
  # If __submit_command is set, given options
  # are recognized as command. Use `--` to
  # separate options for ec2 and options  for
  # the command.
  # If `__curent_dir` is set, the command is
  # executed in the current directory.
  # (Need same directory structure in the
  # instance.)
  if ! type flock >/dev/null 2>&1;then
    echo "flock is required for 'submit'"
    echo "Install flock ('brew install flock' or anything)"
    exit 1
  fi

  if [ -z "$__submit_name" ];then
    __submit_name=$(basename "$(echo "${__positional[0]}" | cut -d ';' -f1 | cut -d ' ' -f1)")
  fi
  local job_id="$$ $(date +"%Y-%m-%d %H:%M:%S") $__submit_name"

  trap "_clear_job;exit 1" HUP INT QUIT ABRT SEGV TERM

  echo "$job_id - - waiting" >> "$__job_list"

  while :;do
    if [ "$(_check_job_instances)" = 1 ];then
      sleep 5
    else
      break
    fi
  done

  _sedi "s/${job_id}.*$/${job_id} - - starting/" "$__job_list"
  echo "Launching an instance for job: $job_id"
  local n_retry_ssh=0
  while :;do
    local n_retry=0
    local ret=0
    local output=""
    while :;do
      output=$(
        eval "exec $__submit_launch_lock_fd>$__submit_launch_lock"
        flock -x $__submit_launch_lock_fd
        _sedi "s/${job_id}.*$/${job_id} - - launching/" "$__job_list"
        output=$(launch)
        ret=$?
        echo "$output"
        if [ $ret -ne 0 ];then
          echo "ERR_CODE=$ret: Failed to launch instance for job: $job_id"
          exit $ret
        fi
      )
      local ret=$?
      if [ $ret -eq 0 ];then
        break
      fi
      if [ $ret -ne 254 ] || ! echo "$output" | grep -q "InsufficientInstanceCapacity";then
        break
      fi
      ((n_retry++))
      if [ $n_retry -le "${__submit_n_retry_launch}" ];then
        echo "Failed to launch instance by capacity, retry after ${__submit_retry_launch_interval} seconds..."
        sleep "${__submit_retry_launch_interval}"
        continue
      fi
      break
    done
    if [ $ret -ne 0 ];then
      echo "$output" 1>&2
      _clear_job
      exit $ret
    fi
    local instance_id=$(echo "$output" |tr ',' $'\n'|grep "^ Id"|cut -d '=' -f2)
    local instance_ip=$(echo "$output" |tr ',' $'\n'|grep "^ $(_ip_choice)"|cut -d '=' -f2)
    local instance_type=$(echo "$output" |tr ',' $'\n'|grep "^ Type"|cut -d '=' -f2)
    __ids[__enum_instance]="$instance_id"
    _sedi "s/${job_id}.*$/${job_id} ${instance_id} ${instance_ip} launching/" "$__job_list"

    # Wait the instance be ready
    __execute_command="exit"
    ssh
    _sedi "s/${job_id}.*$/${job_id} ${instance_id} ${instance_ip} running/" "$__job_list"

    if [ "$__submit_command" != "1" ];then
      __execute_command="bash ~/$(basename "$__file")"
    else
      __execute_command="${__positional[*]}"
    fi
    if [ "$__submit_measure_time" = "1" ];then
      __execute_command="time $__execute_command"
    fi
    __execute_command="echo RUN STARTED;echo Execute \"$__execute_command\" at job_id=$job_id, insatnce_id=$instance_id, instance_ip=$instance_ip, instance_type=$instance_type; $__execute_command; echo RUN FINISHED"
    if [ "$__submit_command" != "1" ];then
      scp
    fi
    if [ "$__submit_current_dir" = 1 ];then
      __execute_command="cd $PWD; $__execute_command"
    fi
    ssh
    local ret=$?
    if [ $ret -eq 255 ];then
      echo "SSH connection was closed by the remote host"
      ((n_retry_ssh++))
      if [ $n_retry_ssh -lt "${__submit_n_retry_ssh}" ];then
        _clear_job 0
        _sedi "s/${job_id}.*$/${job_id} - - retrying/" "$__job_list"
        echo "Retry after ${__submit_retry_ssh_interval} seconds..."
        sleep "${__submit_retry_ssh_interval}"
        continue
      fi
    fi
    break
  done

  echo "finishing job: $job_id, return code: $ret"
  _execute_ec2 "describe-instances --instance-ids ${instance_id} --query \"Reservations[*].Instances[*].{a:State.Name,b:StateTransitionReason}\" --output text"
  echo "Instance state: $__execute_result"
  echo "Clear job: $job_id"
  _clear_job
}

jobs () {
  # List jobs.
  touch "$__job_list"
  _print_list "PID DATE TIME NAME INSTANCE_ID IP STATUS" "$(cat "$__job_list")"
}

delete_job () {
  # Delete jobs.
  if [ ! -f "$__job_list" ];then
    echo "No job"
    exit 0
  fi
  local job_list=$(cat "$__job_list")
  if [ -z "$job_list" ];then
    echo "No job"
    exit 0
  fi

  local job jobs
  if [ -z "${__positional[0]}" ];then
    _select "$(cat "$__job_list")"
    jobs=$(_tac "$__selected")
  else
    for pid in "${__positional[@]}";do
      job=$(echo "$job_list"|grep "^$pid ")
      if [ -z "$job" ];then
        echo "No job for PID: $pid"
        continue
      fi
      if [ -n "$jobs" ];then
        jobs="$jobs"$'\n'"$job"
      else
        jobs="$job"
      fi
    done
  fi
  local pid date time script instance_id instance_ip status
  while read -r pid date time script instance_id instance_ip status; do
    echo "Deleting job: $pid $date $time $script $instance_id $instance_ip $status"
    _sedi "s/$pid $date ${time}.*$/${pid} ${date} ${time} ${script} ${instance_id} ${instance_ip} deleting/" "$__job_list"
    kill -kill "$pid"
    if [ "$instance_id" != "-" ];then
      __ids[__enum_instance]="$instance_id"
      __exit_at_fail=0 terminate
    fi
    _sedi "/$pid /d" "$__job_list"
  done < <(echo "$jobs")
}

images () {
  # List images.
  _get_image_list
  local header="Name ImageId SnapshotId"
  local contents=""
  while read -r line || [ -n "${line}" ];do
    name=$(echo "$line"|awk '{print $1}')
    id=$(echo "$line"|awk '{print $2}')
    snapshot=$(echo "$line"|awk '{print $3}')
    contents=${contents}"$name $id $snapshot"$'\n'
  done < <(echo "${__list[__enum_image]}")
  _print_list "$header" "$contents"
}

new_image () {
  # Create a new image from an instance.
  _get_ids $__enum_instance 1
  if [ -z "$__image_name" ];then
    _get_instance_list
    __image_name="$(echo "${__list[__enum_instance]}"|tr '\t' ' '|grep "${__ids[__enum_instance]}"|awk '{print $1}')"
  fi
  if [ -z "$__image_name" ];then
    echo "Set image_name by: ec2 -I <image_name> new_images"
    exit 1
  fi

  _get_image_list
  local image_names="$(echo "${__list[__enum_image]}"|awk '{print $1}')"

  __image_name=$(_get_name_number "$__image_name" "$image_names")

  _execute_ec2 "${__dry_run_mode} create-image  --instance-id ${__ids[__enum_instance]} --name $__image_name"
  echo "${__dry_run_mode:+Dry run: }Created a new AMI $__image_name from ${__ids[__enum_instance]}"
}

rm_image () {
  # Delete images.
  _get_ids $__enum_image 1
  local snapshot=$(echo "${__list[__enum_image]}"|awk '{print $3}')
  _execute_ec2 "deregister-image ${__dry_run_mode} --image-id ${__ids[__enum_image]}"
  _execute_ec2 "delete-snapshot ${__dry_run_mode} --snapshot-id $snapshot"
  _get_id_name_list $__enum_image
  echo "${__dry_run_mode:+Dry run: }Deleted: AMI=$__id_name_list, Snapshot=$snapshot"
}

templates () {
  # List templates.
  _get_template_list
  local header="Name Id"
  local contents=""
  local line
  while read -r line || [ -n "${line}" ];do
    # shellcheck disable=SC2206
    line=($line)
    name=${line[0]}
    id=${line[1]}
    contents=${contents}"$name $id"$'\n'
  done < <(echo "${__list[__enum_template]}")
  _print_list "$header" "$contents"
}

new_template () {
  # Create a new template from an image.
  _get_ids $__enum_template 1
  _execute_ec2 "describe-launch-templates --launch-template-id ${__ids[__enum_template]} --query 'LaunchTemplates[*].DefaultVersionNumber' --output text"
  local default_version="$__execute_result"
  _select_objs $__enum_image 1
  local ami=$(echo "${__list[__enum_image]}"|awk '{print $2}')
  local snapshot=$(echo "${__list[__enum_image]}"|awk '{print $3}')
  _execute_ec2 "create-launch-template-version ${__dry_run_mode} --launch-template-id ${__ids[__enum_template]} --source-version $default_version --launch-template-data '{\"ImageId\":\"${ami}\"}' --query 'LaunchTemplateVersion.VersionNumber' --output text"
  local new_version=XXX
  if [ "${__dry_run}" != "1" ];then
    new_version="${__execute_result}"
    _execute_ec2 "modify-launch-template --launch-template-id ${__ids[__enum_template]} --default-version $new_version"
  fi
  _get_id_name_list $__enum_template
  echo "${__dry_run_mode:+Dry run: }Created a new template version $new_version for $__id_name_list"
}

types () {
  # List instance types.
  _get_type_list
  local header="Type vCPU Core Thread Mem(GiB) Arch GPU"
  local contents=""
  local line
  while read -r line || [ -n "${line}" ];do
    # shellcheck disable=SC2206
    line=($line)
    ty=${line[0]}
    vcpu=${line[1]}
    core=${line[2]}
    thread=${line[3]}
    mem=$((line[4] / 1024))
    arch=${line[5]}
    gpu=$(echo "${line[*]}"|cut -d' ' -f 7-|tr ' ' _)
    contents=${contents}"$ty $vcpu $core $thread $mem $arch $gpu"$'\n'
  done < <(echo "${__list[__enum_type]}")
  _print_list "$header" "$contents" "s d d d d s s"
}

update_types () {
  # Force update instance type list cache
  if [ -f "$__type_list_file" ]; then
     command rm -f "$__type_list_file"
  fi
  _get_type_list
  echo "Instance type list cache has been updated"
}

pricing () {
  # Show pricing of instance types.
  if [ "$__instance_type" == "select" ] || [ -z "$__instance_type" ];then
    _select_objs $__enum_type 0
    __instance_type=$(echo "${__list[__enum_type]}"|awk '{print $1}')
  fi
  # shellcheck disable=SC2206
  local types=(${__instance_type//,/ })
  _execute_aws configure get region
  local region="${__execute_result}"
  echo "Type USD"
  local t
  for t in "${types[@]}";do
    _execute_aws pricing get-products \
      --region us-east-1 \
      --service-code AmazonEC2 \
      --filters \
                'Type=TERM_MATCH,Field=instanceType,Value='"${t}" \
                'Type=TERM_MATCH,Field=regionCode,Value='"${region}" \
                'Type=TERM_MATCH,Field=preInstalledSw,Value=NA' \
                'Type=TERM_MATCH,Field=operatingSystem,Value=Linux' \
                'Type=TERM_MATCH,Field=tenancy,Value=Shared' \
                'Type=TERM_MATCH,Field=capacitystatus,Value=UnusedCapacityReservation' \
      --output text \
      --query 'PriceList[0]'
    local usd=$(echo "${__execute_result#*USD\":\"}"|cut -d'"' -f 1)
    echo "${t} ${usd}"
  done
}

price () {
  # Alias for pricing.
  pricing
}

commands () {
  # List commands.
  echo "$__subcommands"
}

help () {
  # Show help.
  _print_help
}

version () {
  # Show version.
  echo "ec2 $__version $__date"
}

_read_config () {
  local line
  __cli_input_json_groups=()
  if [ -f "$__config" ];then
    while read -r line || [ -n "${line}" ];do
      line="$(echo "$line"|cut -d '#' -f1)"
      line="${line#"${line%%[![:space:]]*}"}"
      line="${line%"${line##*[![:space:]]}"}"
      if [ -z "$line" ];then
        continue
      fi
      local opt="${line%%=*}"
      local val="${line#*=}"
      local config_name="${opt//-/_}"
      if [ "$config_name" = "ssh_option" ] || [ "$config_name" = "et_option" ] ||
         [ "$config_name" = "scp_option" ] || [ "$config_name" = "rsync_option" ];then
        local array_name="__$config_name"
        if [[ "$val" == \(*\) ]];then
          eval "$array_name=$val"
        else
          local option_value
          eval "option_value=$val"
          read -r -a "${array_name?}" <<< "$option_value"
        fi
      else
        eval "__$config_name=${val}"
      fi
      if [[ "${opt//-/_}" =~ ^cli_input_json_group_.*$ ]];then
        __cli_input_json_groups=("${__cli_input_json_groups[@]}" "${opt//cli_input_json_group_/}")
      fi
    done < "$__config"
  fi
}

_require_config () {
  [ -f "$__config" ] && return 0

  echo "EC2 configuration file not found: $__config" >&2
  if [ "$__config" != "$__default_config" ];then
    echo "Create that file or select an existing one with --config." >&2
    return 1
  fi
  cat >&2 << EOF
Create $__config manually with contents such as:
  name_filter=my-instances
  image_name_filter=my-images
  ssh_user=ec2-user

Or generate it from an environment configuration:
  ec2 init_environment
  ${EDITOR:-vi} $__environment_config
  ec2 setup
EOF
  return 1
}

_read_config_path () {
  while [[ $# -gt 0 ]]; do
    if [ "$1" = "--" ];then
      break
    fi
    if [ "$1" = "--config" ];then
      if [ $# -lt 2 ];then
        echo "Option --config requires an argument" 1>&2
        exit 1
      fi
      __config="$2"
      shift 2
    else
      shift
    fi
  done
}

_print_explain () {
  local value="$1"
  local spaces="$2"
  local name_length="$3"
  local comments="$4"

  local prefix=$(printf "%${spaces}s%-${name_length}s%s\n" "" "$value ")
  while IFS= read -r line; do
    printf "%s%s\n" "$prefix" "$line"
    prefix="${prefix//?/ }"
  done <<< "$comments"
}

_generate_read_args() {
  cat << EOF
_read_args() {
  __positional=()
  while [[ \$# -gt 0 ]]; do
    if [ \$1 = "--" ]; then
      shift
      __positional+=("\$@")
      break
    fi
    local opt="\${1//_/-}"
    case \$opt in
EOF

  echo "$__options" | while read -r line; do
    if [ -z "$line" ];then
      continue
    fi
    local opt=$(echo "$line" | awk '{print $1}')
    local val_name=$(echo "${opt//-/_}" | cut -d '|' -f 1)
    if [ "$val_name" = "__ssh_option" ] || [ "$val_name" = "__et_option" ] ||
       [ "$val_name" = "__scp_option" ] || [ "$val_name" = "__rsync_option" ];then
      echo "      $opt) ${val_name}+=(\"\$2\"); shift; shift;;"
    else
      echo "      $opt) ${val_name}=\"\$2\"; shift; shift;;"
    fi
  done

cat << EOF
      --help|-h) _print_help; exit;;
      -*)
        echo "Unknown option: \$1" 1>&2
        exit 1
        ;;
      *)
        if [ "\$1" = "help" ]; then
          _print_help
          exit
        fi
        __positional+=("\$1")
        shift
        ;;
    esac
  done
}
EOF
}

_print_args_help() {
  echo "Options:"
  local line
  echo "$__options" | while read -r line; do
    if [ -z "$line" ];then
      continue
    fi
    # shellcheck disable=SC2001
    local opt="$(echo "${line%% *}" | sed 's/|/, /g')"
    local comment="$(echo -e "${line#* }")"
    _print_explain "$opt" 2 35 "$comment"
  done
  _print_explain "--help, -h" 2 35 "Show help."
}

_extract_comments () {
  awk "/^${1} *\(\) *{/{flag=1;next}/^}/{flag=0}flag" "$0" | awk '/^ *#/{sub(/^ *# ?/, ""); print; next} {exit}'
}

_print_subcommands () {
  echo "Subcommands:"
  for func in $__subcommands;do
    local comments=$(_extract_comments "$func")
    _print_explain "$func" 2 35 "$comments"
  done
}

_print_help () {
  printf "Usage: %s <subcommand> [options]\n\n" "$__cmd"
  _print_subcommands
  echo
  _print_args_help
}

# BEGIN GENERATED ENVIRONMENT COMMANDS
_environment_extract() {
  local root=$1
  mkdir -p "$root"
  mkdir -p "$(dirname "$root/config.example")"
  cat >"$root/config.example" <<'__EC2_ASSET_config_example__'
# =============================================================================
#  ec2-environment configuration
# =============================================================================
#
#      ec2 init_environment
#      $EDITOR ~/.config/ec2/environment
#
#  -- How to read this file ----------------------------------------------------
#
#  Almost every setting is commented out and shows the value the scripts fall
#  back to, so an untouched copy already behaves sensibly. Uncomment a line only
#  to change it; deleting a line is the same as leaving it commented.
#
#  The uncommented lines are the ones you have to look at:
#
#    * marked "# REQUIRED" and shipped empty - the scripts have no default and
#      scripts/variables.sh refuses to run until every one of them is set. It lists
#      all the missing ones at once, so you do not have to find them one by one.
#    * the naming helpers and the AMI/filter names built from them - they work
#      as shipped, but every AMI and `ec2` lookup is named after them, so set
#      PREFIX to something unique to you before the first build.
#
#  -- Who reads this file ------------------------------------------------------
#
#  ec2 environment commands source this file, apply their defaults and helpers,
#                       and finally verify that
#                       `aws sts get-caller-identity` works, running
#                       `aws sso login --profile $PROFILE` once if it does not.
#  ec2 make_ami         Writes $WORKDIR/packer/main.json and
#                       $WORKDIR/packer/variables_<family>.json, then runs
#                       `packer validate` and `packer build` for every enabled
#                       AMI family.
#  ec2 setup            Resolves (or creates) the shared file systems, writes
#                       one launch JSON per subnet and family under
#                       $WORKDIR/ec2/cli_input_json/, writes the `ec2` command
#                       configuration to $WORKDIR/ec2/config, and generates the
#                       cloud-init user-data at $WORKDIR/ec2/user_data.sh[.gz].
#
#      ec2 make_ami
#      ec2 setup
#
#  Both default to work-directory=~/.config/ec2/work and
#  environment-config=~/.config/ec2/environment. Override them with --workdir
#  and --environment-config when needed.
#
#  -- Syntax rules -------------------------------------------------------------
#
#  * This file is sourced by bash, so shell expansion works. $HOME, $PWD,
#    $WORKDIR and $CONFIG are already exported when it is sourced, and any
#    variable defined earlier in this file can be reused later on.
#  * Comma-separated lists ("a,b,c") must not contain spaces.
#  * Package lists are space separated, because they are handed to dnf/yum.
#  * Boolean values are not uniform: each one is forwarded verbatim to a
#    different consumer (Packer, run-instances JSON, the `ec2` command, shell
#    tests), so the accepted values are stated per entry. Do not guess.
#  * Anything named *_IDS can be given as *_NAMES instead, and bootstrap.sh looks
#    the IDs up for you. *_IDS wins when both are set. A name that matches
#    nothing, or more than one resource, is an error rather than a guess.
#  * Every *_IDS list must have as many entries as its *_MOUNT_POINTS list
#    (scripts/common.sh: compare_length).
#  * For the remaining per-file-system option lists, a single value is broadcast
#    to all entries; otherwise the length must match the number of names
#    (scripts/common.sh: make_array).
#
#  -- Per-AMI-family overrides -------------------------------------------------
#
#  Every variable consumed by the Packer template can be overridden for a single
#  AMI family by prefixing it with CPU_ or GPU_
#  (scripts/make_ami.sh: make_vars / family_value). For example:
#
#      VOLUME_SIZE="60"        # applies to both families
#      GPU_VOLUME_SIZE="200"   # GPU family only
#
#  Supported bases: AMI_NAME, AMI_FILTER, AMI_OWNER, SOURCE_AMI_ID,
#  INSTANCE_TYPE, PROFILE,
#  REGION, SSH_INTERFACE, SSH_USERNAME, SECURITY_GROUP_IDS, SUBNET_ID, VPC_ID,
#  IAM_INSTANCE_PROFILE, DEVICE_NAME, DELETE_ON_TERMINATION, VOLUME_SIZE,
#  VOLUME_TYPE, ENCRYPTED, SCRIPTS, SWAP_BS, SWAP_COUNT, PACKAGES,
#  FLATPAK_PACKAGES, ADDITIONAL_PACKAGES, TIME_ZONE, SHUTDOWN,
#  SHUTDOWN_DURATION, SHUTDOWN_CHECK_PROCESS, MULTI_PROCESSING,
#  UPDATE_PACKAGES.
#
#  -- Required settings --------------------------------------------------------
#
#  Needed by every command:
#
#      REGION              AWS region                             (section 2)
#
#  Needed by ec2 setup only - it places instances and describes how you
#  reach them, which building an AMI does not:
#
#      SUBNET_IDS          subnet(s) to deploy into               (section 3)
#                          (or SUBNET_NAMES)
#      KEY_NAME            EC2 key pair name                      (section 3)
#
#  The file system scripts also need SUBNET_IDS, but only to create something.
#
#  <FAMILY>_AMI_NAME is required as well for every family whose
#  <FAMILY>_INSTANCE is 1 - CPU by default, GPU once you enable it.
#
# =============================================================================


# =============================================================================
#  1. Naming helpers
# =============================================================================
#  Not read by any script. They only exist so that the AMI names, file system
#  names and `ec2` filters below can be derived from one place, which is why
#  they and the names built from them are left active. Rename or drop them if
#  you prefer to spell every name out.

# Bump this whenever PACKAGES, SCRIPTS or the source AMI filter changes, so that
# a new AMI name - and therefore a new AMI - is produced instead of colliding
# with the existing one. Packer fails on a duplicate AMI name.
VERSION=1

# Prefix for AMI names, file system names and the `ec2` command filters. Keep it
# unique per person when several people share one AWS account.
PREFIX="dev"


# =============================================================================
#  2. AWS account, region and API polling
# =============================================================================

# AWS CLI profile. Used for every aws call (--profile) and passed to Packer as
# `profile`. scripts/bootstrap.sh runs `aws sso login --profile "$PROFILE"` when
# the credentials are missing or expired, so an SSO profile works as is.
# Credentials are never written into the generated user-data.
# Default: default
#PROFILE="default"

# AWS region. Required - scripts/variables.sh aborts when it is empty. Used for
# every aws call (--region), for Packer's `region`, and inside user-data to
# build the FSx NFS endpoint <fs-id>.fsx.<region>.amazonaws.com.
REGION=""   # REQUIRED

# Exported by scripts/make_ami.sh as AWS_POLL_DELAY_SECONDS / AWS_MAX_ATTEMPTS, and
# picked up by the AWS SDK that Packer uses. They bound how long Packer waits
# for AWS state changes such as "AMI available". The defaults allow roughly
# 10 s x 400 = 66 minutes, which is enough for a large image with many packages.
# Raise AWS_MAX_ATTEMPTS if a build times out while snapshotting.
#AWS_POLL_DELAY_SECONDS=10
#AWS_MAX_ATTEMPTS=400
# Number of attempts and delay (seconds) used by instance user-data while
# waiting for requested mounts and attached block devices. Provisioning fails
# without creating ~/ready when a required mount never becomes usable.
#FS_MOUNT_MAX_ATTEMPTS=60
#FS_MOUNT_RETRY_INTERVAL=2


# =============================================================================
#  3. Network and IAM
# =============================================================================

# VPC used by the Packer build instance (Packer `vpc_id`). Optional: Packer
# resolves it from the subnet when it is empty, and the only thing it needs the
# VPC for is creating a temporary security group, which it never does here
# because SECURITY_GROUP_IDS is always passed.
#
# Set it to have Packer fail early on a mismatch: it must be the VPC that owns
# SUBNET_IDS and SECURITY_GROUP_IDS.
# Default: empty, resolved from SUBNET_ID
#VPC_ID=""

# Name tag of the VPC, looked up when VPC_ID is empty.
#VPC_NAME=""

# Subnets to deploy into, comma separated. Required by scripts/setup_ec2.sh, and by
# the file system scripts when they create something. make_ami works without it:
# Packer then picks a subnet in the default VPC. More than one may be
# listed: scripts/setup_ec2.sh then writes one launch JSON per subnet per enabled
# AMI family, so an instance can be started in whichever availability zone has
# capacity, and scripts/setup_efs.sh adds a mount target in every subnet listed
# here.
#
# Two of the file system kinds restrict how many entries are allowed, and both
# checks run even when that kind is unused, because scripts/setup_ec2.sh invokes
# every setup script unconditionally:
#   * scripts/setup_io2.sh aborts on more than one subnet - an io2 volume has to be
#     created in the availability zone the instance runs in.
#   * scripts/setup_fsx.sh aborts when FSX_DEPLOYMENT_TYPE is SINGLE_AZ_* and more
#     than one subnet is given, and when it is MULTI_AZ_* and only one is.
SUBNET_IDS=""   # REQUIRED by setup_ec2

# Name tags of the subnets, comma separated, looked up when SUBNET_IDS is empty.
# The resolved order follows the order written here, so SUBNET_LABELS still
# lines up.
#SUBNET_NAMES=""

# Short label per subnet, comma separated, in the same order as SUBNET_IDS.
# Only used to name the generated launch JSON files:
#     $WORKDIR/ec2/cli_input_json/<AMI_NAME>-<label>.json
# When a label is missing, scripts/setup_ec2.sh falls back to the subnet ID with
# the "subnet-" prefix stripped, which makes for long file names. Using the
# availability-zone letter ("a", "c", "d") keeps them readable.
# Default: empty, i.e. every file name carries the subnet ID.
#SUBNET_LABELS="a,d"

# Subnet used by the Packer build instance (Packer `subnet_id`).
# Leave this commented out to use the first entry of SUBNET_IDS, which is the
# normal case. Uncomment it only when the AMI must be built in a different
# subnet from the one the instances are launched in. An empty value is *not* the
# same as leaving it out: scripts/bootstrap.sh only fills in the default when the
# variable is undefined, so SUBNET_ID="" means "let Packer choose a subnet".
#SUBNET_ID=""

# Security groups, comma separated. Optional, but you almost certainly want to
# set it. They are applied to both
#   * the Packer build instance (Packer `security_group_ids`), and
#   * the network interface in the generated launch JSON ("Groups").
# They must therefore allow whatever SSH_INTERFACE needs (inbound 22 from the
# host that runs Packer) plus the NFS/EFS/mosh traffic you expect at run time.
#
# Leaving it empty is a real downgrade, not just a default:
#   * Packer builds a throwaway security group for the build instance and
#     authorises it from `temporary_security_group_source_cidrs`, which defaults
#     to 0.0.0.0/0. Inbound SSH is open to the internet for the whole build.
#   * The launch JSON leaves "Groups" out, so instances get the VPC default
#     security group - whatever that happens to allow.
# Default: empty
#SECURITY_GROUP_IDS=""

# Security group names, comma separated, looked up when SECURITY_GROUP_IDS is
# empty. These are real group names (the EC2 GroupName attribute), not Name
# tags. Group names are unique within a VPC, so set VPC_ID as well when the same
# name exists in more than one VPC.
#SECURITY_GROUP_NAMES=""

# Name of the IAM instance profile, used both for the launched instances
# ("IamInstanceProfile" in the generated launch JSON) and for the Packer build
# instance (Packer `iam_instance_profile`). An ARN is not accepted here.
#
# Leave it empty to run without an instance profile - but the instance then
# cannot use the AWS credential chain, cannot attach io2 volumes from user-data,
# and cannot reach S3/EFS/FSx with IAM authentication.
#
# The role needs at least: ec2:DescribeInstances, ec2:AttachVolume (io2),
# elasticfilesystem client mount permissions (EFS), and whatever your own
# USER_SCRIPT_PATH hook does.
#IAM_INSTANCE_PROFILE=""

# EC2 key pair name written to "KeyName" in the generated launch JSON. Required
# for SSH access to the launched instances. Packer does not use it: it creates
# and discards a temporary key pair of its own for the build.
KEY_NAME=""   # REQUIRED by setup_ec2


# =============================================================================
#  4. AMI build - build instance access
# =============================================================================

# Default login user of the source AMI. Not used directly; it seeds the
# defaults of SSH_USERNAME and EC2_SSH_USER. "ec2-user" for Amazon Linux and the
# Deep Learning AMIs, "ubuntu" for Ubuntu images.
# Default: ec2-user
#EC2_USER="ec2-user"

# How Packer connects to the build instance (Packer `ssh_interface`):
#   private_ip       Connect to the private IP. Requires that the host running
#                    Packer can reach the VPC (VPN, Direct Connect, same VPC).
#   public_ip        Connect to the public IP. Needs a public subnet and
#                    auto-assigned public IP.
#   private_dns / public_dns
#   session_manager  Connect through SSM, no inbound rule needed. Requires an
#                    SSM-capable IAM_INSTANCE_PROFILE on the build instance.
# Default: private_ip
#SSH_INTERFACE="private_ip"

# SSH user Packer logs in as (Packer `ssh_username`), also exported to the
# provisioning scripts as $SSH_USERNAME.
# Default: value of EC2_USER
#SSH_USERNAME="${EC2_USER}"


# =============================================================================
#  5. AMI build - root volume
# =============================================================================
#  These become Packer's launch_block_device_mappings, i.e. the root volume of
#  the build instance and therefore of the resulting AMI. The generated launch
#  JSON does not override block devices, so every instance started from the AMI
#  inherits exactly this root volume.

# Root device name of the source AMI. /dev/xvda for Amazon Linux 2023,
# /dev/sda1 for most Ubuntu images. A wrong value creates a second, unused
# volume instead of resizing the root one.
# Default: /dev/xvda
#DEVICE_NAME="/dev/xvda"

# Root volume size in GiB. Must be at least the size of the source AMI's
# snapshot. The Deep Learning AMIs need considerably more than Amazon Linux, so
# GPU_VOLUME_SIZE is a common override.
# Default: 60
#VOLUME_SIZE="60"

# Root volume type: gp3, gp2, io1, io2, standard.
# Default: gp3
#VOLUME_TYPE="gp3"

# Encrypt the root volume with the account's default EBS key. "true" or "false".
# Default: true
#ENCRYPTED="true"

# Delete the root volume when the instance terminates. "true" or "false".
# Keep "true" for disposable instances; persistent data belongs on the shared
# file systems in section 8, not on the root volume.
# Default: true
#DELETE_ON_TERMINATION="true"


# =============================================================================
#  6. AMI build - provisioning
# =============================================================================
#  ec2 make_ami extracts its built-in Packer assets to $WORKDIR/packer/ and runs
#  Packer from there, so SCRIPTS paths are relative to that directory. Every
#  script runs as root ("sudo -S -E sh -eux") and receives the settings below as
#  environment variables.

# Comma-separated list of provisioning scripts, executed in this order. Add your
# own by using an absolute path and appending it here. Removing an entry simply
# skips that step.
#
#   setup_swap.sh              -> SWAP_BS, SWAP_COUNT
#   setup_shared_memory.sh     -> MULTI_PROCESSING
#   install_packages.sh        -> PACKAGES, ADDITIONAL_PACKAGES,
#                                 FLATPAK_PACKAGES
#   set_timezone.sh            -> TIME_ZONE
#   setup_idle_shutdown.sh     -> SHUTDOWN, SHUTDOWN_DURATION,
#                                 SHUTDOWN_CHECK_PROCESS
#SCRIPTS="./scripts/setup_swap.sh,./scripts/setup_shared_memory.sh,./scripts/install_packages.sh,./scripts/set_timezone.sh,./scripts/setup_idle_shutdown.sh"

# Swap file at /swapfile, created with `dd bs=$SWAP_BS count=$SWAP_COUNT`,
# activated and appended to /etc/fstab. 128M x 64 = 8 GiB. Set either one to an
# empty string to skip swap entirely. Skipped when /swapfile already exists.
# Remember that the swap file consumes VOLUME_SIZE.
# Defaults: 128M, 64
#SWAP_BS="128M"
#SWAP_COUNT="64"

# 1 runs `chmod 777 /dev/shm`, so that unprivileged multi-process workloads
# (PyTorch DataLoader workers, joblib, multiprocessing) can use shared memory.
# Any other value skips it.
# Default: 1
#MULTI_PROCESSING=1

# System time zone, applied with `timedatectl set-timezone`. Any tz database
# name, e.g. UTC, Asia/Tokyo, America/Los_Angeles. Empty skips the step.
# Default: UTC
#TIME_ZONE="UTC"

# Space-separated packages installed with dnf (falling back to yum). Applies to
# both AMI families; use CPU_ADDITIONAL_PACKAGES / GPU_ADDITIONAL_PACKAGES for
# family-specific extras.
#
# packer/scripts/install_packages.sh special-cases a few names:
#   gh                            Adds the cli.github.com yum repository first.
#   terraform                     Adds the HashiCorp repository first.
#   lazygit                       Enables copr dejan/lazygit
#                                 (amazonlinux-2023-x86_64 only).
#   google-chrome                 Downloaded and installed from the direct rpm.
#   spal, spal-release            Installs the spal-release repository package.
#
# Add "amazon-efs-utils" when you mount EFS, and "docker" when ENABLE_DOCKER=1.
# Only dnf/yum images are supported; the script exits with an error otherwise.
#PACKAGES=""

# 1 applies dnf/yum update before package installation; 0 installs against the
# package versions exposed by the selected source AMI and its configured repos.
# The final NEVRA list is always recorded in
# /var/log/ec2-environment-packages.tsv inside the built AMI.
#UPDATE_PACKAGES=1

# Space-separated Flatpak application IDs. When non-empty, flatpak is installed,
# the flathub remote is added, and these are installed from it. Leave empty to
# skip Flatpak completely.
#FLATPAK_PACKAGES=""

# Idle auto-shutdown, installed as /usr/local/sbin/shutdown_if_idle.
#   systemd   Install shutdown.service plus shutdown.timer and enable them.
#   cron      Drop a script into /etc/cron.<SHUTDOWN_DURATION>/shutdown.
#   ""        Skip the whole step; the instance never powers itself off.
# Any other value writes the helper script but schedules nothing, which is the
# same as "" in practice.
# Default: systemd
#SHUTDOWN="systemd"

# How often idleness is checked. The accepted values depend on SHUTDOWN:
#   systemd   A systemd OnCalendar= expression - hourly, daily,
#             "*:0/30" (every 30 minutes), and so on.
#   cron      A cron directory suffix - hourly, daily, weekly or monthly.
#             /etc/cron.<value>/ has to exist on the image.
# The check powers off only if the instance still looks idle after a further
# 60 s, so the worst case wasted is one interval.
# Default: hourly
#SHUTDOWN_DURATION="hourly"

# Extended-regular-expression alternation of process names that keep the
# instance alive, so that a detached session is not powered off. Matched against
# `ps -eo comm=` for processes owned by a non-root user, anchored at both ends,
# and baked into shutdown_if_idle when the AMI is built.
#
# This matters because `who` does not list detached screen/tmux sessions, mosh
# sessions, or `ssh host command` without a tty. Leave it empty to power off
# purely on `who`. Note that Linux truncates `comm` to 15 characters, so match
# on the short process name.
#SHUTDOWN_CHECK_PROCESS="sshd|screen|tmux|mosh-server"


# =============================================================================
#  7. AMI families
# =============================================================================
#  Two independent families are supported, CPU and GPU. Each one is built by
#  scripts/make_ami.sh only when <FAMILY>_INSTANCE=1, and gets its own launch JSON
#  from scripts/setup_ec2.sh. Everything in sections 4 to 6 can be overridden per
#  family with a CPU_ / GPU_ prefix.

# --- CPU family --------------------------------------------------------------

# 1 builds this AMI and generates its launch JSONs; 0 skips the family entirely.
# Default: 1
#CPU_INSTANCE=1

# Required while CPU_INSTANCE is 1.
# Name of the AMI to build, and the name scripts/setup_ec2.sh looks up with
# `describe-images --owners self` to find the image ID (the newest match by
# creation date wins, and the result is cached in $WORKDIR/ami_ids).
# Because Packer refuses to overwrite an existing AMI name, include VERSION and
# bump it for every rebuild.
CPU_AMI_NAME="${PREFIX}-cpu-${VERSION}"

# Source AMI name filter. Wildcards are allowed. The generator resolves the
# newest match to one exact AMI ID before invoking Packer and records that ID in
# build-inputs-cpu.json.
#CPU_AMI_FILTER="al2023-ami-*-x86_64" # Amazon Linux 2023

# Owner of the source AMI: "amazon", "self", or an account ID.
#CPU_AMI_OWNER="amazon"

# Optional exact source AMI. When set, this takes precedence over the filter and
# makes repeated builds independent of newly published upstream images.
#CPU_SOURCE_AMI_ID=""

# Instance type used to build the AMI, and the InstanceType written into this
# family's launch JSON. It must match the architecture of CPU_AMI_FILTER
# (x86_64 vs arm64). A larger type shortens the build but costs more per hour.
#CPU_INSTANCE_TYPE="c8i.2xlarge"

# Space-separated packages appended to PACKAGES for this family only.
#CPU_ADDITIONAL_PACKAGES=""

# --- GPU family --------------------------------------------------------------

# 1 builds this AMI and generates its launch JSONs; 0 skips the family entirely.
# Default: 1
#GPU_INSTANCE=0

# Required once GPU_INSTANCE is 1 - uncomment it together with GPU_INSTANCE.
#GPU_AMI_NAME="${PREFIX}-gpu-${VERSION}"

# The Deep Learning AMI names end with a release date, hence the trailing
# wildcard. The newest match is resolved once before Packer starts.
#GPU_AMI_FILTER="Deep Learning OSS Nvidia Driver AMI GPU PyTorch * (Amazon Linux 2023)*"

#GPU_AMI_OWNER="amazon"

#GPU_SOURCE_AMI_ID=""

# Must be a GPU type, otherwise the NVIDIA driver in the source AMI has no
# device to bind to.
#GPU_INSTANCE_TYPE="g4dn.xlarge"

# Space-separated packages appended to PACKAGES for this family only. Useful for
# resolving conflicts with what the Deep Learning AMI already ships, for example
# putting openssl-devel in CPU_ADDITIONAL_PACKAGES because the GPU image already
# has openssl11-devel.
#GPU_ADDITIONAL_PACKAGES=""


# =============================================================================
#  8. Shared file systems
# =============================================================================
#  Four kinds of storage can be attached, and each one follows the same pattern:
#
#    <KIND>_IDS           Existing resource IDs, comma separated. Used as is.
#    <KIND>_NAMES         Names to look up when <KIND>_IDS is empty. Resolved
#                         IDs replace it.
#    <KIND>_MOUNT_POINTS  Mount point per resolved ID, in the same order. The
#                         number of entries must match IDS, or NAMES when IDs
#                         are resolved.
#
#  Leave both IDS and NAMES empty to skip a kind completely. Each name is
#  resolved independently, preserving input order. Missing EFS / FSx / io2
#  names are created from the remaining settings if CREATE_FILE_SYSTEMS=1; if
#  it is 0, all missing names are reported before the run aborts. Resolution and
#  creation happen in scripts/setup_ec2.sh, which calls scripts/setup_s3files.sh,
#  setup_efs, setup_fsx and setup_io2 in that order.
#
#  The resulting mounts are written into the generated user-data as /etc/fstab
#  entries followed by `mount -a`, all with `nofail`, so a broken mount does not
#  prevent the instance from booting - check `mount` after login.

# 1 allows scripts/setup_ec2.sh to create missing EFS / FSx / io2 resources.
# 0 (recommended for day-to-day use) makes it fail instead, so a typo in a name
# cannot silently bill you for a new file system. Creation is a one-off step:
# set it to 1 once, then put it back to 0.
# Default: 0
#CREATE_FILE_SYSTEMS=0

# Print the missing-resource creation plan without creating anything. This is
# useful with CREATE_FILE_SYSTEMS=1 before an apply run; generated launch files
# omit IDs for resources that only appeared in the dry-run plan.
#RESOURCE_DRY_RUN=0

# Every created AMI, EFS, FSx, and io2 resource receives ManagedBy plus the
# non-empty metadata tags below. Exact created IDs are appended to the manifest,
# which scripts/cleanup_resources.sh consumes in dry-run mode by default.
#RESOURCE_MANAGED_BY="ec2-environment"
#RESOURCE_PROJECT=""
#RESOURCE_OWNER=""
# ISO-8601 is recommended, for example 2026-12-31T00:00:00Z.
#RESOURCE_EXPIRES_AT=""
#RESOURCE_MANIFEST="my_work/resources.tsv"

# --- S3-backed file systems (aws s3files) ------------------------------------
#  Mounted as: <id>:/  on  <mount point>  type s3files  (_netdev,nofail)
#  These are never created by this toolkit: names are looked up with
#  `aws s3files list-file-systems`, and the run fails when a name cannot be
#  resolved. Requires an AWS CLI that provides the `s3files` command and an
#  instance able to authenticate to it.
#S3FILES_IDS=""
#S3FILES_NAMES=""
#S3FILES_MOUNT_POINTS="/mnt/s3files"

# --- EFS ---------------------------------------------------------------------
#  Mounted as: <id>:/  on  <mount point>  type efs
#              (_netdev,tls,noresvport,nofail)
#  The efs type and the tls option come from amazon-efs-utils, so keep
#  "amazon-efs-utils" in PACKAGES.
#EFS_IDS=""

# Looked up by the Name tag. When creation is enabled, a new file system is
# created with --backup --encrypted, tagged with this name, and a mount target
# is added in every subnet of SUBNET_IDS.
#EFS_NAMES=""

#EFS_MOUNT_POINTS="/mnt/efs"

# Security groups for the EFS mount targets, one per name (a single value is
# applied to all). Required only when EFS is created here. It must allow inbound
# NFS (2049) from SECURITY_GROUP_IDS.
#EFS_SECURITY_GROUP_IDS=""

# Group names, looked up when EFS_SECURITY_GROUP_IDS is empty.
#EFS_SECURITY_GROUP_NAMES=""

# One per name, or a single value for all.
#   generalPurpose  Lowest latency. The right choice for interactive work.
#   maxIO           Higher throughput, higher latency, for massively parallel
#                   access.
# Default: generalPurpose
#EFS_PERFORMANCE_MODES="generalPurpose"

# One per name, or a single value for all: bursting, elastic, provisioned.
# "elastic" costs more per GB but removes the burst-credit cliff.
# Default: bursting
#EFS_THROUGHPUT_MODES="bursting"

# --- FSx for OpenZFS ---------------------------------------------------------
#  Mounted as: <id>.fsx.<REGION>.amazonaws.com:/fsx/  on  <mount point>
#              type nfs4 (noatime,nfsvers=4.2,nconnect=16,_netdev,nofail)
#  Much faster than EFS for many small files, which makes it a good home for
#  FS_DIR below.
#FSX_IDS=""

# Looked up by the Name tag.
#FSX_NAMES=""

#FSX_MOUNT_POINTS="/mnt/fsx"

# Security groups for the file system, one per name or a single value for all.
# Required only when FSx is created here. Must allow inbound NFS (2049) plus the
# OpenZFS RPC ports from SECURITY_GROUP_IDS.
#FSX_SECURITY_GROUP_IDS=""

# Group names, looked up when FSX_SECURITY_GROUP_IDS is empty.
#FSX_SECURITY_GROUP_NAMES=""

# SINGLE_AZ_1, SINGLE_AZ_2, MULTI_AZ_1. SINGLE_AZ_* requires exactly one entry
# in SUBNET_IDS; MULTI_AZ_* requires at least two. The first subnet becomes
# PreferredSubnetId.
# Default: SINGLE_AZ_1
#FSX_DEPLOYMENT_TYPE="SINGLE_AZ_1"

# SSD or INTELLIGENT_TIERING. FSX_STORAGE_CAPACITIES is only sent for SSD;
# INTELLIGENT_TIERING sizes itself.
# Default: SSD
#FSX_STORAGE_TYPES="SSD"

# Size in GiB per name, or a single value for all. SSD accepts 64 to 524288.
# Default: 100
#FSX_STORAGE_CAPACITIES="100"

# Throughput in MB/s per name, or a single value for all. Must be an integer
# from the values the deployment type allows (64, 128, 256, 512, 1024, ...).
# Default: 160
#FSX_THROUGHPUT_CAPACITIES="160"

# Daily automatic backup retention in days, per name or a single value for all.
# Must be an integer; 0 disables automatic backups.
# Default: 30
#FSX_AUTOMATIC_BACKUP_RETENTION_DAYS="30"

# Route tables that get the FSx routes, per name or a single value for all.
# Only used for MULTI_AZ_* deployments, and ignored otherwise.
#FSX_ROUTE_TABLE_IDS=""

# Name tags of the route tables, looked up when FSX_ROUTE_TABLE_IDS is empty.
#FSX_ROUTE_TABLE_NAMES=""

# --- io2 EBS volumes ---------------------------------------------------------
#  Not a shared file system: one volume is attached to one instance at a time.
#  At boot, user-data runs `aws ec2 attach-volume` - so the instance profile
#  needs ec2:AttachVolume - then waits up to 60 s for the device to appear by
#  matching the volume ID against the disk serial, runs mkfs when the disk has
#  no file system yet, mounts it, and adds a UUID-based /etc/fstab entry.
#
#  Requires exactly one entry in SUBNET_IDS, because the volume must be created
#  in the same availability zone as the instance. scripts/setup_io2.sh enforces
#  this even when io2 is unused.
#IO2_IDS=""

# Name tag for volumes to create. Leave empty unless you are creating volumes.
#IO2_NAMES=""

#IO2_MOUNT_POINTS="/mnt/io2"

# Size in GiB per name, or a single value for all.
# Default: 100
#IO2_SIZES="100"

# Provisioned IOPS per name, or a single value for all. io2 allows 100 to 64000,
# capped at 500 IOPS per GiB.
# Default: 3000
#IO2_IOPSS="3000"

# Requested device name per volume, or a single value for all. Nitro instances
# rename it to /dev/nvme*, which is why the mount step resolves the real path
# from the volume serial instead of trusting this value.
# Default: /dev/sdf
#IO2_DEVICES="/dev/sdf"

# File system created on a blank volume, per volume or a single value for all:
# xfs, ext4. Existing file systems are detected with blkid and left alone.
# Default: xfs
#IO2_FSTYPES="xfs"


# =============================================================================
#  9. Launch JSON and the `ec2` command
# =============================================================================
#  scripts/setup_ec2.sh writes one --cli-input-json file per subnet and enabled
#  family to $WORKDIR/ec2/cli_input_json/<AMI_NAME>-<label>.json, holding
#  ImageId, InstanceType, KeyName, EbsOptimized, IamInstanceProfile and a single
#  network interface. Everything else below is copied into $WORKDIR/ec2/config,
#  which the external `ec2` command reads. That config (minus ssh_key) and the
#  launch JSONs are installed on the instance under ~/.config/ec2/ as well, so
#  an instance can launch further instances.

# Substring the `ec2` command uses to find *your* instances by Name tag. Keep it
# narrow enough that you never operate on someone else's instance.
EC2_NAME_FILTER="${PREFIX}"

# Substring the `ec2` command uses to list *your* AMIs.
EC2_IMAGE_NAME_FILTER="${PREFIX}"

# Optional local path to the private key matching KEY_NAME, typically
# ~/.ssh/<KEY_NAME>.pem. When empty, ssh/scp/mosh/et use the usual OpenSSH
# identity selection, including ssh-agent and ~/.ssh/config. The ec2 command
# normally connects by IP address, so any Host rule must match that address or
# pattern.
# This value is written to $WORKDIR/ec2/config only, never into user-data or the
# config installed on the instance.
#EC2_SSH_KEY=""

# Additional SSH arguments copied to the generated ec2 config. Each array
# element is preserved as one argument for ssh/scp and rsync's SSH transport,
# and converted to Eternal Terminal's --ssh-option form for `ec2 et`. ET
# forwarding supports -o VALUE and -i KEY; use EC2_ET_OPTIONS or ~/.ssh/config
# for other ET-specific needs.
#EC2_SSH_OPTIONS=()

# Native Eternal Terminal client arguments, for example (--keepalive 30) or
# (--port 2022). Do not include the destination host.
#EC2_ET_OPTIONS=()

# Native scp arguments. Recursive copies are enabled by default; use () to
# disable that default, or add -p to preserve modification times. SSH connection
# arguments still belong in EC2_SSH_OPTIONS.
#EC2_SCP_OPTIONS=(-r)

# Native rsync arguments. The default archive mode supports recursive directory
# synchronization while preserving metadata. Do not set -e/--rsh here; ec2
# constructs it from EC2_SSH_OPTIONS and EC2_SSH_KEY.
#EC2_RSYNC_OPTIONS=(-a)

# Login user on the launched instances. Also the user whose home directory the
# generated user-data sets up: dotfiles, ~/.aws, ~/.ssh, ~/.config/ec2,
# ~/ready.
# Default: value of EC2_USER
#EC2_SSH_USER="${EC2_USER}"

# "AssociatePublicIpAddress" in the launch JSON. Must be the literal true or
# false - scripts/setup_ec2.sh rejects anything else. Set true only for public
# subnets; combine with EC2_PRIVATE_IP=0 to actually connect over it.
#EC2_PUBLIC_IP=false

# Tells the `ec2` command to connect to the private address. 1 or 0. Note the
# different value style from EC2_PUBLIC_IP: this one is a flag for the `ec2`
# command, not a field in the launch JSON.
# Default: 1
#EC2_PRIVATE_IP=1

# Default instance type for the `ec2` command when it is not taking the type
# from a launch JSON. Handy for a small "just give me a shell" instance that is
# cheaper than CPU_INSTANCE_TYPE.
#EC2_INSTANCE_TYPE="t3.medium"

# Request spot instances. 1 or 0. Much cheaper, but the instance can be
# reclaimed at any time, so pair it with the retry settings below and keep your
# state on the shared file systems.
# Default: 0
#EC2_SPOT_INSTANCE=0

# Enable the `ec2` command's submit mode, which launches an instance, runs a
# command over SSH and shuts down afterwards. 1 or 0.
# Default: 1
#EC2_SUBMIT_COMMAND=1

# Submit-mode retries. The launch pair covers "no capacity" and spot rejections,
# the ssh pair covers the window between "running" and "sshd is accepting
# connections". Intervals are in seconds, so the defaults wait up to
# 120 x 60 s = 2 hours for capacity and 10 x 10 s = 100 s for SSH.
#EC2_SUBMIT_N_RETRY_LAUNCH=120
#EC2_SUBMIT_RETRY_LAUNCH_INTERVAL=60
#EC2_SUBMIT_N_RETRY_SSH=10
#EC2_SUBMIT_RETRY_SSH_INTERVAL=10

# Which generated group of launch JSONs the `ec2` command uses by default:
# "cpu" or "gpu". The groups themselves are filled in automatically from the
# enabled families.
# Default: cpu
#EC2_CLI_INPUT_JSON_GROUP="cpu"

# Path to mosh-server on the instance, passed to the `ec2` command. Point it at
# the distribution package (/usr/bin/mosh-server, needs "mosh" in PACKAGES) or
# at a copy on a shared file system, for example
# "${FS_DIR}/usr/bin/mosh-server" when you install mosh through FS_OPT_SCRIPTS.
# Default: /usr/bin/mosh-server
#EC2_MOSH_SERVER="/usr/bin/mosh-server"

# URI of the generated cloud-init user-data, as the `ec2` command expects it.
# scripts/setup_ec2.sh also derives the local output path from this value: it
# strips the scheme, and a ".gz" suffix additionally triggers gzip of the
# generated script - which is what makes it fit in the 16 KB user-data limit.
# Use "fileb://" for the compressed form and "file://" for plain text.
# Default: fileb://$WORKDIR/ec2/user_data.sh.gz (made absolute automatically)
#EC2_USER_DATA="fileb://${WORKDIR}/ec2/user_data.sh.gz"


# =============================================================================
#  10. On-instance setup (generated user-data)
# =============================================================================
#  Everything below is rendered into $WORKDIR/ec2/user_data.sh and runs as root
#  through cloud-init on first boot, in this order: mounts (section 8), docker,
#  FS_DIR, FS_OPT_SCRIPTS, dotfiles, ~/.config/ec2, ~/.aws, ~/.ssh, and finally
#  your own USER_SCRIPT_PATH. The script ends by copying
#  /var/log/cloud-init-output.log to ~/ready, which is the marker to poll for
#  when you want to know that setup has finished.
#
#  SECURITY: user-data is readable by anyone who can reach the instance metadata
#  service on the instance, and a copy is left in the home directory. Never put
#  access keys, API keys or private keys in any of these settings. Use
#  IAM_INSTANCE_PROFILE and the AWS credential chain instead.

# 1 runs `systemctl enable --now docker` and adds EC2_SSH_USER to the docker
# group. Requires "docker" in PACKAGES. 0 skips it.
# Default: 0
#ENABLE_DOCKER=0

# Directory on a shared file system that holds the things you want to survive
# instance termination: locally built tools and your dotfiles. Normally one of
# the mount points from section 8, for example "/mnt/fsx/fs2".
#
# Leave empty to disable FS_USR, FS_OPT_SCRIPTS and all FS_DOTFILES_* handling -
# they all live under this directory. setup_ec2 warns about the enabled settings
# it ignores, then continues generating the remaining configuration.
#FS_DIR=""

# 1 creates $FS_DIR/usr/bin and symlinks it as ~/usr, so that software you build
# with --prefix=$HOME/usr persists across instances. Requires FS_DIR.
# Default: 1
#FS_USR=1

# Comma-separated local installer scripts to copy onto the shared file system
# and run once per boot. Requires FS_DIR. For each entry:
#
#   * The file name must be install_<name> with no extension, because <NAME>_OPT
#     is derived from it by uppercasing; a dot would produce an invalid variable
#     name.
#   * You must also define <NAME>_OPT in this config, even if empty - it is
#     expanded without a default.
#   * The script is copied to $FS_DIR/opt/bin/install_<name>, made executable,
#     and run as EC2_SSH_USER with three arguments:
#         "$FS_DIR/opt"  "$FS_DIR/usr"  $<NAME>_OPT
#     so it should install into argument 2 and build in argument 1.
#
# Example:
#   FS_OPT_SCRIPTS="./my_work/install_mosh,./my_work/install_neovim"
#   MOSH_OPT="1.4.0"
#   NEOVIM_OPT="v0.10.2"
#FS_OPT_SCRIPTS=""

# Dotfiles kept on the shared file system. Each entry is created under
# $FS_DIR/dotfiles/ (touch for files, mkdir -p for directories) and symlinked
# into the home directory, replacing whatever was there unless it is already a
# symlink. Requires FS_DIR.
#
# Use this for state you want to keep - .bash_history, caches, tool state - not
# for files that belong in such an own dotfiles.
# Example:
#    FS_DOTFILES_FILE=".bash_history"
#    FS_DOTFILES_DIR=".cache,.local"
#FS_DOTFILES_FILE=""
#FS_DOTFILES_DIR=""

# Same, but relative to ~/.config/ instead of the home directory.
#FS_DOTFILES_CONFIG_FILE=""
#FS_DOTFILES_CONFIG_DIR=""

# Literal contents of ~/.aws/config on the instance, written with `echo -e`, so
# use a real multi-line string. Profiles only - no credentials.
# Example:
#   AWS_CONFIG="[profile reader]
#   role_arn = arn:aws:iam::123456789012:role/some-reader
#   credential_source = Ec2InstanceMetadata"
#AWS_CONFIG=""

# Local files whose contents are copied to ~/.ssh/known_hosts, ~/.ssh/config and
# ~/.ssh/rc on the instance (mode 600, ~/.ssh is 700). A missing file is skipped
# silently. ~/.ssh/rc runs on every incoming SSH connection, which makes it a
# convenient place for per-session environment setup - and a bad place for
# anything slow. Do not point any of these at a private key.
#SSH_KNOWN_HOSTS=""
#SSH_CONFIG=""
#SSH_RC=""

# Local shell script appended verbatim to the end of the generated user-data, so
# it runs as root after everything above. This is the hook for site-specific
# setup: cloning repositories, installing language runtimes, registering
# monitoring agents. Review it before every launch - it ends up inside the
# instance metadata. A missing file is skipped silently.
#USER_SCRIPT_PATH=""
__EC2_ASSET_config_example__
  chmod 600 "$root/config.example"
  mkdir -p "$(dirname "$root/scripts/bootstrap.sh")"
  cat >"$root/scripts/bootstrap.sh" <<'__EC2_ASSET_scripts_bootstrap_sh__'
#!/usr/bin/env bash
# shellcheck disable=SC1090,SC1091
set -euo pipefail

if ! type aws >/dev/null 2>&1; then
  echo "AWS CLI is not installed. Please install AWS CLI to continue." >&2
  exit 1
fi

requested_workdir=${1:-${WORKDIR:-my_work}}
requested_config=${2:-${CONFIG:-./config}}
WORKDIR=$requested_workdir
CONFIG=$requested_config
export WORKDIR CONFIG

if [[ ! -f "$CONFIG" ]]; then
  echo "Environment configuration file not found: $CONFIG" >&2
  echo "When using ec2, run 'ec2 init_environment' and edit the created environment file first." >&2
  exit 1
fi
source "$CONFIG"
WORKDIR=$requested_workdir
CONFIG=$requested_config
export WORKDIR CONFIG
unset requested_workdir requested_config
source "$(dirname "$0")/variables.sh"
source "$(dirname "$0")/common.sh"
mkdir -p "$WORKDIR"

ensure_aws_session() {
  if aws "${AWS_ARGS[@]}" sts get-caller-identity >/dev/null 2>&1; then
    return 0
  fi

  aws sso login --profile "$PROFILE" || true
  if ! aws "${AWS_ARGS[@]}" sts get-caller-identity >/dev/null 2>&1; then
    echo "AWS authentication failed for profile '$PROFILE' in region '$REGION'" >&2
    echo "Please login using 'aws sso login --profile $PROFILE' or check your AWS credentials." >&2
    return 1
  fi
}

ensure_aws_session || exit 1

# Names have to be resolved after the credentials are checked, because every one
# of these costs a describe call. Setting the <X>_IDS form skips the lookup.
resolve_ids VPC_ID VPC_NAME 'ec2 describe-vpcs' tag:Name 'Vpcs[].VpcId'
resolve_ids SUBNET_IDS SUBNET_NAMES 'ec2 describe-subnets' tag:Name 'Subnets[].SubnetId'
# Security group names are unique per VPC, so scope the lookup when we know it.
security_group_filters=()
[[ -n "$VPC_ID" ]] && security_group_filters=("Name=vpc-id,Values=$VPC_ID")
for prefix in '' EFS_ FSX_; do
  resolve_ids "${prefix}SECURITY_GROUP_IDS" "${prefix}SECURITY_GROUP_NAMES" \
    'ec2 describe-security-groups' group-name 'SecurityGroups[].GroupId' \
    ${security_group_filters[@]+"${security_group_filters[@]}"}
done
unset prefix security_group_filters
resolve_ids FSX_ROUTE_TABLE_IDS FSX_ROUTE_TABLE_NAMES 'ec2 describe-route-tables' \
  tag:Name 'RouteTables[].RouteTableId'
# Derived here rather than in scripts/variables.sh, which runs before SUBNET_NAMES
# can be resolved. Unset means "use the first subnet"; an explicit empty value
# means "let Packer choose", so this must not use the :- form.
SUBNET_ID=${SUBNET_ID-${SUBNET_IDS%%,*}}
__EC2_ASSET_scripts_bootstrap_sh__
  chmod 755 "$root/scripts/bootstrap.sh"
  mkdir -p "$(dirname "$root/scripts/cleanup_resources.sh")"
  cat >"$root/scripts/cleanup_resources.sh" <<'__EC2_ASSET_scripts_cleanup_resources_sh__'
#!/usr/bin/env bash
set -euo pipefail

execute=0
manifest_override=''
workdir=${WORKDIR:-my_work}
config=${CONFIG:-./config}
while (($# > 0));do
  case $1 in
    --execute) execute=1 ;;
    --manifest) manifest_override=${2:?--manifest requires a path}; shift ;;
    --workdir) workdir=${2:?--workdir requires a path}; shift ;;
    --config) config=${2:?--config requires a path}; shift ;;
    --help)
      echo 'Usage: scripts/cleanup_resources.sh [--manifest PATH] [--workdir DIR] [--config FILE] [--execute]'
      echo 'Without --execute, only the exact-ID deletion plan is printed.'
      exit 0
      ;;
    *) echo "Unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
# shellcheck disable=SC1091
source "$script_dir/bootstrap.sh" "$workdir" "$config"
manifest=${manifest_override:-$RESOURCE_MANIFEST}
[[ -f "$manifest" ]] || { echo "Resource manifest not found: $manifest" >&2; exit 1; }

managed_tag() {
  local type=$1 id=$2
  case $type in
    ami)
      aws "${AWS_ARGS[@]}" ec2 describe-images --image-ids "$id" \
        --query "Images[0].Tags[?Key=='ManagedBy'].Value | [0]" --output text
      ;;
    efs)
      aws "${AWS_ARGS[@]}" efs describe-file-systems --file-system-id "$id" \
        --query "FileSystems[0].Tags[?Key=='ManagedBy'].Value | [0]" --output text
      ;;
    fsx)
      aws "${AWS_ARGS[@]}" fsx describe-file-systems --file-system-ids "$id" \
        --query "FileSystems[0].Tags[?Key=='ManagedBy'].Value | [0]" --output text
      ;;
    io2)
      aws "${AWS_ARGS[@]}" ec2 describe-volumes --volume-ids "$id" \
        --query "Volumes[0].Tags[?Key=='ManagedBy'].Value | [0]" --output text
      ;;
    *) return 2 ;;
  esac
}

verify_managed_resource() {
  local type=$1 id=$2 actual
  actual=$(managed_tag "$type" "$id") || return 1
  [[ "$actual" == "$RESOURCE_MANAGED_BY" ]] || {
    echo "Refusing to delete $type $id: ManagedBy is '$actual', expected '$RESOURCE_MANAGED_BY'." >&2
    return 1
  }
}

delete_efs() {
  local id=$1 target remaining attempt
  local -a targets
  mapfile -t targets < <(aws "${AWS_ARGS[@]}" efs describe-mount-targets --file-system-id "$id" \
    --query 'MountTargets[].MountTargetId' --output text | tr '\t' '\n' | awk 'NF && $0 != "None"')
  for target in "${targets[@]}";do
    aws "${AWS_ARGS[@]}" efs delete-mount-target --mount-target-id "$target"
  done
  for ((attempt=1; attempt<=AWS_MAX_ATTEMPTS; attempt++));do
    remaining=$(aws "${AWS_ARGS[@]}" efs describe-mount-targets --file-system-id "$id" \
      --query 'length(MountTargets)' --output text)
    [[ "$remaining" == 0 ]] && break
    ((attempt == AWS_MAX_ATTEMPTS)) || sleep "$AWS_POLL_DELAY_SECONDS"
  done
  [[ "$remaining" == 0 ]] || { echo "Timed out deleting mount targets for $id." >&2; return 1; }
  aws "${AWS_ARGS[@]}" efs delete-file-system --file-system-id "$id"
}

delete_resource() {
  local type=$1 id=$2
  verify_managed_resource "$type" "$id" || return 1
  case $type in
    ami) aws "${AWS_ARGS[@]}" ec2 deregister-image --image-id "$id" ;;
    efs) delete_efs "$id" ;;
    fsx) aws "${AWS_ARGS[@]}" fsx delete-file-system --file-system-id "$id" --open-zfs-configuration SkipFinalBackup=true ;;
    io2) aws "${AWS_ARGS[@]}" ec2 delete-volume --volume-id "$id" ;;
    *) echo "Unsupported manifest resource type: $type" >&2; return 1 ;;
  esac
}

echo "Resource cleanup plan from $manifest:"
while IFS=$'\t' read -r type id name created_at;do
  [[ "$type" == type || -z "$type" ]] && continue
  printf '  delete %-4s id=%s name=%s created=%s\n' "$type" "$id" "$name" "$created_at"
done < "$manifest"
if [[ "$execute" != 1 ]];then
  echo 'Dry run only. Re-run with --execute to verify ManagedBy tags and delete these exact IDs.'
  exit 0
fi

remaining_manifest=$(mktemp "${manifest}.remaining.XXXXXX")
trap 'rm -f "$remaining_manifest"' EXIT
printf 'type\tid\tname\tcreated_at\n' > "$remaining_manifest"
failed=0
while IFS=$'\t' read -r type id name created_at;do
  [[ "$type" == type || -z "$type" ]] && continue
  if delete_resource "$type" "$id";then
    echo "Deleted $type $id."
  else
    printf '%s\t%s\t%s\t%s\n' "$type" "$id" "$name" "$created_at" >> "$remaining_manifest"
    failed=1
  fi
done < "$manifest"
mv "$remaining_manifest" "$manifest"
trap - EXIT
exit "$failed"
__EC2_ASSET_scripts_cleanup_resources_sh__
  chmod 755 "$root/scripts/cleanup_resources.sh"
  mkdir -p "$(dirname "$root/scripts/common.sh")"
  cat >"$root/scripts/common.sh" <<'__EC2_ASSET_scripts_common_sh__'
#!/usr/bin/env bash
set -euo pipefail

# Fill <IDS_VAR> by looking each entry of <NAMES_VAR> up through an aws describe
# call. Does nothing when <IDS_VAR> already has a value, so an explicit ID always
# wins. A name that matches nothing, or more than one resource, is an error:
# names are not unique in AWS and silently picking one is how you end up
# attached to the wrong network.
#
#   resolve_ids IDS_VAR NAMES_VAR "<service> <operation>" <filter> <query> [extra filter ...]
resolve_ids() {
  local ids_var=$1 names_var=$2 operation=$3 filter=$4 query=$5
  shift 5
  local ids=${!ids_var-} names=${!names_var-} name resolved=''
  local cache_var="RESOLVED_${ids_var}" cache_key_var="RESOLVED_${ids_var}_FROM"
  local -a operation_args extra_filters=("$@") matches name_list
  [[ -n "$ids" || -z "$names" ]] && return 0
  # setup_ec2 runs setup_efs, setup_fsx and setup_io2 as child processes, and
  # each of them sources the config again, which resets <X>_IDS. Caching the
  # answer under a name the config never writes keeps the lookup to one call per
  # run instead of one per script.
  # Keyed on the names it was resolved from, so a value left over from another
  # config or an earlier run with different names is never reused.
  if [[ -n "${!cache_var-}" && "${!cache_key_var-}" == "$names" ]]; then
    printf -v "$ids_var" '%s' "${!cache_var}"
    return 0
  fi
  read -r -a operation_args <<<"$operation"
  # Quoted, because a Name tag or a security group name may contain spaces.
  mapfile -t name_list < <(csv_items "$names")
  for name in "${name_list[@]}"; do
    [[ -n "$name" ]] || continue
    mapfile -t matches < <(aws "${AWS_ARGS[@]}" "${operation_args[@]}" \
      --filters "Name=$filter,Values=$name" ${extra_filters[@]+"${extra_filters[@]}"} \
      --query "$query" --output text | tr '\t' '\n' | awk 'NF && $0 != "None"')
    case ${#matches[@]} in
      0)
        echo "$names_var: nothing matches '$name'" >&2
        return 1
        ;;
      1)
        resolved="${resolved:+$resolved,}${matches[0]}"
        ;;
      *)
        echo "$names_var: '$name' matches ${#matches[@]} resources: ${matches[*]}" >&2
        echo "Names are not unique in AWS. Set $ids_var to pick one." >&2
        return 1
        ;;
    esac
  done
  printf -v "$ids_var" '%s' "$resolved"
  printf -v "$cache_var" '%s' "$resolved"
  printf -v "$cache_key_var" '%s' "$names"
  # shellcheck disable=SC2163  # exporting the name each variable holds is the point
  export "$cache_var" "$cache_key_var"
}

csv_items() {
  local value=${1:-} n=${2:-} values
  if [[ -z "$value" ]]; then
    return
  fi
  values=$(tr ',' '\n' <<<"$value")
  if [[ -z "$n" ]]; then
    echo "$values"
    return
  fi
  # values to aaray
  mapfile -t values <<<"$values"
  echo "${values[$n]:-}"
}

json_quote() {
  local value=${1:-}
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/\\r}
  value=${value//$'\t'/\\t}
  printf '"%s"' "$value"
}

json_array_from_csv() {
  local value=${1:-} item result=''
  IFS=, read -r -a items <<<"$value"
  for item in "${items[@]}"; do
    [[ -n "$item" ]] || continue
    result+="${result:+,}$(json_quote "$item")"
  done
  printf '[%s]' "$result"
}

sha256_string() {
  local value=${1-}
  if command -v sha256sum >/dev/null 2>&1;then
    printf '%s' "$value" | sha256sum | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1;then
    printf '%s' "$value" | shasum -a 256 | awk '{print $1}'
  else
    echo 'A SHA-256 utility (sha256sum or shasum) is required.' >&2
    return 1
  fi
}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1;then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1;then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    echo 'A SHA-256 utility (sha256sum or shasum) is required.' >&2
    return 1
  fi
}

efs_creation_token() {
  local name=$1 prefix digest
  digest=$(sha256_string "$name") || return 1
  prefix=${name//[^a-zA-Z0-9._-]/-}
  [[ "$prefix" =~ [a-zA-Z0-9] ]] || prefix=efs
  prefix=${prefix:0:39}
  printf 'ec2env-%s-%s' "$prefix" "${digest:0:16}"
}

shell_assignment() {
  local name=$1 value=${2-}
  printf '%s=' "$name"
  printf '%q\n' "$value"
}

shell_array_assignment() {
  local name=$1 value
  shift
  printf '%s=(' "$name"
  for value in "$@";do
    printf ' %q' "$value"
  done
  (($# == 0)) || printf ' '
  printf ')\n'
}

base64_string() {
  printf '%s' "${1-}" | base64 | tr -d '\n'
}

base64_file() {
  base64 < "$1" | tr -d '\n'
}

validate_resource_metadata() {
  local name value
  for name in RESOURCE_MANAGED_BY RESOURCE_PROJECT RESOURCE_OWNER RESOURCE_EXPIRES_AT;do
    value=${!name-}
    [[ "$value" != *$'\n'* && "$value" != *$'\t'* ]] || {
      echo "$name must not contain tabs or newlines." >&2
      return 1
    }
  done
  [[ -n "${RESOURCE_MANAGED_BY:-ec2-environment}" ]] || {
    echo 'RESOURCE_MANAGED_BY must not be empty.' >&2
    return 1
  }
}

resource_tags_json() {
  local resource_name=$1 result
  validate_resource_metadata || return 1
  result=$(printf '{"Key":"Name","Value":%s},{"Key":"ManagedBy","Value":%s}' \
    "$(json_quote "$resource_name")" "$(json_quote "$RESOURCE_MANAGED_BY")")
  [[ -z "$RESOURCE_PROJECT" ]] || result+=",$(printf '{"Key":"Project","Value":%s}' "$(json_quote "$RESOURCE_PROJECT")")"
  [[ -z "$RESOURCE_OWNER" ]] || result+=",$(printf '{"Key":"Owner","Value":%s}' "$(json_quote "$RESOURCE_OWNER")")"
  [[ -z "$RESOURCE_EXPIRES_AT" ]] || result+=",$(printf '{"Key":"ExpiresAt","Value":%s}' "$(json_quote "$RESOURCE_EXPIRES_AT")")"
  printf '[%s]' "$result"
}

record_resource() {
  local type=$1 id=$2 name=$3 created_at manifest_dir
  [[ "$type$id$name" != *$'\n'* && "$type$id$name" != *$'\t'* ]] || {
    echo 'Resource manifest fields must not contain tabs or newlines.' >&2
    return 1
  }
  manifest_dir=$(dirname "$RESOURCE_MANIFEST")
  mkdir -p "$manifest_dir"
  if [[ ! -f "$RESOURCE_MANIFEST" ]];then
    printf 'type\tid\tname\tcreated_at\n' > "$RESOURCE_MANIFEST"
  fi
  if ! awk -F '\t' -v type="$type" -v id="$id" '$1 == type && $2 == id { found=1 } END { exit !found }' "$RESOURCE_MANIFEST";then
    created_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    printf '%s\t%s\t%s\t%s\n' "$type" "$id" "$name" "$created_at" >> "$RESOURCE_MANIFEST"
  fi
}
subnet_az() {
  local subnet_id=$1
  aws "${AWS_ARGS[@]}" ec2 describe-subnets --subnet-ids "$subnet_id" \
    --query 'Subnets[0].AvailabilityZone' --output text
}

make_array() {
  local length=$1 var=$2 default=${3:-}
  n_var=$(tr ',' '\n' <<<"$var" | wc -l | tr -d ' ')
  if [[ "$n_var" -eq "$length" ]]; then
    echo "$var"
    return
  fi
  if [[ "$n_var" -eq 1 ]];then
    default=$var
  elif [[ "$n_var" -gt 1 ]];then
    echo "Cannot make array of length $length from $var" >&2
    return 1
  fi
  local result=''
  for ((i=0; i<length; i++)); do
    result+="${result:+,}$default"
  done
  echo "$result"
}

compare_length() {
  local var1_name=$1 var2_name=$2 var1 var2
  var1=${!var1_name} var2=${!var2_name}
  n_1=$(tr ',' '\n' <<<"$var1" | wc -l | tr -d ' ')
  n_2=$(tr ',' '\n' <<<"$var2" | wc -l | tr -d ' ')
  [[ "$n_1" == "$n_2" ]] || { echo "$var1_name and $var2_name must have equal lengths" >&2; return 1; }
}

setup_filesystem_ids() {
  local system=$1 create_func=${2:-} prepare_func=${3:-}
  local name id lookup_output
  local ids_var="${system^^}_IDS" names_var="${system^^}_NAMES" mount_points_var="${system^^}_MOUNT_POINTS" id_func="get_${system}_id"
  local ids=${!ids_var} names=${!names_var}
  local i missing_i
  local -a matches=() name_list=() resolved_ids=() missing_indices=() missing_names=()

  if [[ -n "$ids" ]];then
    compare_length "$ids_var" "$mount_points_var" || return 1
    return 0
  fi
  [[ -z "$names" ]] && return 0

  compare_length "$names_var" "$mount_points_var" || return 1
  mapfile -t name_list < <(csv_items "$names")

  # Resolve every name before creating anything. This avoids creating resources
  # only to discover an ambiguous name later in the same request.
  for i in "${!name_list[@]}"; do
    name=${name_list[i]}
    if [[ -z "$name" ]];then
      echo "${names_var}[$i] is empty" >&2
      return 1
    fi
    if ! lookup_output=$("$id_func" "$name");then
      echo "$names_var: lookup failed for '$name'" >&2
      return 1
    fi
    mapfile -t matches < <(tr '\t' '\n' <<<"$lookup_output" | awk 'NF && $0 != "None"')
    case ${#matches[@]} in
      0)
        missing_indices+=("$i")
        missing_names+=("$name")
        ;;
      1)
        resolved_ids[i]=${matches[0]}
        ;;
      *)
        echo "$names_var: '$name' matches ${#matches[@]} ${system} file systems: ${matches[*]}" >&2
        echo "Names are not unique in AWS. Set $ids_var to pick one." >&2
        return 1
        ;;
    esac
  done

  if ((${#missing_indices[@]} > 0));then
    if [[ "${CREATE_FILE_SYSTEMS:-0}" != 1 || -z "$create_func" ]];then
      printf '%s: no %s file system matches:\n' "$names_var" "$system" >&2
      printf '  %s\n' "${missing_names[@]}" >&2
      [[ -n "$create_func" ]] && echo 'Set CREATE_FILE_SYSTEMS=1 to create the missing resources.' >&2
      return 1
    fi

    validate_resource_metadata || return 1
    printf 'Creation plan (%s):\n' "$system" >&2
    for name in "${missing_names[@]}";do
      printf '  create %s name=%s ManagedBy=%s\n' "$system" "$name" "${RESOURCE_MANAGED_BY:-ec2-environment}" >&2
    done
    if [[ "${RESOURCE_DRY_RUN:-0}" == 1 ]];then
      echo 'RESOURCE_DRY_RUN=1: no resources were created.' >&2
      printf -v "$ids_var" '%s' ''
      return 0
    fi

    if [[ -n "$prepare_func" ]];then
      "$prepare_func" "${#name_list[@]}" || return 1
    fi
    for missing_i in "${!missing_indices[@]}"; do
      i=${missing_indices[missing_i]}
      name=${missing_names[missing_i]}
      if ! id=$("$create_func" "$i" "$name");then
        echo "$names_var: failed to create '$name'" >&2
        return 1
      fi
      if [[ -z "$id" || "$id" == None ]];then
        echo "$names_var: creating '$name' returned no ID" >&2
        return 1
      fi
      resolved_ids[i]=$id
    done
  fi

  local IFS=,
  printf -v "$ids_var" '%s' "${resolved_ids[*]}"
}
__EC2_ASSET_scripts_common_sh__
  chmod 755 "$root/scripts/common.sh"
  mkdir -p "$(dirname "$root/scripts/make_ami.sh")"
  cat >"$root/scripts/make_ami.sh" <<'__EC2_ASSET_scripts_make_ami_sh__'
#!/usr/bin/env bash
set -euo pipefail

if ! type packer >/dev/null 2>&1; then
  echo "Packer is not installed. Please install Packer to continue." >&2
  exit 1
fi

# shellcheck disable=SC1091
source "$(dirname "$0")/bootstrap.sh" "${1:-}" "${2:-}"
repo_root=$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)
repository_revision=$(git -C "$repo_root" rev-parse HEAD 2>/dev/null || printf unknown)

rm -rf "$WORKDIR/packer"
mkdir -p "$WORKDIR/packer"
cp -R "$(dirname "$0")/../packer/." "$WORKDIR/packer/"
cd "$WORKDIR/packer"

make_main() {
  cat > "main.json" <<EOF
{
  "variables": {
  },
  "builders": [{
    "type": "amazon-ebs",
    "ami_name": "{{user \`ami_name\`}}",
    "source_ami": "{{user \`source_ami\`}}",
    "tags": {"Name": "{{user \`ami_name\`}}", "ManagedBy": "{{user \`resource_managed_by\`}}", "Project": "{{user \`resource_project\`}}", "Owner": "{{user \`resource_owner\`}}", "ExpiresAt": "{{user \`resource_expires_at\`}}"},
