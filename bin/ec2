# Optional for make_ami, which lets Packer pick a subnet. Required by setup_ec2
# through REQUIRED_SETTINGS_EC2, and by the file system scripts when they create
# something.
SUBNET_IDS=${SUBNET_IDS-}
SUBNET_NAMES=${SUBNET_NAMES-}
