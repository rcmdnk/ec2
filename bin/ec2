    "profile": "{{user \`profile\`}}",
    "region": "{{user \`region\`}}",
    "ssh_interface": "{{user \`ssh_interface\`}}",
    "ssh_username": "{{user \`ssh_username\`}}",
    "vpc_id": "{{user \`vpc_id\`}}",
    "security_group_ids": "{{user \`security_group_ids\`}}",
