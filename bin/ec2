TIME_ZONE=${TIME_ZONE-UTC}
SHUTDOWN=${SHUTDOWN-systemd}
SHUTDOWN_DURATION=${SHUTDOWN_DURATION-hourly}
SHUTDOWN_CHECK_PROCESS=${SHUTDOWN_CHECK_PROCESS-sshd|screen|tmux|mosh-server}
PACKAGES=${PACKAGES-}
FLATPAK_PACKAGES=${FLATPAK_PACKAGES-}
UPDATE_PACKAGES=${UPDATE_PACKAGES-1}
MULTI_PROCESSING=${MULTI_PROCESSING-1}

# CPU instance configuration.
CPU_INSTANCE=${CPU_INSTANCE-1}
CPU_AMI_NAME=${CPU_AMI_NAME-}
CPU_AMI_FILTER=${CPU_AMI_FILTER-al2023-ami-*-x86_64} # Amazon Linux 2023
CPU_AMI_OWNER=${CPU_AMI_OWNER=amazon}
