--user-data|-U user data file for luanch (run-instances),\ne.g: file:///path/to/your/user/data/script or fileb:///path/to/your/user/data/script.gz
--verbose|-v Set 1 to run as verbose mode (show\nexecuting commands.)
"

_print_list () {
  # shellcheck disable=SC2206
  local headers=($1)
  local contents="$2"
  # shellcheck disable=SC2206
  local types=($3)
  local n_cols=${#headers[@]}
  local width=()
  local i
  for ((i=0; i<n_cols; i++));do
    width[i]=${#headers[i]}
  done
  local line
  while read -r line || [ -n "${line}" ];do
    # shellcheck disable=SC2206
    local columns=($line)
    for ((i=0; i<n_cols; i++));do
      if (( width[i] < ${#columns[i]} ));then
        width[i]=${#columns[i]}
      fi
    done
  done < <(echo -n "$contents")
  local format_header=""
  local format=""
  for ((i=0; i<n_cols; i++));do
    format_header="${format_header:+${format_header} }%-${width[i]}s"
    if [ "${types[i]}" == "d" ];then
      format="${format:+${format} }%${width[i]}d"
    else
      format="${format:+${format} }%-${width[i]}s"
    fi
  done
  # shellcheck disable=SC2059
  printf "$format_header\n" "${headers[@]}"
  # shellcheck disable=SC2059
  printf "%0$(printf "$format_header" "${headers[@]}"|wc -c|xargs)d\n"|tr 0 -
  while read -r line || [ -n "${line}" ];do
    # shellcheck disable=SC2059,SC2086
    printf "$format\n" $line
  done < <(echo -n "$contents")
}

_sedi () {
  (
    eval "exec $__submit_sedi_lock_fd>$__submit_sedi_lock"
    flock -x $__submit_sedi_lock_fd
    tmpfile=$(mktemp)
    sed "$1" "$2" > "$tmpfile"
    mv "$tmpfile" "$2"
  )
}

_tac () {
  echo "$@" | sed -n '1!G;h;$p'
}

_check_job_instances () {
  (
    eval "exec $__submit_sedi_lock_fd>$__submit_sedi_lock"
    flock -x $__submit_sedi_lock_fd
    if [ -n "$__submit_max_jobs" ] && (( __submit_max_jobs > 0 )) && (( $(grep -c -e running -e starting -e launching -e terminating "$__job_list") > __submit_max_jobs ));then
      echo 1
    else
      echo 0
    fi
  )
}

_execute () {
  if [ "$__verbose" = "1" ];then
    echo "$*"
  fi
  __execute_result="$(eval "$*" 2>&1)"
  local ret=$?
  __execute_result="$(echo "$__execute_result"|awk 'NR==1 && /^$/ {next} {print}')"
  if [ $ret != 0 ];then
    if echo "$__execute_result"|grep -q DryRunOperation;then
      return 0
    elif [ "$__exit_at_fail" != "0" ];then
      echo "ERR_CODE=$ret: $__execute_result" 1>&2
      exit $ret
    fi
  fi
  return $ret
}

_execute_aws () {
  local cmd="aws $* ${__aws_profile:+--profile ${__aws_profile}}"
  while :;do
    __exit_at_fail=0 _execute "$cmd"
    local ret=$?
    if [ "$ret" -eq 0 ];then
      return 0
    fi
    if [ "$ret" -eq 255 ] && echo "$__execute_result" | grep -Eiq 'expired|invalid.*token|unable to locate credentials|credential|sso|unauthorized';then
      if [ -z "$__auth_command" ];then
        echo 'AWS credentials are unavailable and no authentication refresh command is configured.' 1>&2
        return $ret
      fi
      if [ -t 0 ] && [ -r /dev/tty ];then
        bash -c "$__auth_command" </dev/tty >/dev/tty 2>/dev/tty
      else
        bash -c "$__auth_command" 1>&2
      fi
      local auth_ret=$?
      if [ "$auth_ret" -eq 0 ];then
        continue
      else
        echo "ERR_CODE=$auth_ret: AWS authentication refresh command failed." 1>&2
        exit $auth_ret
      fi
    fi
    if [ "$__exit_at_fail" = "0" ];then
      return $ret
    fi
    echo "ERR_CODE=$ret: $__execute_result" 1>&2
    exit $ret
  done
}

_execute_ec2 () {
  _execute_aws ec2 "$*"
}

_select () {
  local input=("$@")
  local tool
  local t
  for t in $(echo "${__selection_tool:-sentaku,peco,fzy,fzf}"|tr , ' ');do
    if type "$t" >& /dev/null ;then
      tool=$t
      break
    fi
  done
  if [[ "$tool" = "sentaku" ]];then
    tool="sentaku -s line"
  fi
  if [ -n "$tool" ];then
    __selected=$(echo "${input[*]}"|$tool)
  else
    while IFS=$'\n' read -r line; do values+=("$line"); done < <(echo "${input[*]}")
    select value in "${values[@]}";do
      __selected=$value
      break
    done
  fi
}

_ip_choice () {
  local ip_choice="PublicIpAddress"
  if [ "$__private_ip" = "1" ];then
    ip_choice="PrivateIpAddress"
  fi
  echo "$ip_choice"
}
_get_instance_list () {
  # shellcheck disable=SC2089
  local cmd="describe-instances --query \"Reservations[*].Instances[*].{a:Tags[?Key=='Name']|[0].Value,b:InstanceId,c:$(_ip_choice),d:State.Name,e:InstanceType,f:InstanceLifecycle,g:Placement.AvailabilityZone}\" --output text $__instance_filter"
  if [ -n "${__ids[__enum_instance]}" ];then
    local cmd="$cmd --instance-ids ${__ids[__enum_instance]}"
  fi
  _execute_ec2 "$cmd"
  # Tab replace is needed, otherwise grep fails to filter
  __list[__enum_instance]="$(echo "$__execute_result"|tr "\t" " "|sort -k 1,3 -V)"
  if [ -n "$__name_filter" ];then
    __list[__enum_instance]="$(echo "${__list[__enum_instance]}"|grep "$__name_filter")"
  fi
}

_get_image_list () {
  _execute_aws sts get-caller-identity --query "Account" --output text
  local account="$__execute_result"
  _execute_ec2 "describe-images --owners $account --query \"Images[*].{a:Name,b:ImageId,c:BlockDeviceMappings[0].Ebs.SnapshotId}\" --output text"
  # Sometime Name includes space prefix (?)
  __list[__enum_image]="$(echo "$__execute_result"|tr "\t" " "|awk '{print $1" "$2" "$3}'|sort -k 1 -V)"
  if [ -n "$__image_name_filter" ];then
    __list[__enum_image]="$(echo "${__list[__enum_image]}"|grep "$__image_name_filter")"
  fi
}

_get_template_list () {
  _execute_ec2 "describe-launch-templates --query 'LaunchTemplates[*].{a:LaunchTemplateName,b:LaunchTemplateId}' --output text"
  __list[__enum_template]="$(echo "$__execute_result"|tr "\t" " "|sort -k 1 -V)"
}

_get_type_list () {
  if [ -f "$__type_list_file" ];then
    find "$__type_list_file" -mtime +"$__type_list_file_term" -exec command rm -f {} +
  fi
  if [ ! -f "$__type_list_file" ];then
    # shellcheck disable=SC2089
    local cmd="describe-instance-types --query \"InstanceTypes[*].{a:InstanceType,b:VCpuInfo.DefaultVCpus,c:VCpuInfo.DefaultCores,d:VCpuInfo.DefaultThreadsPerCore,e:MemoryInfo.SizeInMiB,f:ProcessorInfo.SupportedArchitectures[0],g:GpuInfo.Gpus[0].Name}\" --output text"
    if [ -n "$filters" ];then
      cmd="$cmd $filters"
    fi
    _execute_ec2 "$cmd"
    __list[__enum_type]="$(echo "$__execute_result"|tr "\t" " "|sort -V)"
    echo "${__list[__enum_type]}" > "$__type_list_file"
  else
    __list[__enum_type]="$(cat "$__type_list_file")"
  fi

  if [ -n "$__cpu_filter" ];then
    __list[__enum_type]="$(echo "${__list[__enum_type]}"|grep "$__cpu_filter")"
  fi
  if [ -n "$__gpu_filter" ];then
    if [ "$__gpu_filter" == 0 ];then
      __list[__enum_type]="$(echo "${__list[__enum_type]}"|grep None)"
    elif [ "$__gpu_filter" == 1 ];then
      __list[__enum_type]="$(echo "${__list[__enum_type]}"|grep -v None)"
    else
      __list[__enum_type]="$(echo "${__list[__enum_type]}"|grep "$__gpu_filter")"
    fi
  fi
}

_select_objs () {
  local enum_obj=$1
  local only=$2
  ${__get_list_func[enum_obj]}
  if [ -z "${__list[enum_obj]}" ];then
    echo "No ${__obj_name[enum_obj]} is available"
    exit 1
  fi
  _select "${__list[enum_obj]}"
  if [ -z "$__selected" ];then
    echo "No ${__obj_name[enum_obj]} was selected"
    exit 1
  fi
  if [ "$only" = "1" ];then
    if [ "$(echo "$__selected"|wc -l|xargs)" != 1 ];then
      echo "More than 1 ${__obj_name[enum_obj]}s were selected"
      exit 1
    fi
  fi
  __list[enum_obj]="$__selected"
}

_get_ids () {
  local enum_obj=$1
  local only=$2
  if [ "${__ids[enum_obj]}" == "select" ] || [ -z "${__ids[enum_obj]}" ];then
    _select_objs "$enum_obj" "$only"
    __ids[enum_obj]="$(echo "${__list[enum_obj]}"|awk '{print $2}'|tr '\n' ' ')"
  fi
  if [ -z "${__ids[enum_obj]}" ];then
    exit
  fi
}

_get_id_name_list () {
  local enum_obj=$1
  __id_name_list=""
  if [ -n "${__list[enum_obj]}" ];then
    for id in ${__ids[enum_obj]};do
      __id_name_list="${__id_name_list:+${__id_name_list}, }$(echo "${__list[enum_obj]}"|grep "$id"|awk '{print $1}') ($id)"
    done
  else
    __id_name_list="$(echo "${__ids[enum_obj]}"|sed -e 's/ /, /g' -e 's/, $//')"
  fi
}

_instance_check () {
  if [ -z "${__ids[__enum_instance]}" ];then
    _select_objs $__enum_instance 1
  else
    _get_instance_list
  fi
  # shellcheck disable=SC2206
  __ids[__enum_instance]=$(echo "${__list[__enum_instance]}"|awk '{print $2}')
  __instance_ip=$(echo "${__list[__enum_instance]}"|awk '{print $3}')
  __instance_az=$(echo "${__list[__enum_instance]}"|awk '{print $7}')
  local status=$(echo "${__list[__enum_instance]}"|awk '{print $4}')

  wait_incorrect_spot_request_state=0
  while :;do
    if [ "$status" == "running" ];then
      break
    fi
    if [ "$status" == "stopped" ];then
      __exit_at_fail=0 start
      local ret=$?
      if [ "$ret" -eq 254 ] && echo "${__execute_result}"|grep -q "IncorrectSpotRequestState";then
        if [ $wait_incorrect_spot_request_state -eq 0 ];then
          echo "Waiting for spot request state to be correct after stopping..."
        fi
        ((wait_incorrect_spot_request_state++))
      elif [ "$ret" -ne 0 ];then
        echo "ERR_CODE=$ret: $__execute_result" 1>&2
        exit "$ret"
      fi
      sleep 5
    elif [ "$status" == "" ];then
      echo "${__ids[__enum_instance]} does not exist."
      exit 1
    else
      sleep 1
    fi
    _get_instance_list
    status=$(echo "${__list[__enum_instance]}"|awk '{print $4}')
  done
}

_get_name_number () {
  local name="$1"
  local names="$2"
  local suffix=$(basename "${name//-//}")
  if [[ "$suffix" =~ ^[0-9]+$ ]];then
    name_base="${name%-"${suffix}"}"
  else
    name_base="${name}"
  fi
  suffix=1
  name="${name_base}-$(printf "%02d" "$suffix")"
  while :;do
    if ! echo "$names"|grep -q "^${name}$";then
      break
    fi
    ((suffix++))
    name="${name_base}-$(printf "%02d" "$suffix")"
  done
  echo "$name"
}

_get_template () {
  if [ -n "${__ids[__enum_template]}" ];then
    _get_ids $__enum_template 1
    _execute_ec2 "describe-launch-template-versions --launch-template-id ${__ids[__enum_template]} --filters Name=is-default-version,Values=true --query \"LaunchTemplateVersions[0].{a:LaunchTemplateName,b:LaunchTemplateData.InstanceType,c:LaunchTemplateData.TagSpecifications[0].Tags[?Key=='Name']|[0].Value}\" --output text"
    # shellcheck disable=SC2206
    local result=($__execute_result)
    __template_name="${result[0]}"
    __tempalte_instance_type="${result[1]}"
    __template_name_name="${result[2]}"
    if [ -z "$name" ];then
      __template_name_name="$template_name"
    fi
    __launch_template="--launch-template LaunchTemplateId=${__ids[__enum_template]}"
  fi
}

_get_json_group () {
  local group_name="$1"
  local group_var="cli_input_json_group_${group_name}"
  local group_value
  eval "group_value=\${__${group_var}}"
  if [ -z "$group_value" ]; then
    echo "JSON group '${group_name}' not found in config" >&2
    return 1
  fi
  echo "$group_value"
}

list_json_groups () {
  # List available JSON groups
  local header="Group Files"
  local contents=""
  local group
  for group in "${__cli_input_json_groups[@]}";do
    local var_name=__cli_input_json_group_$group
    local files=${!var_name}
    contents="$contents$group $files"$'\n'
  done

  if [ -z "$contents" ]; then
    echo "No JSON groups defined in config"
    return 0
  fi

  echo "JSON directory: $__cli_input_json_directory"
  echo ""
  _print_list "$header" "$contents"
}

_get_cli_input_jsons () {
  if [ -n "$__cli_input_json" ] && [ "$__cli_input_json" != "select" ]; then
    :
  elif [ -n "$__cli_input_json_group" ]; then
    if [ "$__cli_input_json_group" = "select" ]; then
      if [ "${#__cli_input_json_groups[@]}" -eq 0 ];then
        echo "No cli_input_json_group is defined"
        exit 1
      fi
      _select "${__cli_input_json_groups[@]}"
      __cli_input_json_group=$__selected
      if [ -z "$__cli_input_json_group" ];then
        echo "No cli_input_json_group is selected"
        exit 1
      fi
    fi
    local var_name=__cli_input_json_group_${__cli_input_json_group}
    __cli_input_json=${!var_name}
  elif [ "$__cli_input_json" = "select" ]; then
    if [ -z "$__cli_input_json_directory" ]; then
      echo "Set cli_input_json_directory by: ec2 -C <cli_input_json_directory> <command>"
      exit 1
    fi
    _select "$(command ls "$__cli_input_json_directory")"
    __cli_input_json="$__selected"
  fi

  # shellcheck disable=SC2086
  read -r -a __cli_input_json_list <<< "$(echo $__cli_input_json | tr "," " ")"
}

_get_cli_input_json_opt () {
  _get_cli_input_jsons
  if [ "${#__cli_input_json_list[@]}" -eq 0 ];then
    __cli_input_json_opt=""
    return
  fi
  if [ $__n_cli_input_json -ge ${#__cli_input_json_list[@]} ];then
    echo "No cli_input_json is available @ $__n_cli_input_json"
    exit 1
  fi
  local json=${__cli_input_json_list[__n_cli_input_json]}
  if [[ ! "$json" =~ ^file:// ]];then
    if [ -f "$json" ];then
      json="file://$json"
    elif [ -f "$__cli_input_json_directory/$json" ];then
      json="file://$__cli_input_json_directory/$json"
    else
      echo "cli_input_json is not found: $json"
      exit 1
    fi
  fi
  __cli_input_json_opt="--cli-input-json $json"
}

launch () {
  # Launch a new instance.
  local name=""
  local instance_type=""
  __instance_filter="--filters Name=instance-state-name,Values=pending,running,stopping,stopped" _get_instance_list
  local names=$(echo "${__list[__enum_instance]}"|awk '{print $1}')

  _get_template
  if [ -n "$__template_name" ];then
    local template_name="$__template_name"
    instance_type="$__tempalte_instance_type"
    name="$__template_name_name"
    local launch_template="$__launch_template"
  fi
  _get_cli_input_jsons
  if [ -z "$__template_name" ] && [ -z "${__cli_input_json_list[*]}" ];then
    echo "Need at least template_id or cli_input_json" 1>&2
    exit 1
  fi

  if [ "$__instance_type" == "select" ];then
    _select_objs $__enum_type 1
    __instance_type=$(echo "${__list[__enum_type]}"|awk '{print $1}')
  fi
  if [ -n "${__instance_type}" ];then
    instance_type="${__instance_type}"
  fi
  if [ -n "${instance_type}" ];then
    instance_type_opt="--instance-type ${instance_type}"
  fi
  local cpu_options
  if [ -n "$__n_cpu_core" ] || [ -n "$__n_thread" ];then
    if [ -z "$__n_cpu_core" ] || [ -z "$__n_thread" ];then
      _get_type_list
      read -r -a type_info <<< "${__list[__enum_type]}"
      cpu_core=${__n_cpu_core:-${type_info[2]}}
      n_thread=${__n_thread:-${type_info[3]}}
    fi
    cpu_options="--cpu-options \"CoreCount=${cpu_core},ThreadsPerCore=${n_thread}\""
  fi
  local user_data
  if [ -n "$__user_data" ];then
    if [[ ! "$__user_data" =~ ^file ]];then
      if file --mime "$__user_data" | grep -q 'charset=binary'; then
        __user_data="fileb://$__user_data"
      else
        __user_data="file://$__user_data"
      fi
    fi
    user_data="--user-data $__user_data"
  fi

  local spot_instance
  if [ "$__spot_instance" = 1 ];then
    spot_instance="$__opt_spot"
  else
    __spot_instance=0
  fi

  local fail_reason=""
  while [ "$__spot_instance" -ge 0 ];do
    if [ "${#__cli_input_json_list[@]}" -eq 0 ];then
      __n_cli_input_json=-1
    fi
    while [ "$__n_cli_input_json" -lt "${#__cli_input_json_list[@]}" ];do
      _get_cli_input_json_opt
      if [ -n "$__cli_input_json_opt" ];then
        name=$(basename "$(echo "${__cli_input_json_opt}"|cut -d ' ' -f 2)")
        name="${name%.json}"
      fi
      name=$(_get_name_number "$name" "$names")

      if [ "$__n_cli_input_json" -gt 0 ];then
        echo "Try launching next cli_input_json (${__cli_input_json_list[__n_cli_input_json]})" 1>&2
      fi

      local msg="Launching a new instance: name=$name"
      msg="$msg${instance_type:+, type=${instance_type}}"
      if [ "$__n_cli_input_json" -ge 0 ];then
        msg="$msg, cli_input_json=${__cli_input_json_list[__n_cli_input_json]}"
      fi
      msg="$msg${template_name:+, template=$template_name}"
      if [ "$__spot_instance" = 1 ];then
        msg="$msg, lifecycle=spot"
      fi
      echo "$msg" 1>&2

      __exit_at_fail=0 _execute_ec2 "run-instances ${__dry_run_mode} ${cpu_options} ${spot_instance} ${user_data} ${launch_template} ${__cli_input_json_opt} ${instance_type_opt} --tag-specifications 'ResourceType=instance,Tags=[{Key=Name,Value=$name}]' --query \"Instances[*].{a:Tags[?Key=='Name']|[0].Value,b:InstanceId,c:$(_ip_choice),d:InstanceType}\" --output text"
      local ret=$?
      if [ "$ret" -eq 0 ];then
        break
      fi
      echo "ERR_CODE=$ret: $__execute_result" 1>&2
      if [ "$ret" -eq 254 ] && echo "${__execute_result}"|grep -q "InsufficientInstanceCapacity";then
        fail_reason="InsufficientInstanceCapacity"
        ((__n_cli_input_json++))
        continue
      fi
      exit "$ret"
    done
    if [ "$ret" -eq 0 ];then
      break
    fi
    if [ "$__retry_non_spot" = 0 ];then
      break
    fi
    spot_instance=""
    ((__spot_instance--))
    if [ "$__spot_instance" -eq 0 ];then
      echo "Try launching non spot instance" 1>&2
      __n_cli_input_json=0
    fi
  done
  if [ "$ret" -ne 0 ];then
    if [ -n "$fail_reason" ];then
      echo "Failed to launch instance by $fail_reason"
    fi
    exit "$ret"
  fi

  if [ "$__dry_run" = "1" ];then
    local id="XXX"
    local ip="XXX"
  else
    # shellcheck disable=SC2206
    local result=(${__execute_result})
    name=${result[0]}
    local id=${result[1]}
    local ip=${result[2]}
    instance_type=${result[3]}
  fi
  local spot_instance_msg
  if [ "$__spot_instance" = "1" ];then
    spot_instance_msg=", Lifecycle=spot"
  fi
  echo "${__dry_run_mode:+Dry run: }A new instance was launched: Name=$name, Id=$id, $(_ip_choice)=$ip, Type=${instance_type}${spot_instance_msg}"
}

start () {
  # Start stopped instances.
  __instance_filter="--filters Name=instance-state-name,Values=stopped" _get_ids $__enum_instance
  _execute_ec2 "$__dry_run_mode start-instances --instance-ids ${__ids[__enum_instance]}"
  local ret=$?
  _get_id_name_list $__enum_instance
  if [ "$ret" -eq 0 ];then
    echo "${__dry_run_mode:+Dry run: }Started: $__id_name_list"
  fi
  return "$ret"
}

stop () {
  # Stop running instances.
  __instance_filter="--filters Name=instance-state-name,Values=running" _get_ids $__enum_instance
  _execute_ec2 "$__dry_run_mode stop-instances --instance-ids ${__ids[__enum_instance]}"
  local ret=$?
  _get_id_name_list $__enum_instance
  if [ $ret -eq 0 ];then
    echo "${__dry_run_mode:+Dry run: }Stopped: $__id_name_list"
  fi
  return $ret
}

terminate () {
  # Terminate instances.
  __instance_filter="--filters Name=instance-state-name,Values=pending,running,stopping,stopped" _get_ids ${__enum_instance}
  _execute_ec2 "describe-instances --instance-ids ${__ids[__enum_instance]} --query \"Reservations[*].Instances[*].SpotInstanceRequestId\" --output text"
  local spot_instances="${__execute_result}"
  local spot_instance_msg
  if [ -n "${spot_instances}" ];then
    spot_instance_msg=""
    for spot_request in ${spot_instances};do
      if [ -n "${spot_request}" ];then
        _execute_ec2 "${__dry_run_mode} cancel-spot-instance-requests --spot-instance-request-ids ${spot_request}"
        spot_instance_msg="${spot_instance_msg:+${spot_instance_msg}, }$spot_request"
      fi
    done
    spot_instance_msg=", cancel Spot Instance Request: $spot_instance_msg"
  fi
  _execute_ec2 "${__dry_run_mode} terminate-instances --instance-ids ${__ids[__enum_instance]}"
  _get_id_name_list ${__enum_instance}
  echo "${__dry_run_mode:+Dry run: }Terminated: ${__id_name_list}${spot_instance_msg}"
}

rm () {
  # Alias for terminate.
  terminate
}

instances () {
  # List instances.
  _get_instance_list
  local header="Name Id Ip Status Type Lifecycle"
  local contents=""
  local line
  while read -r line || [ -n "${line}" ];do
    # shellcheck disable=SC2206
    line=($line)
    local name=${line[0]}
    local id=${line[1]}
    local ip=${line[2]}
    local st=${line[3]}
    local ty=${line[4]}
    local sp=${line[5]}
    contents=${contents}"$name $id $ip $st $ty $sp"$'\n'
  done < <(echo "${__list[__enum_instance]}")
  _print_list "$header" "$contents"
}

list () {
  # Alias for instances.
  instances
}

ls () {
  # Alias for instances.
  instances
}

describe () {
  # Show detailed information about instances
  _get_ids $__enum_instance

  _execute_ec2 "describe-instances --instance-ids ${__ids[__enum_instance]} \
    --query 'Reservations[*].Instances[*].{
      Name:Tags[?Key==\`Name\`].Value|[0],
      InstanceId:InstanceId,
      InstanceType:InstanceType,
      State:State.Name,
      LaunchTime:LaunchTime,
      Platform:Platform,
      PrivateIP:PrivateIpAddress,
      PublicIP:PublicIpAddress,
      KeyName:KeyName,
      SecurityGroups:SecurityGroups[*].GroupName
    }' \
    --output table"

  echo "$__execute_result"
}

ssh () {
  # SSH to an instance.
  # Use `ssh [commands] [options]`.
  local cmd="${1:-ssh}"
  _instance_check
  if [ "$__connection_method" = "ssm" ];then
    if [ "$cmd" != "ssh" ] || [ -n "${__execute_command:-}" ];then
      echo "EC2_CONNECTION_METHOD=ssm supports interactive \`ec2 ssh\` only; use ssh for commands, mosh, et, scp, and rsync." >&2
      return 2
    fi
    _execute_aws "ssm start-session --target ${__ids[__enum_instance]}"
    return $?
  elif [ "$__connection_method" = "ec2_instance_connect" ];then
    if [ "$cmd" != "ssh" ] || [ -n "${__execute_command:-}" ];then
      echo "EC2_CONNECTION_METHOD=ec2_instance_connect supports interactive \`ec2 ssh\` only." >&2
      return 2
    fi
    if [ -z "${__ssh_key:-}" ] || [ ! -f "$__ssh_key" ];then
      echo 'EC2_CONNECTION_METHOD=ec2_instance_connect requires EC2_SSH_PRIVATE_KEY.' >&2
      return 2
    fi
    if ! type ssh-keygen >/dev/null 2>&1;then
      echo 'EC2_CONNECTION_METHOD=ec2_instance_connect requires ssh-keygen.' >&2
      return 2
    fi
    local public_key quoted_public_key
    public_key=$(ssh-keygen -y -f "$__ssh_key") || {
      echo "Could not derive a public key from $__ssh_key." >&2
      return 2
    }
    printf -v quoted_public_key '%q' "$public_key"
    _execute_aws "ec2-instance-connect send-ssh-public-key --instance-id ${__ids[__enum_instance]} --availability-zone ${__instance_az} --instance-os-user ${__ssh_user:-ec2-user} --ssh-public-key ${quoted_public_key}" || return $?
  elif [ "$__connection_method" != "ssh" ];then
    echo "Unsupported EC2_CONNECTION_METHOD: $__connection_method (expected ssh, ssm, or ec2_instance_connect)." >&2
    return 2
  fi
  local -a ssh_options=("${__ssh_option[@]}")
  if [ -n "$__ssh_key" ];then
    ssh_options+=(-i "$__ssh_key")
  fi
  local ip=$__instance_ip
  if [ -n "$__ssh_user" ];then
    ip="$__ssh_user@$ip"
  fi
  waiting_for_ready=0
  while :;do
    command ssh "${ssh_options[@]}" "$ip" "sudo tail -n1 /var/log/cloud-init-output.log |grep 'Cloud-init.*finished at.*seconds$'" >/dev/null 2>&1
    local ret=$?
    if [ "$ret" -eq 0 ];then
      break
    fi
    if [ "$waiting_for_ready" -eq 0 ];then
      echo "Waiting for ready..."
    fi
    ((waiting_for_ready++))
    sleep 5
    # Soemtime instance is stopped during waiting, restart it if needed.
    _instance_check
  done
  local -a execute_command=()
  if [ -n "${__execute_command:-}" ];then
    execute_command=("$__execute_command")
  fi
  if [ "$cmd" = "mosh" ];then
    if ((${#ssh_options[@]}));then
      local mosh_ssh
      printf -v mosh_ssh '%q ' ssh "${ssh_options[@]}"
      ssh_options=("--ssh=${mosh_ssh% }")
    else
      ssh_options=()
    fi
    if [ -n "$__mosh_server" ];then
      ssh_options+=("--server=$__mosh_server")
    fi
  elif [ "$cmd" = "et" ];then
    local -a et_options=("${__et_option[@]}")
    local i option
    for ((i=0; i<${#ssh_options[@]}; i++));do
      option=${ssh_options[i]}
      case "$option" in
        -o|-i)
          if ((i + 1 >= ${#ssh_options[@]}));then
            echo "$option requires a value for an Eternal Terminal connection." >&2
            return 2
          fi
          ((i += 1))
          if [ "$option" = "-o" ];then
            et_options+=(--ssh-option "${ssh_options[i]}")
          else
            et_options+=(--ssh-option "IdentityFile=${ssh_options[i]}")
          fi
          ;;
        -o?*) et_options+=(--ssh-option "${option#-o}");;
        -i?*) et_options+=(--ssh-option "IdentityFile=${option#-i}");;
        *)
          echo "SSH argument '$option' cannot be forwarded to Eternal Terminal; use --et-option or ~/.ssh/config." >&2
          return 2
          ;;
      esac
    done
    if ((${#execute_command[@]}));then
      et_options+=(--command "${execute_command[0]}")
      execute_command=()
    fi
    ssh_options=("${et_options[@]}")
  fi
  command "$cmd" "${ssh_options[@]}" "$ip" "${execute_command[@]}"
}

et () {
  # Connect to an instance with Eternal Terminal.
  # Use `et [command] [options]`.
  ssh et
  local ret=$?
  _instance_check
  return "$ret"
}

mosh () {
  # Mosh to an instance.
  # Use `mosh [commands] [options]`.
  ssh mosh
  local ret=$?
  _instance_check
  return "$ret"
}

_transfer () {
  local cmd=$1
  local -a operands=("${__transfer_operands[@]}")
  if ((${#operands[@]} == 0)) && [ "$cmd" = "scp" ] && [ -n "${__file:-}" ];then
    # submit uses the legacy single-file upload internally.
    operands=("$__file")
  fi
  if ((${#operands[@]} == 0));then
    echo "Usage: $__cmd $cmd <source> <destination>" >&2
    return 2
  fi
  if [ "$cmd" = "scp" ] && ((${#operands[@]} == 1));then
    operands+=(":")
  elif ((${#operands[@]} < 2));then
    echo "Usage: $__cmd $cmd <source> <destination>" >&2
    return 2
  fi

  local last=$((${#operands[@]} - 1))
  local remote_destination=0
  [[ "${operands[last]}" == :* ]] && remote_destination=1
  local remote_sources=0 i
  for ((i=0; i<last; i++));do
    [[ "${operands[i]}" == :* ]] && ((remote_sources += 1))
  done
  if ((remote_destination && remote_sources));then
    echo "$cmd cannot copy between two remote paths." >&2
    return 2
  fi
  if ((!remote_destination && !remote_sources));then
    # With no explicit ':' marker, retain the upload-oriented scp behavior.
    operands[last]=":${operands[last]}"
    remote_destination=1
  elif ((!remote_destination && remote_sources != last));then
    echo "$cmd cannot mix local and remote source paths." >&2
    return 2
  fi
  if ((remote_destination));then
    for ((i=0; i<last; i++));do
      if [ ! -e "${operands[i]}" ] && [ ! -L "${operands[i]}" ];then
        echo "${operands[i]} does not exist" >&2
        return 2
      fi
    done
  fi

  _instance_check
  local -a ssh_options=("${__ssh_option[@]}")
  if [ -n "$__ssh_key" ];then
    ssh_options+=(-i "$__ssh_key")
  fi
  local ip=$__instance_ip
  if [ -n "$__ssh_user" ];then
    ip="$__ssh_user@$ip"
  fi
  local waiting_for_ready=0
  while :;do
    command ssh "${ssh_options[@]}" "$ip" "exit" >/dev/null 2>&1
    local ret=$?
    if [ $ret -eq 0 ];then
      break
    fi
    if [ "$waiting_for_ready" -eq 0 ];then
      echo "Waiting for ready..."
    fi
    ((waiting_for_ready += 1))
    sleep 5
    # Soemtime instance is stopped during waiting, restart it if needed.
    _instance_check
  done

  for ((i=0; i<${#operands[@]}; i++));do
    if [[ "${operands[i]}" == :* ]];then
      operands[i]="$ip:${operands[i]#:}"
    fi
  done
  if [ "$cmd" = "rsync" ];then
    local rsync_ssh
    printf -v rsync_ssh '%q ' ssh "${ssh_options[@]}"
    command rsync "${__rsync_option[@]}" -e "${rsync_ssh% }" "${operands[@]}"
    return
  fi

  local -a scp_ssh_options=()
  local option
  for ((i=0; i<${#ssh_options[@]}; i++));do
    option=${ssh_options[i]}
    case "$option" in
      -p)
        if ((i + 1 >= ${#ssh_options[@]}));then
          echo "-p requires a port value." >&2
          return 2
        fi
        ((i += 1))
        scp_ssh_options+=(-P "${ssh_options[i]}")
        ;;
      -p?*) scp_ssh_options+=(-P "${option#-p}");;
      *) scp_ssh_options+=("$option");;
    esac
  done
  command scp "${scp_ssh_options[@]}" "${__scp_option[@]}" "${operands[@]}"
}

rsync () {
  # Synchronize files with an instance.
  # Prefix an instance path with `:`, for example `rsync ./src/ :/srv/src/`.
  _transfer rsync
}

scp () {
  # Copy files to or from an instance.
  # Prefix an instance path with `:`, for example `scp file :/tmp/`.
  _transfer scp
}

_clear_job () {
  local clear_lsit=${1:-1}
  if [ -n "${__ids[__enum_instance]}" ];then
    _sedi "s/${job_id}.*$/${job_id} ${instance_id} ${instance_ip} terminating/" "$__job_list"
    if [ "$__submit_remain_instance" != "1" ];then
      terminate
    fi
  fi
  if [ "$clear_lsit" = 1 ];then
    _sedi "/^${job_id} /d" "$__job_list"
  fi
}

submit () {
  # Make a new instance and submit a job.
  # Use `submit <file or commands> [options].
  # If __submit_command is not set, need one
  # bash file.
  # If __submit_command is set, given options
  # are recognized as command. Use `--` to
  # separate options for ec2 and options  for
  # the command.
  # If `__curent_dir` is set, the command is
  # executed in the current directory.
  # (Need same directory structure in the
  # instance.)
  if ! type flock >/dev/null 2>&1;then
    echo "flock is required for 'submit'"
    echo "Install flock ('brew install flock' or anything)"
    exit 1
  fi

  if [ -z "$__submit_name" ];then
    __submit_name=$(basename "$(echo "${__positional[0]}" | cut -d ';' -f1 | cut -d ' ' -f1)")
  fi
  local job_id="$$ $(date +"%Y-%m-%d %H:%M:%S") $__submit_name"

  trap "_clear_job;exit 1" HUP INT QUIT ABRT SEGV TERM

  echo "$job_id - - waiting" >> "$__job_list"

  while :;do
    if [ "$(_check_job_instances)" = 1 ];then
      sleep 5
    else
      break
    fi
  done

  _sedi "s/${job_id}.*$/${job_id} - - starting/" "$__job_list"
  echo "Launching an instance for job: $job_id"
  local n_retry_ssh=0
  while :;do
    local n_retry=0
    local ret=0
    local output=""
    while :;do
      output=$(
        eval "exec $__submit_launch_lock_fd>$__submit_launch_lock"
        flock -x $__submit_launch_lock_fd
        _sedi "s/${job_id}.*$/${job_id} - - launching/" "$__job_list"
        output=$(launch)
        ret=$?
        echo "$output"
        if [ $ret -ne 0 ];then
          echo "ERR_CODE=$ret: Failed to launch instance for job: $job_id"
          exit $ret
        fi
      )
      local ret=$?
      if [ $ret -eq 0 ];then
        break
      fi
      if [ $ret -ne 254 ] || ! echo "$output" | grep -q "InsufficientInstanceCapacity";then
        break
      fi
      ((n_retry++))
      if [ $n_retry -le "${__submit_n_retry_launch}" ];then
        echo "Failed to launch instance by capacity, retry after ${__submit_retry_launch_interval} seconds..."
        sleep "${__submit_retry_launch_interval}"
        continue
      fi
      break
    done
    if [ $ret -ne 0 ];then
      echo "$output" 1>&2
      _clear_job
      exit $ret
    fi
    local instance_id=$(echo "$output" |tr ',' $'\n'|grep "^ Id"|cut -d '=' -f2)
    local instance_ip=$(echo "$output" |tr ',' $'\n'|grep "^ $(_ip_choice)"|cut -d '=' -f2)
    local instance_type=$(echo "$output" |tr ',' $'\n'|grep "^ Type"|cut -d '=' -f2)
    __ids[__enum_instance]="$instance_id"
    _sedi "s/${job_id}.*$/${job_id} ${instance_id} ${instance_ip} launching/" "$__job_list"

    # Wait the instance be ready
    __execute_command="exit"
    ssh
    _sedi "s/${job_id}.*$/${job_id} ${instance_id} ${instance_ip} running/" "$__job_list"

    if [ "$__submit_command" != "1" ];then
      __execute_command="bash ~/$(basename "$__file")"
    else
      __execute_command="${__positional[*]}"
    fi
    if [ "$__submit_measure_time" = "1" ];then
      __execute_command="time $__execute_command"
    fi
    __execute_command="echo RUN STARTED;echo Execute \"$__execute_command\" at job_id=$job_id, insatnce_id=$instance_id, instance_ip=$instance_ip, instance_type=$instance_type; $__execute_command; echo RUN FINISHED"
    if [ "$__submit_command" != "1" ];then
      scp
    fi
    if [ "$__submit_current_dir" = 1 ];then
      __execute_command="cd $PWD; $__execute_command"
    fi
    ssh
    local ret=$?
    if [ $ret -eq 255 ];then
      echo "SSH connection was closed by the remote host"
      ((n_retry_ssh++))
      if [ $n_retry_ssh -lt "${__submit_n_retry_ssh}" ];then
        _clear_job 0
        _sedi "s/${job_id}.*$/${job_id} - - retrying/" "$__job_list"
        echo "Retry after ${__submit_retry_ssh_interval} seconds..."
        sleep "${__submit_retry_ssh_interval}"
        continue
      fi
    fi
    break
  done

  echo "finishing job: $job_id, return code: $ret"
  _execute_ec2 "describe-instances --instance-ids ${instance_id} --query \"Reservations[*].Instances[*].{a:State.Name,b:StateTransitionReason}\" --output text"
  echo "Instance state: $__execute_result"
  echo "Clear job: $job_id"
  _clear_job
}

jobs () {
  # List jobs.
  touch "$__job_list"
  _print_list "PID DATE TIME NAME INSTANCE_ID IP STATUS" "$(cat "$__job_list")"
}

delete_job () {
  # Delete jobs.
  if [ ! -f "$__job_list" ];then
    echo "No job"
    exit 0
  fi
  local job_list=$(cat "$__job_list")
  if [ -z "$job_list" ];then
    echo "No job"
    exit 0
  fi

  local job jobs
  if [ -z "${__positional[0]}" ];then
    _select "$(cat "$__job_list")"
    jobs=$(_tac "$__selected")
  else
    for pid in "${__positional[@]}";do
      job=$(echo "$job_list"|grep "^$pid ")
      if [ -z "$job" ];then
        echo "No job for PID: $pid"
        continue
      fi
      if [ -n "$jobs" ];then
        jobs="$jobs"$'\n'"$job"
      else
        jobs="$job"
      fi
    done
  fi
  local pid date time script instance_id instance_ip status
  while read -r pid date time script instance_id instance_ip status; do
    echo "Deleting job: $pid $date $time $script $instance_id $instance_ip $status"
    _sedi "s/$pid $date ${time}.*$/${pid} ${date} ${time} ${script} ${instance_id} ${instance_ip} deleting/" "$__job_list"
    kill -kill "$pid"
    if [ "$instance_id" != "-" ];then
      __ids[__enum_instance]="$instance_id"
      __exit_at_fail=0 terminate
    fi
    _sedi "/$pid /d" "$__job_list"
  done < <(echo "$jobs")
}

images () {
  # List images.
  _get_image_list
  local header="Name ImageId SnapshotId"
  local contents=""
  while read -r line || [ -n "${line}" ];do
    name=$(echo "$line"|awk '{print $1}')
    id=$(echo "$line"|awk '{print $2}')
    snapshot=$(echo "$line"|awk '{print $3}')
    contents=${contents}"$name $id $snapshot"$'\n'
  done < <(echo "${__list[__enum_image]}")
  _print_list "$header" "$contents"
}

new_image () {
  # Create a new image from an instance.
  _get_ids $__enum_instance 1
  if [ -z "$__image_name" ];then
    _get_instance_list
    __image_name="$(echo "${__list[__enum_instance]}"|tr '\t' ' '|grep "${__ids[__enum_instance]}"|awk '{print $1}')"
  fi
  if [ -z "$__image_name" ];then
    echo "Set image_name by: ec2 -I <image_name> new_images"
    exit 1
  fi

  _get_image_list
  local image_names="$(echo "${__list[__enum_image]}"|awk '{print $1}')"

  __image_name=$(_get_name_number "$__image_name" "$image_names")

  if [ "$__setup_after_ami" = 1 ] && [ "$__dry_run" != 1 ];then
    [ -n "$__ami_family" ] || {
      echo 'new_image --setup requires --ami-family (for example --ami-family CPU).' >&2
      exit 1
    }
    [ "$__new_image_wait" = 1 ] || {
      echo 'new_image --setup requires --wait so setup sees an available AMI.' >&2
      exit 1
    }
  fi

  local no_reboot=""
  [ "$__new_image_no_reboot" = 1 ] && no_reboot="--no-reboot"
  _execute_ec2 "${__dry_run_mode} create-image --instance-id ${__ids[__enum_instance]} --name $__image_name $no_reboot --query ImageId --output text"
  local created_image_id="${__execute_result%%$'\n'*}"
  if [ "$__new_image_wait" = 1 ] && [ "$__dry_run" != 1 ];then
    [[ "$created_image_id" =~ ^ami-[[:alnum:]]+$ ]] || {
      echo "Could not determine the new AMI ID: $created_image_id" >&2
      exit 1
    }
    _execute_ec2 "wait image-available --image-ids $created_image_id"
  fi
  echo "${__dry_run_mode:+Dry run: }Created a new AMI $__image_name${created_image_id:+ ($created_image_id)} from ${__ids[__enum_instance]}"
  if [ "$__setup_after_ami" = 1 ] && [ "$__dry_run" != 1 ];then
    local saved_ami_id="$__ami_id"
    __ami_id="$created_image_id"
    setup
    __ami_id="$saved_ami_id"
  fi
}

rm_image () {
  # Delete images.
  _get_ids $__enum_image 1
  local snapshot=$(echo "${__list[__enum_image]}"|awk '{print $3}')
  _execute_ec2 "deregister-image ${__dry_run_mode} --image-id ${__ids[__enum_image]}"
  _execute_ec2 "delete-snapshot ${__dry_run_mode} --snapshot-id $snapshot"
  _get_id_name_list $__enum_image
  echo "${__dry_run_mode:+Dry run: }Deleted: AMI=$__id_name_list, Snapshot=$snapshot"
}

templates () {
  # List templates.
  _get_template_list
  local header="Name Id"
  local contents=""
  local line
  while read -r line || [ -n "${line}" ];do
    # shellcheck disable=SC2206
    line=($line)
    name=${line[0]}
    id=${line[1]}
    contents=${contents}"$name $id"$'\n'
  done < <(echo "${__list[__enum_template]}")
  _print_list "$header" "$contents"
}

new_template () {
  # Create a new template from an image.
  _get_ids $__enum_template 1
  _execute_ec2 "describe-launch-templates --launch-template-id ${__ids[__enum_template]} --query 'LaunchTemplates[*].DefaultVersionNumber' --output text"
  local default_version="$__execute_result"
  _select_objs $__enum_image 1
  local ami=$(echo "${__list[__enum_image]}"|awk '{print $2}')
  local snapshot=$(echo "${__list[__enum_image]}"|awk '{print $3}')
  _execute_ec2 "create-launch-template-version ${__dry_run_mode} --launch-template-id ${__ids[__enum_template]} --source-version $default_version --launch-template-data '{\"ImageId\":\"${ami}\"}' --query 'LaunchTemplateVersion.VersionNumber' --output text"
  local new_version=XXX
  if [ "${__dry_run}" != "1" ];then
    new_version="${__execute_result}"
    _execute_ec2 "modify-launch-template --launch-template-id ${__ids[__enum_template]} --default-version $new_version"
  fi
  _get_id_name_list $__enum_template
  echo "${__dry_run_mode:+Dry run: }Created a new template version $new_version for $__id_name_list"
}

types () {
  # List instance types.
  _get_type_list
  local header="Type vCPU Core Thread Mem(GiB) Arch GPU"
  local contents=""
  local line
  while read -r line || [ -n "${line}" ];do
    # shellcheck disable=SC2206
    line=($line)
    ty=${line[0]}
    vcpu=${line[1]}
    core=${line[2]}
    thread=${line[3]}
    mem=$((line[4] / 1024))
    arch=${line[5]}
    gpu=$(echo "${line[*]}"|cut -d' ' -f 7-|tr ' ' _)
    contents=${contents}"$ty $vcpu $core $thread $mem $arch $gpu"$'\n'
  done < <(echo "${__list[__enum_type]}")
  _print_list "$header" "$contents" "s d d d d s s"
}

update_types () {
  # Force update instance type list cache
  if [ -f "$__type_list_file" ]; then
     command rm -f "$__type_list_file"
  fi
  _get_type_list
  echo "Instance type list cache has been updated"
}

pricing () {
  # Show pricing of instance types.
  if [ "$__instance_type" == "select" ] || [ -z "$__instance_type" ];then
    _select_objs $__enum_type 0
    __instance_type=$(echo "${__list[__enum_type]}"|awk '{print $1}')
  fi
  # shellcheck disable=SC2206
  local types=(${__instance_type//,/ })
  _execute_aws configure get region
  local region="${__execute_result}"
  echo "Type USD"
  local t
  for t in "${types[@]}";do
    _execute_aws pricing get-products \
      --region us-east-1 \
      --service-code AmazonEC2 \
      --filters \
                'Type=TERM_MATCH,Field=instanceType,Value='"${t}" \
                'Type=TERM_MATCH,Field=regionCode,Value='"${region}" \
                'Type=TERM_MATCH,Field=preInstalledSw,Value=NA' \
                'Type=TERM_MATCH,Field=operatingSystem,Value=Linux' \
                'Type=TERM_MATCH,Field=tenancy,Value=Shared' \
                'Type=TERM_MATCH,Field=capacitystatus,Value=UnusedCapacityReservation' \
      --output text \
      --query 'PriceList[0]'
    local usd=$(echo "${__execute_result#*USD\":\"}"|cut -d'"' -f 1)
    echo "${t} ${usd}"
  done
}

price () {
  # Alias for pricing.
  pricing
}

commands () {
  # List commands.
  echo "$__subcommands"
}

help () {
  # Show help.
  _print_help
}

version () {
  # Show version.
  echo "ec2 $__version $__date"
}

_read_config () {
  local line
  __cli_input_json_groups=()
  if [ -f "$__config" ];then
    while read -r line || [ -n "${line}" ];do
      line="$(echo "$line"|cut -d '#' -f1)"
      line="${line#"${line%%[![:space:]]*}"}"
      line="${line%"${line##*[![:space:]]}"}"
      if [ -z "$line" ];then
        continue
      fi
      local opt="${line%%=*}"
      local val="${line#*=}"
      local config_name="${opt//-/_}"
      if [ "$config_name" = "ssh_option" ] || [ "$config_name" = "et_option" ] ||
         [ "$config_name" = "scp_option" ] || [ "$config_name" = "rsync_option" ];then
        local array_name="__$config_name"
        if [[ "$val" == \(*\) ]];then
          eval "$array_name=$val"
        else
          local option_value
          eval "option_value=$val"
          read -r -a "${array_name?}" <<< "$option_value"
        fi
      else
        eval "__$config_name=${val}"
      fi
      if [[ "${opt//-/_}" =~ ^cli_input_json_group_.*$ ]];then
        __cli_input_json_groups=("${__cli_input_json_groups[@]}" "${opt//cli_input_json_group_/}")
      fi
    done < "$__config"
  fi
}

_require_config () {
  [ -f "$__config" ] && return 0

  echo "EC2 configuration file not found: $__config" >&2
  if [ "$__config" != "$__default_config" ];then
    echo "Create that file or select an existing one with --config." >&2
    return 1
  fi
  cat >&2 << EOF
Create $__config manually with contents such as:
  name_filter=my-instances
  image_name_filter=my-images
  ssh_user=ec2-user

Or generate it from an environment configuration:
  ec2 init_environment
  ${EDITOR:-vi} $__environment_config
  ec2 setup
EOF
  return 1
}

_read_config_path () {
  while [[ $# -gt 0 ]]; do
    if [ "$1" = "--" ];then
      break
    fi
    if [ "$1" = "--config" ];then
      if [ $# -lt 2 ];then
        echo "Option --config requires an argument" 1>&2
        exit 1
      fi
      __config="$2"
      shift 2
    else
      shift
    fi
  done
}

_print_explain () {
  local value="$1"
  local spaces="$2"
  local name_length="$3"
  local comments="$4"

  local prefix=$(printf "%${spaces}s%-${name_length}s%s\n" "" "$value ")
  while IFS= read -r line; do
    printf "%s%s\n" "$prefix" "$line"
    prefix="${prefix//?/ }"
  done <<< "$comments"
}

_generate_read_args() {
  cat << EOF
_read_args() {
  __positional=()
  while [[ \$# -gt 0 ]]; do
    if [ \$1 = "--" ]; then
      shift
      __positional+=("\$@")
      break
    fi
    local opt="\${1//_/-}"
    case \$opt in
      --setup)
        __setup_after_ami=1
        shift
        ;;
      --wait)
        __new_image_wait=1
        shift
        ;;
      --no-reboot)
        __new_image_no_reboot=1
        shift
        ;;
EOF

  echo "$__options" | while read -r line; do
    if [ -z "$line" ];then
      continue
    fi
    local opt=$(echo "$line" | awk '{print $1}')
    local val_name=$(echo "${opt//-/_}" | cut -d '|' -f 1)
    if [ "$val_name" = "__ssh_option" ] || [ "$val_name" = "__et_option" ] ||
       [ "$val_name" = "__scp_option" ] || [ "$val_name" = "__rsync_option" ];then
      echo "      $opt) ${val_name}+=(\"\$2\"); shift; shift;;"
    else
      echo "      $opt) ${val_name}=\"\$2\"; shift; shift;;"
    fi
  done

cat << EOF
      --help|-h) _print_help; exit;;
      -*)
        echo "Unknown option: \$1" 1>&2
        exit 1
        ;;
      *)
        if [ "\$1" = "help" ]; then
          _print_help
          exit
        fi
        __positional+=("\$1")
        shift
        ;;
    esac
  done
}
EOF
}

_print_args_help() {
  echo "Options:"
  local line
  echo "$__options" | while read -r line; do
    if [ -z "$line" ];then
      continue
    fi
    # shellcheck disable=SC2001
    local opt="$(echo "${line%% *}" | sed 's/|/, /g')"
    local comment="$(echo -e "${line#* }")"
    _print_explain "$opt" 2 35 "$comment"
  done
  _print_explain "--help, -h" 2 35 "Show help."
}

_extract_comments () {
  awk "/^${1} *\(\) *{/{flag=1;next}/^}/{flag=0}flag" "$0" | awk '/^ *#/{sub(/^ *# ?/, ""); print; next} {exit}'
}

_print_subcommands () {
  echo "Subcommands:"
  for func in $__subcommands;do
    local comments=$(_extract_comments "$func")
    _print_explain "$func" 2 35 "$comments"
  done
}

_print_help () {
  printf "Usage: %s <subcommand> [options]\n\n" "$__cmd"
  _print_subcommands
  echo
  _print_args_help
}

# BEGIN GENERATED ENVIRONMENT COMMANDS
_environment_extract() {
  local root=$1
  mkdir -p "$root"
  mkdir -p "$(dirname "$root/environment.example")"
  cat >"$root/environment.example" <<'__EC2_ASSET_environment_example__'
# =============================================================================
#  ec2-environment configuration
# =============================================================================
#
#      ec2 init_environment
#      $EDITOR ~/.config/ec2/environment
#
#  -- How to read this file ----------------------------------------------------
#
#  Almost every setting is commented out and shows the value the scripts fall
#  back to, so an untouched copy already behaves sensibly. Uncomment a line only
#  to change it; deleting a line is the same as leaving it commented.
#
#  The uncommented lines are the ones you have to look at:
#
#    * marked "# REQUIRED" and shipped empty - the scripts have no default and
#      scripts/variables.sh refuses to run until every one of them is set. It lists
#      all the missing ones at once, so you do not have to find them one by one.
#    * the naming helpers and the AMI/filter names built from them - they work
#      as shipped, but every AMI and `ec2` lookup is named after them, so set
#      RESOURCE_NAME_PREFIX to something unique to you before the first build.
#
#  -- Who reads this file ------------------------------------------------------
#
#  ec2 environment commands source this file, apply their defaults and helpers,
#                       and finally verify that
#                       `aws sts get-caller-identity` works. If the credential
#                       provider needs an explicit refresh, AWS_AUTH_COMMAND is
#                       run; otherwise no provider-specific login is attempted.
#  ec2 make_ami         Writes $WORKDIR/packer/main.json and
#                       $WORKDIR/packer/variables_<family>.json, then runs
#                       `packer validate` and `packer build` for every enabled
#                       AMI family.
#  ec2 setup            Resolves (or creates) the shared file systems, writes
#                       one launch JSON per subnet and family under
#                       $WORKDIR/ec2/cli_input_json/, writes the `ec2` command
#                       configuration to $WORKDIR/ec2/config, and generates the
#                       cloud-init user-data at $WORKDIR/ec2/user_data.sh[.gz].
#
#      ec2 make_ami
#      ec2 setup
#
#  Both default to work-directory=~/.config/ec2/work and
#  environment-config=~/.config/ec2/environment. Override them with --workdir
#  and --environment-config when needed.
#
#  -- Syntax rules -------------------------------------------------------------
#
#  * This file is sourced by bash, so shell expansion works. $HOME, $PWD,
#    $WORKDIR and $CONFIG are already exported when it is sourced, and any
#    variable defined earlier in this file can be reused later on.
#  * Comma-separated lists ("a,b,c") must not contain spaces.
#  * Package lists are space separated, because they are handed to dnf/yum.
#  * Boolean values are not uniform: each one is forwarded verbatim to a
#    different consumer (Packer, run-instances JSON, the `ec2` command, shell
#    tests), so the accepted values are stated per entry. Do not guess.
#  * Anything named *_IDS can be given as *_NAMES instead, and bootstrap.sh looks
#    the IDs up for you. *_IDS wins when both are set. A name that matches
#    nothing, or more than one resource, is an error rather than a guess.
#  * Every *_IDS list must have as many entries as its *_MOUNT_POINTS list
#    (scripts/common.sh: compare_length).
#  * For the remaining per-file-system option lists, a single value is broadcast
#    to all entries; otherwise the length must match the number of names
#    (scripts/common.sh: make_array).
#
#  -- Per-AMI-family overrides -------------------------------------------------
#
#  Every variable consumed by the Packer template can be overridden for a single
#  AMI family by prefixing it with CPU_ or GPU_
#  (scripts/make_ami.sh: make_vars / family_value). For example:
#
#      AMI_ROOT_VOLUME_SIZE_GIB="60"        # applies to both families
#      GPU_AMI_ROOT_VOLUME_SIZE_GIB="200"   # GPU family only
#
#  Supported bases: OUTPUT_AMI_NAME, SOURCE_AMI_NAME_FILTER, SOURCE_AMI_OWNER,
#  SOURCE_AMI_ID, BUILD_INSTANCE_TYPE, AMI_BUILD_PROFILE, AMI_BUILD_REGION,
#  AMI_BUILD_SSH_INTERFACE, AMI_BUILD_SSH_USERNAME, AMI_BUILD_SECURITY_GROUP_IDS,
#  AMI_BUILD_SUBNET_ID, AMI_BUILD_VPC_ID, AMI_BUILD_IAM_INSTANCE_PROFILE,
#  AMI_ROOT_DEVICE_NAME, AMI_ROOT_VOLUME_DELETE_ON_TERMINATION, AMI_ROOT_VOLUME_SIZE_GIB,
#  AMI_ROOT_VOLUME_TYPE, AMI_ROOT_VOLUME_ENCRYPTED, AMI_ENABLE_SWAP, AMI_SWAP_BLOCK_SIZE, AMI_SWAP_BLOCK_COUNT, AMI_PACKAGES,
#  AMI_FLATPAK_PACKAGES, AMI_EXTRA_PACKAGES, AMI_TIMEZONE, AMI_IDLE_SHUTDOWN_BACKEND,
#  AMI_IDLE_SHUTDOWN_SCHEDULE, AMI_IDLE_SHUTDOWN_KEEPALIVE_PROCESSES, AMI_ENABLE_SHARED_MEMORY,
#  AMI_UPDATE_PACKAGES.
#
#  -- Required settings --------------------------------------------------------
#
#  Needed by every command:
#
#      AWS_REGION              AWS region                             (section 2)
#
#  Needed by ec2 setup only - it places instances and describes how you
#  reach them, which building an AMI does not:
#
#      AWS_SUBNET_IDS          subnet(s) to deploy into               (section 3)
#                          (or AWS_SUBNET_NAMES)
#      EC2_KEY_NAME            EC2 key pair name                      (section 3)
#
#  The file system scripts also need AWS_SUBNET_IDS, but only to create something.
#
#  <FAMILY>_AMI_NAME is required as well for every family whose
#  <FAMILY>_INSTANCE is 1 - CPU by default, GPU once you enable it.
#
# =============================================================================


# =============================================================================
#  1. Naming helpers
# =============================================================================
#  Not read by any script. They only exist so that the AMI names, file system
#  names and `ec2` filters below can be derived from one place, which is why
#  they and the names built from them are left active. Rename or drop them if
#  you prefer to spell every name out.

# Bump this whenever AMI_PACKAGES, AMI_PROVISION_SCRIPTS or the source AMI filter changes, so that
# a new AMI name - and therefore a new AMI - is produced instead of colliding
# with the existing one. Packer fails on a duplicate AMI name.
AMI_REVISION=1

# Prefix for AMI names, file system names and the `ec2` command filters. Keep it
# unique per person when several people share one AWS account.
RESOURCE_NAME_PREFIX="dev"


# =============================================================================
#  2. AWS account, region and API polling
# =============================================================================

# AWS CLI profile. Used for every aws call (--profile) and passed to Packer as
# `profile`.
# AWS CLI credentials are used locally and are not automatically written into
# user-data. Explicit settings such as INSTANCE_COPY_ENTRIES and
# INSTANCE_USER_DATA_EXTRA_SCRIPT can still embed sensitive contents; review
# the generated user-data before launching.
# Default: default
#AWS_PROFILE="default"

# Optional command used to refresh credentials after the AWS CLI credential
# provider chain reports an authentication failure. This is not limited to SSO:
# it can call `aws sso login`, aws-vault, a credential broker, or another local
# authentication helper. Use single quotes when the command refers to variables.
#AWS_AUTH_COMMAND='aws sso login --profile "$AWS_PROFILE"'

# AWS region. Required - scripts/variables.sh aborts when it is empty. Used for
# every aws call (--region), for Packer's `region`, and inside user-data to
# build the FSx NFS endpoint <fs-id>.fsx.<region>.amazonaws.com.
AWS_REGION=""   # REQUIRED

# Exported by scripts/make_ami.sh as AWS_POLL_DELAY_SECONDS / AWS_MAX_ATTEMPTS, and
# picked up by the AWS SDK that Packer uses. They bound how long Packer waits
# for AWS state changes such as "AMI available". The defaults allow roughly
# 10 s x 400 = 66 minutes, which is enough for a large image with many packages.
# Raise AWS_MAX_ATTEMPTS if a build times out while snapshotting.
#AWS_POLL_DELAY_SECONDS=10
#AWS_MAX_ATTEMPTS=400

# Packer action for resources it created when a build fails:
#   cleanup  Remove temporary build resources (recommended).
#   abort    Leave resources for manual inspection.
#   ask      Ask interactively (not suitable for unattended builds).
# Default: cleanup
#AMI_PACKER_ON_ERROR="cleanup"

# Optional external Packer JSON template. When set, this replaces the generated
# default template; it must use the variables written to variables_<family>.json.
#AMI_PACKER_TEMPLATE_FILE=""

# Behavior when an AMI with the configured output name already exists:
#   build   Start a new build (default, preserving existing behavior).
#   reuse   Skip Packer and use the newest self-owned AMI with that name.
#   fail    Abort before starting any AMI build.
# Default: build
#AMI_EXISTING_IMAGE_ACTION="build"

# Interval in seconds for the progress display while Packer is running.
# This controls only status polling and does not change Packer's AWS SDK polling.
# Default: 15
#AMI_PROGRESS_POLL_DELAY_SECONDS=15
#AMI_PROGRESS_MAX_ATTEMPTS=400

# Number of attempts and delay (seconds) used by instance user-data while
# waiting for requested mounts and attached block devices. Provisioning fails
# without creating ~/ready when a required mount never becomes usable.
#MOUNT_READY_MAX_ATTEMPTS=60
#MOUNT_READY_RETRY_INTERVAL_SECONDS=2


# =============================================================================
#  3. Network and IAM
# =============================================================================

# VPC used by the Packer build instance (Packer `vpc_id`). Optional: Packer
# resolves it from the subnet when it is empty, and the only thing it needs the
# VPC for is creating a temporary security group, which it never does here
# because AWS_SECURITY_GROUP_IDS is always passed.
#
# Set it to have Packer fail early on a mismatch: it must be the VPC that owns
# AWS_SUBNET_IDS and AWS_SECURITY_GROUP_IDS.
# Default: empty, resolved from AMI_BUILD_SUBNET_ID
#AWS_VPC_ID=""

# Name tag of the VPC, looked up when AWS_VPC_ID is empty.
#AWS_VPC_NAME=""

# Subnets to deploy into, comma separated. Required by scripts/setup_ec2.sh, and by
# the file system scripts when they create something. make_ami works without it:
# Packer then picks a subnet in the default VPC. More than one may be
# listed: scripts/setup_ec2.sh then writes one launch JSON per subnet per enabled
# AMI family, so an instance can be started in whichever availability zone has
# capacity, and scripts/setup_efs.sh adds a mount target in every subnet listed
# here.
#
# Two of the file system kinds restrict how many entries are allowed, and both
# checks run even when that kind is unused, because scripts/setup_ec2.sh invokes
# every setup script unconditionally:
#   * scripts/setup_io2.sh aborts on more than one subnet - an io2 volume has to be
#     created in the availability zone the instance runs in.
#   * scripts/setup_fsx.sh aborts when FSX_DEPLOYMENT_TYPE is SINGLE_AZ_* and more
#     than one subnet is given, and when it is MULTI_AZ_* and only one is.
AWS_SUBNET_IDS=""   # REQUIRED by setup_ec2

# Name tags of the subnets, comma separated, looked up when AWS_SUBNET_IDS is empty.
# The resolved order follows the order written here, so EC2_SUBNET_LABELS still
# lines up.
#AWS_SUBNET_NAMES=""

# Short label per subnet, comma separated, in the same order as AWS_SUBNET_IDS.
# Only used to name the generated launch JSON files:
#     $WORKDIR/ec2/cli_input_json/<AMI_NAME>-<label>.json
# When a label is missing, scripts/setup_ec2.sh falls back to the subnet ID with
# the "subnet-" prefix stripped, which makes for long file names. Using the
# availability-zone letter ("a", "c", "d") keeps them readable.
# Default: empty, i.e. every file name carries the subnet ID.
#EC2_SUBNET_LABELS="a,d"

# Subnet used by the Packer build instance (Packer `subnet_id`).
# Leave this commented out to use the first entry of AWS_SUBNET_IDS, which is the
# normal case. Uncomment it only when the AMI must be built in a different
# subnet from the one the instances are launched in. An empty value is *not* the
# same as leaving it out: scripts/bootstrap.sh only fills in the default when the
# variable is undefined, so AMI_BUILD_SUBNET_ID="" means "let Packer choose a subnet".
#AMI_BUILD_SUBNET_ID=""

# Security groups, comma separated. Optional, but you almost certainly want to
# set it. They are applied to both
#   * the Packer build instance (Packer `security_group_ids`), and
#   * the network interface in the generated launch JSON ("Groups").
# They must therefore allow whatever AMI_BUILD_SSH_INTERFACE needs (inbound 22 from the
# host that runs Packer) plus the NFS/EFS/mosh traffic you expect at run time.
#
# Leaving it empty is a real downgrade, not just a default:
#   * Packer builds a throwaway security group for the build instance and
#     authorises it from `temporary_security_group_source_cidrs`, which defaults
#     to 0.0.0.0/0. Inbound SSH is open to the internet for the whole build.
#   * The launch JSON leaves "Groups" out, so instances get the VPC default
#     security group - whatever that happens to allow.
# Default: empty
#AWS_SECURITY_GROUP_IDS=""

# Security group names, comma separated, looked up when AWS_SECURITY_GROUP_IDS is
# empty. These are real group names (the EC2 GroupName attribute), not Name
# tags. Group names are unique within a VPC, so set AWS_VPC_ID as well when the same
# name exists in more than one VPC.
#AWS_SECURITY_GROUP_NAMES=""

# Name of the IAM instance profile, used both for the launched instances
# ("IamInstanceProfile" in the generated launch JSON) and for the Packer build
# instance (Packer `iam_instance_profile`). An ARN is not accepted here.
#
# Leave it empty to run without an instance profile - but the instance then
# cannot use the AWS credential chain, cannot attach io2 volumes from user-data,
# and cannot reach S3/EFS/FSx with IAM authentication.
#
# The role needs at least: ec2:DescribeInstances, ec2:AttachVolume (io2),
# elasticfilesystem client mount permissions (EFS), and whatever your own
# INSTANCE_USER_DATA_EXTRA_SCRIPT hook does.
#AWS_IAM_INSTANCE_PROFILE=""

# EC2 key pair name written to "KeyName" in the generated launch JSON. Required
# for SSH access to the launched instances. Packer does not use it: it creates
# and discards a temporary key pair of its own for the build.
EC2_KEY_NAME=""   # REQUIRED by setup_ec2


# =============================================================================
#  4. AMI build - build instance access
# =============================================================================

# Default login user of the source AMI. Not used directly; it seeds the
# defaults of SSH_USERNAME and EC2_SSH_USERNAME. "ec2-user" for Amazon Linux and the
# Deep Learning AMIs, "ubuntu" for Ubuntu images.
# Default: ec2-user
#EC2_USER="ec2-user"

# How Packer connects to the build instance (Packer `ssh_interface`):
#   private_ip       Connect to the private IP. Requires that the host running
#                    Packer can reach the VPC (VPN, Direct Connect, same VPC).
#   public_ip        Connect to the public IP. Needs a public subnet and
#                    auto-assigned public IP.
#   private_dns / public_dns
#   session_manager  Connect through SSM, no inbound rule needed. Requires an
#                    SSM-capable AWS_IAM_INSTANCE_PROFILE on the build instance.
# Default: private_ip
#AMI_BUILD_SSH_INTERFACE="private_ip"

# SSH user Packer logs in as (Packer `ssh_username`), also exported to the
# provisioning scripts as $SSH_USERNAME.
# Default: value of EC2_USER
#AMI_BUILD_SSH_USERNAME="${EC2_USER}"


# =============================================================================
#  5. AMI build - root volume
# =============================================================================
#  These become Packer's launch_block_device_mappings, i.e. the root volume of
#  the build instance and therefore of the resulting AMI. The generated launch
#  JSON does not override block devices, so every instance started from the AMI
#  inherits exactly this root volume.

# Root device name of the source AMI. /dev/xvda for Amazon Linux 2023,
# /dev/sda1 for most Ubuntu images. A wrong value creates a second, unused
# volume instead of resizing the root one.
# Default: /dev/xvda
#AMI_ROOT_DEVICE_NAME="/dev/xvda"

# Root volume size in GiB. Must be at least the size of the source AMI's
# snapshot. The Deep Learning AMIs need considerably more than Amazon Linux, so
# GPU_VOLUME_SIZE is a common override.
# Default: 60
#AMI_ROOT_VOLUME_SIZE_GIB="60"

# Root volume type: gp3, gp2, io1, io2, standard.
# Default: gp3
#AMI_ROOT_VOLUME_TYPE="gp3"

# Encrypt the root volume with the account's default EBS key. "true" or "false".
# Default: true
#AMI_ROOT_VOLUME_ENCRYPTED="true"

# Delete the root volume when the instance terminates. "true" or "false".
# Set true only for disposable instances. When false, the root volume remains
# after termination and must be deleted separately if it is no longer needed.
# Default: false
#AMI_ROOT_VOLUME_DELETE_ON_TERMINATION="false"


# =============================================================================
#  6. AMI build - provisioning
# =============================================================================
#  ec2 make_ami extracts its built-in Packer assets to $WORKDIR/packer/ and runs
#  Packer from there. Use absolute paths for additional AMI_PROVISION_SCRIPTS
#  so they do not depend on that temporary directory. Every
#  script runs as root ("sudo -S -E sh -eux") and receives the settings below as
#  environment variables.

# Optional comma-separated user scripts appended after enabled built-in features.
# Scripts run as root. This repository includes
# examples/ami-provision/configure_example_environment.sh.
# Example:
#   AMI_PROVISION_SCRIPTS="/path/to/ec2/examples/ami-provision/configure_example_environment.sh"
#AMI_PROVISION_SCRIPTS=""

# Swap file at /swapfile, created with `dd bs=$AMI_SWAP_BLOCK_SIZE count=$AMI_SWAP_BLOCK_COUNT`,
# activated and appended to /etc/fstab. 128M x 64 = 8 GiB. Set either one to an
# empty string to skip swap entirely. Skipped when /swapfile already exists.
# Set AMI_ENABLE_SWAP=1 to enable this feature; it defaults to 0.
# Remember that the swap file consumes AMI_ROOT_VOLUME_SIZE_GIB.
# Defaults: 128M, 64
#AMI_ENABLE_SWAP=0
#AMI_SWAP_BLOCK_SIZE="128M"
#AMI_SWAP_BLOCK_COUNT="64"

# 1 ensures `/dev/shm` has mode 1777, so that unprivileged multi-process
# workloads (PyTorch DataLoader workers, joblib, multiprocessing) can use it.
# Any other value skips it.
#AMI_ENABLE_SHARED_MEMORY=0

# System time zone, applied with `timedatectl set-timezone`. Any tz database
# name, e.g. UTC, Asia/Tokyo, America/Los_Angeles. A non-empty value
# automatically enables the step; empty (the default) skips it.
#AMI_TIMEZONE=""

# Space-separated packages installed with the selected package manager. Applies to
# both AMI families; use CPU_AMI_EXTRA_PACKAGES / GPU_AMI_EXTRA_PACKAGES for
# family-specific extras.
#
# packer/scripts/install_packages.sh special-cases a few names:
#   gh                            Adds the cli.github.com yum repository first.
#   terraform                     Adds the HashiCorp repository first.
#   lazygit                       Enables copr dejan/lazygit
#                                 (amazonlinux-2023-x86_64 only).
#   google-chrome                 Downloaded and installed from the direct rpm.
#   spal, spal-release            Installs the spal-release repository package.
#
# Add "amazon-efs-utils" when you mount EFS, and "docker" when using Docker.
# dnf/yum support the repository-backed special packages above; apt supports
# ordinary packages and Flatpak. The script exits for unsupported special names.
#AMI_PACKAGES=""

# Package manager backend. `auto` detects dnf, yum, or apt-get in that order.
# Set this explicitly when an image provides more than one backend.
# Default: auto
#AMI_PACKAGE_MANAGER="auto"

# 1 applies the package manager's update before package installation; 0 installs against the
# package versions exposed by the selected source AMI and its configured repos.
# The final NEVRA list is always recorded in
# /var/log/ec2-environment-packages.tsv inside the built AMI.
# The package setup runs automatically when AMI_PACKAGES or
# AMI_FLATPAK_PACKAGES is non-empty, or when AMI_UPDATE_PACKAGES=1.
# Default: 0. Set to 1 to update packages even when no package is installed.
#AMI_UPDATE_PACKAGES=0

# Space-separated Flatpak application IDs. When non-empty, flatpak is installed,
# the flathub remote is added, and these are installed from it. Leave empty to
# skip Flatpak completely.
#AMI_FLATPAK_PACKAGES=""

# Idle auto-shutdown, installed as /usr/local/sbin/shutdown_if_idle.
# Set AMI_ENABLE_IDLE_SHUTDOWN=1 to enable this feature; it defaults to 0.
#   systemd   Install shutdown.service plus shutdown.timer and enable them.
#   cron      Drop a script into /etc/cron.<AMI_IDLE_SHUTDOWN_SCHEDULE>/shutdown.
#   ""        Skip the whole step; the instance never powers itself off.
# Any other value writes the helper script but schedules nothing, which is the
# same as "" in practice.
# Default backend: systemd
#AMI_ENABLE_IDLE_SHUTDOWN=0
#AMI_IDLE_SHUTDOWN_BACKEND="systemd"

# How often idleness is checked. The accepted values depend on AMI_IDLE_SHUTDOWN_BACKEND:
#   systemd   A systemd OnCalendar= expression - hourly, daily,
#             "*:0/30" (every 30 minutes), and so on.
#   cron      A cron directory suffix - hourly, daily, weekly or monthly.
#             /etc/cron.<value>/ has to exist on the image.
# The check powers off only if the instance still looks idle after a further
# 60 s, so the worst case wasted is one interval.
# Default: hourly
#AMI_IDLE_SHUTDOWN_SCHEDULE="hourly"

# Extended-regular-expression alternation of process names that keep the
# instance alive, so that a detached session is not powered off. Matched against
# `ps -eo comm=` for processes owned by a non-root user, anchored at both ends,
# and baked into shutdown_if_idle when the AMI is built.
#
# This matters because `who` does not list detached screen/tmux sessions, mosh
# sessions, or `ssh host command` without a tty. Leave it empty to power off
# purely on `who`. Note that Linux truncates `comm` to 15 characters, so match
# on the short process name.
#AMI_IDLE_SHUTDOWN_KEEPALIVE_PROCESSES="sshd|screen|tmux|mosh-server"


# =============================================================================
